{
  "name": "sumalab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "article:from-sumahon": "node scripts/run/create-from-sumahon.mjs",
    "article:prepare-from-sumahon": "node scripts/run/prepare-from-sumahon.mjs",
    "article:import-generated": "node scripts/run/import-generated.mjs",
    "sumalabo:from-url": "node scripts/run/create-from-sumahon.mjs --url",
    "sumalabo:from-folder": "node scripts/run/from-folder-guide.mjs",
    "sumalabo:process": "node scripts/run/regenerate-from-queue.mjs",
    "sumalabo:finalize": "node scripts/run/phase-a-finalize.mjs",
    "sumalabo:gate": "node scripts/sumalabo-gate.mjs",
    "sumahon:watch": "node scripts/run/sumahon-watch.mjs",
    "sumahon:regenerate-next": "node scripts/run/regenerate-from-queue.mjs",
    "sumahon:notify-review-ready": "node scripts/run/notify-review-ready.mjs",
    "social:generate-x-post": "node scripts/run/generate-x-post.mjs",
    "social:post-to-x": "node scripts/run/post-to-x.mjs",
    "automation:run-queue": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/automation/run-sumahon-queue.ps1",
    "automation:register-tasks": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/automation/register-sumahon-tasks.ps1",
    "automation:disable-tasks": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/automation/disable-sumahon-tasks.ps1",
    "deploy:production": "node scripts/automation/deploy-production-from-main.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "latest",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "latest"
  },
  "devDependencies": {
    "typescript": "latest"
  }
}
