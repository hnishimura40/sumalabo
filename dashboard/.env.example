# dashboard/.env.example
# 実データ連携フェーズで使う環境変数のテンプレート。
# 実値は dashboard/.env (gitignore済) に書き、リポジトリにはコミットしない。
# ブラウザ側に必要な値だけ VITE_ プレフィックスで公開する。
# 認証情報 (サービスアカウントJSON, OAuth refresh token) は必ずサーバー側
# (Cloudflare Pages Functions / Workers) で扱うこと。

# ----- GA4 Data API -----
# 各プロパティID (数値)
GA4_PROPERTY_ID_AINITORYU=
GA4_PROPERTY_ID_SUMALAB=
GA4_PROPERTY_ID_MIRADIA=

# サービスアカウントJSONの中身をそのまま入れる (改行はエスケープ)。
# Cloudflare Pages の場合は Pages > Settings > Environment variables に登録。
GA4_SERVICE_ACCOUNT_JSON=

# ----- Search Console API -----
# 認証はサービスアカウント or OAuth refresh token のどちらか
SEARCH_CONSOLE_SERVICE_ACCOUNT_JSON=
SEARCH_CONSOLE_OAUTH_REFRESH_TOKEN=

# 各サイトの Search Console プロパティURL (sc-domain: または https://)
SEARCH_CONSOLE_SITE_AINITORYU=https://www.ainitoryu.com/
SEARCH_CONSOLE_SITE_SUMALAB=
SEARCH_CONSOLE_SITE_MIRADIA=

# ----- 簡易アクセス制御 (Cloudflare Access を使わない場合のフォールバック) -----
# Functions側で Bearer トークン照合に使う。クライアントには出さない。
DASHBOARD_API_TOKEN=

# ----- 表示用 (ブラウザに出てよい設定のみ VITE_) -----
VITE_DASHBOARD_TITLE=メディア司令室
