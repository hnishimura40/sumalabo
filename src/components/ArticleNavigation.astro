---
type ArticleLink = {
  title: string;
  slug: string;
  category: string;
  updated: string;
};

interface Props {
  previousArticle?: ArticleLink;
  nextArticle?: ArticleLink;
}

const { previousArticle, nextArticle } = Astro.props;
const hasNavigation = previousArticle || nextArticle;
---

{
  hasNavigation && (
    <nav class="article-navigation" aria-label="前後の記事">
      {previousArticle ? (
        <a class="article-navigation-card article-navigation-card--previous" href={`/articles/${previousArticle.slug}/`}>
          <span>前の記事</span>
          <strong>{previousArticle.title}</strong>
          <small>{previousArticle.category} / {previousArticle.updated}</small>
        </a>
      ) : (
        <div aria-hidden="true" />
      )}
      {nextArticle ? (
        <a class="article-navigation-card article-navigation-card--next" href={`/articles/${nextArticle.slug}/`}>
          <span>次の記事</span>
          <strong>{nextArticle.title}</strong>
          <small>{nextArticle.category} / {nextArticle.updated}</small>
        </a>
      ) : (
        <div aria-hidden="true" />
      )}
    </nav>
  )
}

<style>
  .article-navigation {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 22px;
  }

  .article-navigation-card {
    display: grid;
    gap: 7px;
    min-height: 118px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--teal-tint) 46%, transparent), transparent 66%),
      var(--bg-elev);
    box-shadow: var(--shadow-sm);
    color: var(--fg);
    padding: 18px;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .article-navigation-card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .article-navigation-card--next {
    text-align: right;
  }

  .article-navigation-card span {
    color: var(--teal-deep);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.3;
  }

  .article-navigation-card strong {
    color: var(--fg);
    font-size: 16px;
    line-height: 1.55;
  }

  .article-navigation-card small {
    color: var(--fg-soft);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.5;
  }

  @media (max-width: 720px) {
    .article-navigation {
      grid-template-columns: 1fr;
    }

    .article-navigation > div[aria-hidden="true"] {
      display: none;
    }

    .article-navigation-card--next {
      text-align: left;
    }
  }
</style>
