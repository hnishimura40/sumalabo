---
// Preview承認ボタン (v2 — 2026-05-13)
//
// 背景:
//   v1 は build時の CF_PAGES_BRANCH が "preview/" 始まりのときだけ <aside> を出していた。
//   - 問題1: CF Pages の GitHub Apps 連携を使っておらず、wrangler direct upload で
//     deploy しているため CF_PAGES_BRANCH が build時に空。
//   - 問題2: 実際の deploy branch は `auto/imported-…` / `auto/sumahon-…` で
//     `preview/` 始まりではない。
//   結果、PWA 通知から開いた Preview ページに承認ボタンが描画されなかった。
//
// v2 方針:
//   - <aside> は build時には常に hidden で emit (本番 main build を除く)
//   - runtime script で:
//       (a) ホストが本番 (sumalabo.com) なら何もしない
//       (b) build時の CF_PAGES_BRANCH があればそれを使う
//       (c) なければ slug から /api/review-items を引いて branch / prUrl を解決
//   - branch が許可 prefix のいずれかで始まれば <aside> を表示
//       (env APPROVE_ALLOWED_BRANCH_PREFIXES、CSV、default
//        "preview/,auto/imported-,auto/sumahon-")
//   - 解決できない / 許可 prefix でない場合は hidden のまま (オプションで理由表示)
//
// セキュリティ:
//   - API 側 (functions/api/approve-preview.ts) でも prefix list を再チェック
//   - GITHUB_TOKEN はサーバー専用、フロントに露出しない
//   - main 確定の本番 deploy では aside そのものを emit しない

type Props = { slug?: string };
const { slug } = Astro.props;

// 環境変数 (build時) — 後方互換で APPROVE_ALLOWED_BRANCH_PREFIX (単数) も受ける
const csvPrefixes = (
  import.meta.env.APPROVE_ALLOWED_BRANCH_PREFIXES ||
  import.meta.env.APPROVE_ALLOWED_BRANCH_PREFIX ||
  "preview/,auto/imported-,auto/sumahon-"
) + "";
const allowedPrefixes = csvPrefixes
  .split(",")
  .map((s) => s.trim())
  .filter(Boolean);

const cfBranch = (import.meta.env.CF_PAGES_BRANCH || "") + "";
const overrideBranch = (import.meta.env.PREVIEW_BRANCH_OVERRIDE || "") + "";
const buildtimeBranch = overrideBranch || cfBranch;

// 本番 main の deploy では描画しない (本番ドメインに承認ボタンを露出させない安全装置)
const isMainBuild = buildtimeBranch === "main" || buildtimeBranch === "master";

// production host (sumalabo.com) のフィルタは runtime 側でも再チェックする
---

{!isMainBuild && (
  <aside
    class="preview-approval"
    data-preview-approval
    data-slug={slug || ""}
    data-branch={buildtimeBranch}
    data-allowed-prefixes={allowedPrefixes.join(",")}
    aria-label="Preview承認"
    hidden
  >
    <p class="preview-approval__hint">確認後、このPreviewブランチを main へマージします</p>
    <button type="button" class="preview-approval__button" data-approval-button disabled>
      この記事を承認して公開
    </button>
    <p class="preview-approval__status" role="status" aria-live="polite" data-approval-status></p>
    <p class="preview-approval__meta" data-approval-meta></p>
  </aside>
)}

<script>
  // Preview承認ボタン runtime resolver
  // 本ファイルは Astro の `<script>` (ESM、bundle される) として実行される。
  //
  // 流れ:
  //   1. wrapper 要素を探す。なければ何もしない (本番 main build はそもそも emit されない)
  //   2. location.host が production (sumalabo.com) なら hidden のまま終了
  //   3. branch を解決
  //      a. data-branch (build時 CF_PAGES_BRANCH)
  //      b. なければ /api/review-items を fetch して slug 一致の entry から branch
  //      c. それも無ければ hidden のまま終了 (理由を data-approval-meta に書く)
  //   4. branch が許可 prefix のいずれかにマッチしないなら hidden + 理由表示
  //   5. マッチしたら wrapper を hidden 解除し、button を enable、PR URL があれば meta に表示

  const wrapper = document.querySelector<HTMLElement>("[data-preview-approval]");
  if (wrapper) {
    const button = wrapper.querySelector<HTMLButtonElement>("[data-approval-button]");
    const statusEl = wrapper.querySelector<HTMLParagraphElement>("[data-approval-status]");
    const metaEl = wrapper.querySelector<HTMLParagraphElement>("[data-approval-meta]");

    const PRODUCTION_HOSTS = new Set(["sumalabo.com", "www.sumalabo.com"]);
    const isProductionHost = PRODUCTION_HOSTS.has(location.host);

    const allowedPrefixes = (wrapper.dataset.allowedPrefixes || "")
      .split(",")
      .map((s) => s.trim())
      .filter(Boolean);

    const buildtimeBranch = (wrapper.dataset.branch || "").trim();
    const slugFromData = (wrapper.dataset.slug || "").trim();
    const slugFromUrl = (() => {
      // /articles/<slug>/  …  trailing slash 有無の両対応
      const m = location.pathname.match(/\/articles\/([^/]+)\/?$/);
      return m ? decodeURIComponent(m[1]) : "";
    })();
    const slug = slugFromData || slugFromUrl;

    const matchesAllowedPrefix = (branch: string): boolean =>
      allowedPrefixes.some((p) => p && branch.startsWith(p));

    const renderHidden = (reason: string) => {
      // 本番ホストでは reason を表示しない (露出抑制)
      wrapper.hidden = true;
      if (metaEl && !isProductionHost) {
        metaEl.textContent = reason;
      }
    };

    if (isProductionHost) {
      renderHidden("");
    } else {
      void (async () => {
        let branch = buildtimeBranch;
        let prUrl = "";
        if (!branch && slug) {
          try {
            const r = await fetch("/api/review-items", { method: "GET" });
            if (r.ok) {
              const body = (await r.json()) as { items?: Array<{ slug?: string; branch?: string; prUrl?: string }> };
              if (Array.isArray(body.items)) {
                const item = body.items.find((it) => it && it.slug === slug);
                if (item && typeof item.branch === "string" && item.branch) {
                  branch = item.branch;
                  if (typeof item.prUrl === "string") prUrl = item.prUrl;
                }
              }
            }
          } catch {
            /* fall through — branch will remain "" */
          }
        }

        if (!branch) {
          renderHidden("Preview branch を特定できませんでした（KV / CF_PAGES_BRANCH 共に解決不可）。");
          return;
        }
        if (!matchesAllowedPrefix(branch)) {
          renderHidden(`Preview承認は ${allowedPrefixes.join(" / ")} 始まりの branch だけが対象です。検出: ${branch}`);
          return;
        }

        // OK — wrapper を表示してボタンを使える状態にする
        wrapper.hidden = false;
        if (button) button.disabled = false;
        if (metaEl) {
          const prChip = prUrl ? ` / PR: ${prUrl}` : "";
          metaEl.innerHTML = `対象ブランチ: <code>${branch.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c] as string))}</code>${prChip}`;
        }

        if (button && statusEl) {
          let pending = false;

          // verify-publication を polling し、published / failed まで段階的に UI を更新する。
          // 公開完了前にボタンを「公開完了」にしない (実態と表示を一致させる)。
          const pollPublication = async (verifyEndpoint: string): Promise<void> => {
            const POLL_INTERVAL_MS = 10000; // 10 秒間隔
            const POLL_MAX_ATTEMPTS = 36;   // 10s × 36 = 6 分
            let attempt = 0;
            statusEl.textContent = "本番デプロイ中... (1/36)";
            return new Promise<void>((resolve) => {
              const tick = async () => {
                attempt++;
                let body: {
                  ok?: boolean;
                  status?: "published" | "deploying" | "failed";
                  failedChecks?: string[];
                  productionUrl?: string;
                } = {};
                try {
                  const r = await fetch(verifyEndpoint, { method: "GET", cache: "no-store" });
                  try {
                    body = await r.json();
                  } catch {
                    /* leave body empty */
                  }
                } catch {
                  /* network error — treat as deploying and retry */
                }

                if (body.status === "published") {
                  statusEl.textContent = `本番公開を確認しました。`;
                  const prodLink = body.productionUrl
                    ? ` <a href="${body.productionUrl}" target="_blank" rel="noopener">本番URLを開く</a>`
                    : "";
                  if (metaEl) {
                    metaEl.innerHTML = `<strong>公開完了</strong>${prodLink}`;
                  }
                  button.textContent = "公開完了";
                  resolve();
                  return;
                }

                if (body.status === "failed") {
                  const reason = (body.failedChecks || []).join(", ");
                  statusEl.textContent = `本番反映が確認できません。失敗 check: ${reason || "unknown"}。手動確認してください。`;
                  button.textContent = "公開失敗";
                  resolve();
                  return;
                }

                // status === "deploying" もしくは未取得 → 続行
                if (attempt < POLL_MAX_ATTEMPTS) {
                  statusEl.textContent = `本番反映を確認中... (${attempt}/${POLL_MAX_ATTEMPTS})`;
                  setTimeout(tick, POLL_INTERVAL_MS);
                } else {
                  statusEl.textContent =
                    "本番反映の確認がタイムアウトしました。少し待ってから本番URLを直接確認してください。";
                  button.textContent = "公開未確認";
                  resolve();
                }
              };
              tick();
            });
          };

          button.addEventListener("click", async () => {
            if (pending) return;
            pending = true;
            button.disabled = true;
            statusEl.textContent = "承認処理中...";

            try {
              const res = await fetch("/api/approve-preview", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ branch }),
              });

              let data: {
                ok?: boolean;
                message?: string;
                pullNumber?: number;
                merged?: boolean;
                slug?: string;
                deployTriggered?: boolean;
                deployTriggerReason?: string;
                verifyEndpoint?: string | null;
              } = {};
              try {
                data = await res.json();
              } catch {
                /* fallthrough */
              }

              if (res.ok && data.ok) {
                const prSuffix = data.pullNumber ? `（PR #${data.pullNumber}）` : "";
                if (data.deployTriggered === false) {
                  // PR merge は成功したが、deploy hook の発火に失敗。
                  // 手動 deploy が必要なことをはっきり表示する。
                  statusEl.textContent =
                    `mainへマージ完了${prSuffix}。ただし本番デプロイ起動に失敗 (${data.deployTriggerReason || "unknown"})。手動でデプロイしてください。`;
                  button.textContent = "デプロイ手動実行が必要";
                  return;
                }

                statusEl.textContent = `mainへマージ→本番デプロイ開始${prSuffix}。`;
                button.textContent = "公開確認中…";

                if (data.verifyEndpoint) {
                  await pollPublication(data.verifyEndpoint);
                } else {
                  // slug が解決できなかった場合のフォールバック
                  statusEl.textContent =
                    `デプロイは開始されましたが、verify endpoint が解決できませんでした。手動で本番URLを確認してください。`;
                  button.textContent = "公開未確認";
                }
              } else {
                const message = data.message || `承認に失敗しました（HTTP ${res.status}）`;
                statusEl.textContent = message;
                button.disabled = false;
                pending = false;
              }
            } catch (err) {
              statusEl.textContent = "通信エラーで承認できませんでした。再読み込みしてもう一度試してください。";
              button.disabled = false;
              pending = false;
            }
          });
        }
      })();
    }
  }
</script>

<style>
  /*
    配色は src/styles/global.css 由来のCSS変数（--teal / --teal-tint / --bg-elev / --line / --fg-mid）
    を使うため、ライトモード/ダークモード切り替えに自動追従する。
  */
  .preview-approval {
    margin: 28px 0 32px;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-left: 5px solid var(--teal);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, var(--teal-tint), transparent 70%),
      var(--bg-elev);
    box-shadow: var(--shadow-sm);
  }

  .preview-approval[hidden] {
    display: none;
  }

  .preview-approval__hint {
    margin: 0 0 14px;
    color: var(--fg-mid);
    font-size: 14px;
    line-height: 1.55;
  }

  .preview-approval__button {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border: 1px solid var(--teal);
    border-radius: var(--radius-md);
    background: var(--teal);
    color: var(--bg-elev);
    font-family: inherit;
    font-size: 15px;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: opacity 0.15s ease, transform 0.05s ease;
  }

  .preview-approval__button:hover:not(:disabled) {
    opacity: 0.92;
  }

  .preview-approval__button:active:not(:disabled) {
    transform: translateY(1px);
  }

  .preview-approval__button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .preview-approval__status {
    margin: 12px 0 0;
    color: var(--fg-soft);
    font-size: 14px;
    line-height: 1.55;
    min-height: 1.4em;
  }

  .preview-approval__status:not(:empty) {
    color: var(--fg-mid);
  }

  .preview-approval__meta {
    margin: 8px 0 0;
    color: var(--fg-soft);
    font-size: 12px;
  }

  .preview-approval__meta code {
    padding: 1px 6px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: color-mix(in srgb, var(--bg-elev) 92%, var(--teal-tint));
    color: var(--teal-deep);
    font-family: var(--font-mono);
    font-size: 11px;
  }
</style>
