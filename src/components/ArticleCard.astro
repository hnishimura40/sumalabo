---
import { articleTypeLabels } from "../lib/articles";
import { getCategoryByName } from "../lib/categories";

interface ArticleData {
  title: string;
  slug: string;
  type: keyof typeof articleTypeLabels;
  category: string;
  description: string;
  thumbnail?: string;
  thumbnailAlt?: string;
  status?: string;
  updated: string;
}

interface Props {
  article: ArticleData;
}

const { article } = Astro.props;
const category = getCategoryByName(article.category);
---

<a class="article-card" href={`/articles/${article.slug}/`}>
  <div class="thumbnail">
    {
      article.thumbnail ? (
        <img src={article.thumbnail} alt={article.thumbnailAlt || ""} loading="lazy" />
      ) : (
        <div class="thumbnail-placeholder" aria-hidden="true">
          <span>すまラボ</span>
        </div>
      )
    }
  </div>
  <div class="article-body">
    <div class="meta-row">
      <span>{articleTypeLabels[article.type]}</span>
      {
        category ? (
          <span>{category.name}</span>
        ) : (
          <span>{article.category}</span>
        )
      }
    </div>
    <h3>{article.title}</h3>
    <p>{article.description}</p>
    <time datetime={article.updated}>更新日: {article.updated}</time>
  </div>
</a>

<style>
  .article-card {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    min-height: 100%;
    color: var(--color-text);
    text-decoration: none;
    background: var(--bg-elev);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition:
      border-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .article-card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .thumbnail {
    aspect-ratio: 16 / 9;
    background: var(--bg-tint);
    border-bottom: 1px solid var(--line-soft);
  }

  .thumbnail img,
  .thumbnail-placeholder {
    width: 100%;
    height: 100%;
  }

  .thumbnail img {
    object-fit: cover;
  }

  .thumbnail-placeholder {
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
    color: var(--fg-faint);
    background:
      linear-gradient(135deg, var(--bg-tint), var(--bg-sunk)),
      var(--bg-tint);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .thumbnail-placeholder::before {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line-soft) 1px, transparent 1px),
      linear-gradient(90deg, var(--line-soft) 1px, transparent 1px);
    background-size: 32px 32px;
    content: "";
    opacity: 0.65;
  }

  .thumbnail-placeholder span {
    position: relative;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    background: var(--bg-elev);
    padding: 5px 10px;
    font-size: 11px;
    letter-spacing: 0.1em;
  }

  .article-body {
    display: grid;
    gap: 8px;
    padding: 18px 20px 20px;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .meta-row span {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 3px 9px;
    color: var(--color-mint-dark);
    background: var(--teal-tint);
    font-size: 11.5px;
    font-weight: 700;
    line-height: 1.3;
  }

  h3 {
    margin: 0;
    color: var(--fg);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.005em;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  p {
    margin: 0;
    color: var(--color-muted);
    font-size: 13px;
    line-height: 1.65;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  time {
    margin-top: 4px;
    color: var(--fg-faint);
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.02em;
  }
</style>
