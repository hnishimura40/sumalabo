---
import catalog from "../../../data/mnp-device-prices.json";
import benchmarkCatalog from "../../../data/mobile-device-benchmarks.json";
import MnpPriceScatter from "./MnpPriceScatter.astro";
import { mobileCarrierLinks, type MobileCarrierKey } from "../../data/mobileCarrierLinks";
import { isDeviceOfferEnded, validateCatalog } from "../../lib/mnp-device-prices.mjs";

import { getBuildNow } from "../../lib/articles";

const now = getBuildNow().getTime();
const rows = validateCatalog(catalog).rows.slice().sort((a, b) => a.mnpYen - b.mnpYen).map(row => ({
  ...row,
  benchmark: benchmarkCatalog.devices[row.id as keyof typeof benchmarkCatalog.devices],
  ended: isDeviceOfferEnded(row, now),
  stale: now - Date.parse(row.checkedAt) >= 48 * 60 * 60 * 1000,
}));
const activeRows = rows.filter(row => !row.ended);
const lastChecked = activeRows.map(row => row.checkedAt).sort((a, b) => Date.parse(a) - Date.parse(b)).at(-1);
const yen = (value: number) => new Intl.NumberFormat("ja-JP").format(value) + "円";
const time = (value: string) => new Intl.DateTimeFormat("ja-JP", {
  timeZone: "Asia/Tokyo", dateStyle: "medium", timeStyle: "short",
}).format(new Date(value));
const carriers = Object.entries(mobileCarrierLinks);
const numericSpec = (value: string) => Number(value.match(/\d+(?:\.\d+)?/)?.[0]) || null;
const referenceDetails = {
  "ymobile-aquos-wish6-128": { label: "日常使いの入門機", use: "連絡・地図・動画視聴が中心。大きめの6.6インチ画面と、5,000mAhの電池。" },
  "iijmio-nothing-phone-4b-128": { label: "大画面で動画・SNS", use: "有機ELの大画面で動画やSNSを見たい人。6.77インチと128GB。" },
  "iijmio-oppo-reno16-256": { label: "望遠カメラを使いたい", use: "持ちやすさと写真の両方を重視。6.3インチ、256GB、望遠カメラ付き。" },
  "ahamo-iphone-18-pro-256": { label: "iPhoneの上位モデル", use: "動画編集や負荷の大きいゲームも使う人。A20 Proと256GB。" },
};
const references = activeRows.filter(row => row.status === "verified" && row.id in referenceDetails);
const points = activeRows.map(row => ({
  id: row.id, name: row.model, carrier: mobileCarrierLinks[row.carrier as MobileCarrierKey].label,
  yen: row.mnpYen, reference: row.id in referenceDetails, cpu: row.benchmark?.score?.multi ?? null,
  weight: numericSpec(row.specs.weight), screen: numericSpec(row.specs.display),
}));
---

<section class="mnp-prices" aria-labelledby="mnp-prices-title" data-mnp-prices>
  <div class="mnp-heading">
    <h2 id="mnp-prices-title">端末価格の早見表</h2>
    {lastChecked && <p>最終確認 <time datetime={lastChecked}>{time(lastChecked)}</time>（日本時間）</p>}
  </div>
  <p class="mnp-price-guide">「乗り換え値引き前」は、回線契約なしでも適用される端末の値下げを反映した価格です。「返却時の端末負担額」には、指定期限に返す条件で確認できた金額を掲載します。値がない機種は一括の列を確認してください。期間を過ぎた価格は一覧から外します。</p>
  <p class="mnp-price-guide" data-mnp-scatter-link hidden><a href="#mnp-scatter-title">価格とスペックの散布図へ</a></p>
  <div class="mnp-filters" data-mnp-filters hidden>
    <label>携帯会社
      <select data-mnp-carrier>
        <option value="">すべての会社</option>
        {carriers.map(([id, info]) => <option value={id}>{info.label}</option>)}
      </select>
    </label>
    <label>価格帯（乗り換え一括）
      <select data-mnp-max>
        <option value="">すべての価格</option>
        <option value="30000">3万円以下</option>
        <option value="50000">5万円以下</option>
        <option value="100000">10万円以下</option>
        <option value="over">10万円超</option>
      </select>
    </label>
    <p data-mnp-count role="status" aria-live="polite">{activeRows.length}件</p>
  </div>
  <MnpPriceScatter points={points}>
    {references.length > 1 && <div class="mnp-reference" data-mnp-references>
      <h3>価格帯ごとに何が違う？</h3>
      <p>乗り換え一括の掲載価格です。最新の受付条件は公式価格で確認できます。</p>
      <ul>
        {references.map(row => {
          const detail = referenceDetails[row.id as keyof typeof referenceDetails];
          const score = row.benchmark?.score;
          return <li data-mnp-reference-id={row.id}>
            <span class="mnp-reference-label">{detail.label}</span>
            <strong>{row.model}</strong>
            <span class="mnp-reference-price">{yen(row.mnpYen)}</span>
            {score ? <span>CPUマルチ <a href={score.url}>{score.multi.toLocaleString("ja-JP")}点</a></span> : <span>CPUの公開測定値は未確認</span>}
            <span>{detail.use}</span>
            <small>価格確認 <time datetime={row.checkedAt}>{time(row.checkedAt)}</time></small>
            <a href={row.officialUrl}>公式価格</a>
          </li>;
        })}
      </ul>
    </div>}
  </MnpPriceScatter>
  <table class="mnp-table" role="table">
    <caption class="mnp-sr">公式オンラインショップのMNP端末価格（税込）</caption>
    <thead role="rowgroup"><tr role="row">
      <th scope="col" role="columnheader">機種・写真・主要スペック</th>
      <th scope="col" role="columnheader">乗り換え値引き前</th>
      <th scope="col" role="columnheader">乗り換え一括</th>
      <th scope="col" role="columnheader">返却時の端末負担額</th>
      <th scope="col" role="columnheader">申込条件・出典</th>
    </tr></thead>
    <tbody role="rowgroup">
      {activeRows.map(row => <tr role="row" data-mnp-id={row.id} data-carrier={row.carrier} data-price={row.mnpYen}
          data-checked={row.checkedAt} data-ends={row.endsAt} data-state={row.status}>
          <th scope="row" role="rowheader">
            <span class="mnp-carrier">{mobileCarrierLinks[row.carrier as MobileCarrierKey].label}</span>
            <strong class="mnp-model">{row.model}</strong>
            <div class:list={["mnp-device", { "mnp-device--photo": "photo" in row && row.photo }]}>
              {"photo" in row && row.photo && <figure class="mnp-photo">
                <img src={row.photo.src} alt={row.photo.alt} width="112" height="136" loading="lazy" decoding="async" />
                <figcaption>
                  <a href={row.photo.source}>写真出典</a> · <a href={row.photo.license}>{row.photo.licenseLabel ?? "CC BY-SA 4.0"}</a>
                  <span>{row.photo.credit}（{row.photo.edits ?? "WebP化"}）</span>
                </figcaption>
              </figure>}
              <div>
                <dl class="mnp-specs">
                  <dt>画面</dt><dd>{row.specs.display}</dd>
                  <dt>容量</dt><dd>{row.storage}</dd>
                  <dt>重さ</dt><dd>{row.specs.weight}</dd>
                  {"battery" in row.specs && <><dt>電池</dt><dd>{row.specs.battery}</dd></>}
                  {row.benchmark && <><dt>CPU</dt><dd>{row.benchmark.chip}</dd></>}
                </dl>
                <p class="mnp-feature">{row.specs.feature}</p>
                {row.benchmark?.score ? <p class="mnp-feature">
                  <a href={row.benchmark.score.url}>Geekbench 7</a><br/>
                  シングル {row.benchmark.score.single.toLocaleString("ja-JP")} ／ マルチ {row.benchmark.score.multi.toLocaleString("ja-JP")}
                  <span class="mnp-small">{row.benchmark.score.method}</span>
                </p> : <span class="mnp-small">Geekbench 7の点数は未確認</span>}
                <a href={row.specUrl}>{"photo" in row && row.photo ? "公式仕様" : "公式写真・仕様"}</a>
              </div>
            </div>
          </th>
          <td role="cell" class="mnp-normal">
            <span class="mnp-mobile-label" aria-hidden="true">乗り換え値引き前</span>
            <span class="mnp-yen">{yen(row.normalYen)}</span>
          </td>
          <td role="cell" class="mnp-buy">
            <span class="mnp-mobile-label" aria-hidden="true">乗り換え一括</span>
            <strong class="mnp-yen">{yen(row.mnpYen)}</strong>
          </td>
          <td role="cell" class="mnp-return">
            <span class="mnp-mobile-label" aria-hidden="true">返却時の端末負担額</span>
            {row.real ? <div>
              <strong class="mnp-yen">{yen(row.real.yen)}</strong>
              <span class="mnp-small">{row.real.installments}回払い・{row.real.plan}</span>
              <span class="mnp-small">{row.real.return}</span>
              {"url" in row.real && <a href={row.real.url}>返却時の追加費用</a>}
            </div> : <span>{"returnNote" in row ? row.returnNote : "この条件での返却額は未確認"}</span>}
          </td>
          <td role="cell" class="mnp-terms">
            <span class="mnp-flag" data-mnp-checking hidden={row.status !== "checking" || row.ended}>確認中・前回の価格</span>
            <span class="mnp-flag" data-mnp-stale hidden={!row.stale}>確認から2日以上経過</span>
            <span class="mnp-small"><b>対象</b> {row.eligibility}</span>
            <span class="mnp-small"><b>プラン</b> {row.plan}</span>
            <span class="mnp-small"><b>オプション</b> {row.option}</span>
            <span class="mnp-small"><b>期間</b> {row.period}</span>
            <span class="mnp-small"><b>確認</b> <time datetime={row.checkedAt}>{time(row.checkedAt)}</time></span>
            <a href={row.officialUrl}>公式価格</a><span aria-hidden="true"> ／ </span><a href={row.termsUrl}>公式条件</a>
          </td>
        </tr>)}
    </tbody>
  </table>
  <p data-mnp-empty hidden={activeRows.length > 0}>該当する機種がありません。会社や価格帯を変えてください。</p>
</section>

<script>
  import { isDeviceOfferEnded } from "../../lib/mnp-device-prices.mjs";

  for (const section of document.querySelectorAll<HTMLElement>("[data-mnp-prices]")) {
    const filters = section.querySelector<HTMLElement>("[data-mnp-filters]")!;
    const carrier = section.querySelector<HTMLSelectElement>("[data-mnp-carrier]")!;
    const max = section.querySelector<HTMLSelectElement>("[data-mnp-max]")!;
    const status = section.querySelector<HTMLElement>("[data-mnp-count]")!;
    const empty = section.querySelector<HTMLElement>("[data-mnp-empty]")!;
    const scatterLink = section.querySelector<HTMLElement>("[data-mnp-scatter-link]")!;
    const rows = [...section.querySelectorAll<HTMLElement>("[data-mnp-id]")];
    const references = new Map([...section.querySelectorAll<HTMLElement>("[data-mnp-reference-id]")]
      .map(card => [card.dataset.mnpReferenceId, card]));
    const referenceGroup = section.querySelector<HTMLElement>("[data-mnp-references]");
    let expiryTimer: number | undefined;
    filters.hidden = false;
    scatterLink.hidden = false;
    function refresh() {
      const now = Date.now();
      window.clearTimeout(expiryTimer);
      let shown = 0;
      let nextExpiry = Infinity;
      for (const row of rows) {
        const price = Number(row.dataset.price);
        const ended = isDeviceOfferEnded({ status: row.dataset.state, endsAt: row.dataset.ends }, now);
        const stale = now - Date.parse(row.dataset.checked!) >= 48 * 60 * 60 * 1000;
        const deadline = Date.parse(row.dataset.ends ?? "");
        if (!ended && deadline > now) nextExpiry = Math.min(nextExpiry, deadline);
        const reference = references.get(row.dataset.mnpId);
        if (reference) reference.hidden = ended;
        row.querySelector<HTMLElement>("[data-mnp-checking]")!.hidden = ended || row.dataset.state !== "checking";
        row.querySelector<HTMLElement>("[data-mnp-stale]")!.hidden = !stale;
        const inBudget = !max.value || (max.value === "over" ? price > 100000 : price <= Number(max.value));
        row.hidden = ended || Boolean((carrier.value && row.dataset.carrier !== carrier.value) || !inBudget);
        if (!row.hidden) shown++;
      }
      if (referenceGroup) referenceGroup.hidden = [...references.values()].every(card => card.hidden);
      if (nextExpiry - now < 2_147_483_647) expiryTimer = window.setTimeout(refresh, nextExpiry - now);
      status.textContent = `${shown}件`;
      empty.hidden = shown !== 0;
      section.dispatchEvent(new Event("mnp-catalog-refresh"));
    }
    filters.addEventListener("change", refresh);
    window.addEventListener("pageshow", refresh);
    refresh();
    window.setInterval(refresh, 60_000);
  }
</script>

<style>
  .mnp-reference { margin-block: 1rem 1.5rem; }
  .mnp-reference h3 { margin-bottom: .35rem; }
  .mnp-reference > p { font-size: .88rem; }
  .mnp-reference ul { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%, 205px),1fr)); gap: .7rem; list-style: none; padding: 0; margin: .7rem 0 0; }
  .mnp-reference li { display: flex; flex-direction: column; align-items: flex-start; gap: .25rem; border: 1px solid var(--line); border-radius: .55rem; padding: .75rem; margin: 0; font-size: .88rem; }
  .mnp-reference-label { font-size: .8rem; font-weight: 700; }
  .mnp-reference-price { font-size: 1.2rem; font-weight: 750; font-variant-numeric: tabular-nums; }
  .mnp-prices { margin-block: 2rem; color: var(--fg); }
  .mnp-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .25rem 1rem; }
  .mnp-heading h2 { margin: 0; scroll-margin-top: 116px; }
  .mnp-heading p, .mnp-filters p { margin: 0; font-size: .875rem; color: var(--fg); }
  .mnp-price-guide { margin: .5rem 0 0; font-size: .875rem; line-height: 1.6; }
  .mnp-filters { display: flex; flex-wrap: wrap; gap: .75rem; align-items: end; margin: 1rem 0; }
  .mnp-filters label { display: grid; gap: .25rem; font-weight: 650; font-size: .875rem; }
  .mnp-filters select { min-height: 44px; max-width: 100%; border: 1px solid var(--line); border-radius: 9px; background: var(--bg-elev); color: var(--fg); padding-inline: .55rem; font: inherit; }
  .mnp-filters p { margin: 0 0 .55rem auto; }
  .mnp-prices table.mnp-table { width: 100%; margin: .65rem 0 0; border-collapse: collapse; table-layout: fixed; color: var(--fg); background: transparent; }
  .mnp-prices table.mnp-table :is(th,td) { border: 0; border-bottom: 1px solid var(--line); padding: .8rem .55rem; background: transparent; color: var(--fg); vertical-align: top; text-align: left; overflow-wrap: anywhere; }
  .mnp-table thead { border-bottom: 2px solid var(--fg); }
  .mnp-table thead th:first-child { width: 28%; }
  .mnp-table thead th:nth-child(2) { width: 10%; }
  .mnp-table thead th:nth-child(3) { width: 12%; }
  .mnp-table thead th:nth-child(4) { width: 22%; }
  .mnp-table a { color: var(--fg); font-size: .83rem; text-decoration: underline; text-underline-offset: .2em; }
  .mnp-model, .mnp-carrier, .mnp-small, .mnp-flag { display: block; }
  .mnp-device { margin-top: .55rem; }
  .mnp-device--photo { display: grid; grid-template-columns: clamp(76px, 8vw, 112px) minmax(0, 1fr); align-items: start; gap: .75rem; }
  .mnp-photo { margin: 0; min-width: 0; }
  .mnp-prices table.mnp-table .mnp-photo img { display: block; width: 100%; height: auto; aspect-ratio: 112 / 136; object-fit: contain; border: 1px solid var(--line); border-radius: 8px; margin: 0; }
  .mnp-photo figcaption, .mnp-photo a { color: var(--fg); font-size: .72rem; font-weight: 400; }
  .mnp-photo figcaption span { display: block; }
  .mnp-specs { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: .15rem .45rem; margin: 0; font-size: .82rem; line-height: 1.5; }
  .mnp-specs dd { margin: 0; font-weight: 400; }
  .mnp-specs dt { font-weight: 650; }
  .mnp-feature { margin: .35rem 0 .1rem; font-size: .82rem; font-weight: 400; line-height: 1.5; }
  .mnp-carrier, .mnp-small { font-size: .82rem; line-height: 1.55; font-weight: 400; }
  .mnp-small + .mnp-small { margin-top: .25rem; }
  .mnp-model { margin: .15rem 0 .25rem; line-height: 1.35; }
  .mnp-yen { white-space: nowrap; font-variant-numeric: tabular-nums; display: block; font-size: 1.075rem; }
  .mnp-buy .mnp-yen { font-size: 1.25rem; }
  .mnp-mobile-label { display: none; }
  .mnp-flag { font-weight: 750; border-inline-start: 2px solid currentColor; padding-inline-start: .35rem; font-size: .83rem; margin-bottom: .4rem; }
  .mnp-prices [hidden] { display: none !important; }
  .mnp-sr { position: absolute; width: 1px; height: 1px; clip-path: inset(50%); overflow: hidden; white-space: nowrap; }
  @media (min-width: 830px) {
    .mnp-prices { margin-top: 0; }
    .mnp-filters { gap: 1.4rem; }
    .mnp-filters label { grid-template-columns: auto minmax(145px, 210px); align-items: center; gap: .6rem; }
    .mnp-prices table.mnp-table :is(th,td) { padding: .9rem .7rem; }
    .mnp-model { font-size: 1.12rem; }
  }
  @media (max-width: 829px) {
    .mnp-filters { display: grid; grid-template-columns: 1fr 1fr; align-items: start; }
    .mnp-filters p { grid-column: 1 / -1; margin: 0; }
    .mnp-prices table.mnp-table, .mnp-table tbody { display: block; }
    .mnp-table thead { position: absolute; width: 1px; height: 1px; clip-path: inset(50%); overflow: hidden; white-space: nowrap; }
    .mnp-table tbody tr { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); margin: 0 0 .8rem; border: 1px solid var(--line); border-radius: 12px; padding: .15rem .65rem; }
    .mnp-table tbody :is(th,.mnp-return,.mnp-terms) { grid-column: 1 / -1; }
    .mnp-prices table.mnp-table :is(th,td) { padding: .65rem .2rem; }
    .mnp-table .mnp-terms { border-bottom: 0 !important; }
    .mnp-mobile-label { display: block; font-size: .86rem; font-weight: 700; }
  }
</style>
