---
import catalog from "../../../data/mnp-device-prices.json";
import { mobileCarrierLinks, type MobileCarrierKey } from "../../data/mobileCarrierLinks";
import { validateCatalog } from "../../lib/mnp-device-prices.mjs";

const now = Date.now();
const rows = validateCatalog(catalog).rows.slice().sort((a, b) => a.mnpYen - b.mnpYen).map(row => ({
  ...row,
  ended: row.status === "ended" || Boolean(row.endsAt && Date.parse(row.endsAt) <= now),
  stale: now - Date.parse(row.checkedAt) >= 48 * 60 * 60 * 1000,
}));
const lastChecked = rows.map(row => row.checkedAt).sort().at(-1);
const yen = (value: number) => new Intl.NumberFormat("ja-JP").format(value) + "円";
const time = (value: string) => new Intl.DateTimeFormat("ja-JP", {
  timeZone: "Asia/Tokyo", dateStyle: "medium", timeStyle: "short",
}).format(new Date(value));
const carriers = Object.entries(mobileCarrierLinks);
---

<section class="mnp-prices" aria-labelledby="mnp-prices-title" data-mnp-prices>
  <div class="mnp-heading">
    <h2 id="mnp-prices-title">端末価格の早見表</h2>
    <p>最終確認 <time datetime={lastChecked}>{time(lastChecked!)}</time>（日本時間）</p>
  </div>
  <div class="mnp-filters" data-mnp-filters hidden>
    <label>携帯会社
      <select data-mnp-carrier>
        <option value="">すべての会社</option>
        {carriers.map(([id, info]) => <option value={id}>{info.label}</option>)}
      </select>
    </label>
    <label>価格帯（乗り換え一括）
      <select data-mnp-max>
        <option value="">すべての価格</option>
        <option value="30000">3万円以下</option>
        <option value="50000">5万円以下</option>
        <option value="100000">10万円以下</option>
        <option value="over">10万円超</option>
      </select>
    </label>
    <p data-mnp-count role="status" aria-live="polite">{rows.length}件</p>
  </div>
  <table class="mnp-table" role="table">
    <caption class="mnp-sr">公式オンラインショップのMNP端末価格（税込）</caption>
    <thead role="rowgroup"><tr role="row">
      <th scope="col" role="columnheader">機種・容量</th>
      <th scope="col" role="columnheader">通常価格</th>
      <th scope="col" role="columnheader">乗り換え一括</th>
      <th scope="col" role="columnheader">実質価格（返却）</th>
      <th scope="col" role="columnheader">申込条件・出典</th>
    </tr></thead>
    <tbody role="rowgroup">
      {rows.map(row => <tr role="row" data-mnp-id={row.id} data-carrier={row.carrier} data-price={row.mnpYen}
          data-checked={row.checkedAt} data-ends={row.endsAt} data-state={row.status} class:list={{ "mnp-expired": row.ended }}>
          <th scope="row" role="rowheader">
            <span class="mnp-carrier">{mobileCarrierLinks[row.carrier as MobileCarrierKey].label}</span>
            <strong class="mnp-model">{row.model}</strong>
            <span class="mnp-small">{row.storage} ／ {row.specs.display} ／ {row.specs.weight}</span>
            <span class="mnp-small">{row.specs.feature}</span>
            <a href={row.specUrl}>外観・仕様</a>
            {"photo" in row && row.photo && <figure class="mnp-photo">
              <img src={row.photo.src} alt={row.photo.alt} width="250" height="333" loading="lazy" />
              <figcaption>参考写真 <a href={row.photo.source}>{row.photo.credit}</a> ／ <a href={row.photo.license}>CC BY-SA 4.0</a>（WebP化）</figcaption>
            </figure>}
          </th>
          <td role="cell" class="mnp-normal">
            <span class="mnp-mobile-label" aria-hidden="true">通常価格</span>
            <span class="mnp-yen">{yen(row.normalYen)}</span>
          </td>
          <td role="cell" class="mnp-buy">
            <span class="mnp-mobile-label" aria-hidden="true">乗り換え一括</span>
            <strong class="mnp-yen">{yen(row.mnpYen)}</strong>
          </td>
          <td role="cell" class="mnp-return">
            <span class="mnp-mobile-label" aria-hidden="true">実質価格（返却）</span>
            {row.real ? <div>
              <strong class="mnp-yen">{yen(row.real.yen)}</strong>
              <span class="mnp-small">{row.real.installments}回払い・{row.real.plan}</span>
              <span class="mnp-small">{row.real.return}</span>
              {"url" in row.real && <a href={row.real.url}>返却時の追加費用</a>}
            </div> : <span>返却価格の掲載なし</span>}
          </td>
          <td role="cell" class="mnp-terms">
            <span class="mnp-flag" data-mnp-ended hidden={!row.ended}>掲載期間終了・過去の価格</span>
            <span class="mnp-flag" data-mnp-checking hidden={row.status !== "checking" || row.ended}>確認中・前回の価格</span>
            <span class="mnp-flag" data-mnp-stale hidden={!row.stale}>確認から2日以上経過</span>
            <span class="mnp-small"><b>対象</b> {row.eligibility}</span>
            <span class="mnp-small"><b>プラン</b> {row.plan}</span>
            <span class="mnp-small"><b>オプション</b> {row.option}</span>
            <span class="mnp-small"><b>期間</b> {row.period}</span>
            <span class="mnp-small"><b>確認</b> <time datetime={row.checkedAt}>{time(row.checkedAt)}</time></span>
            <a href={row.officialUrl}>公式価格</a><span aria-hidden="true"> ／ </span><a href={row.termsUrl}>公式条件</a>
          </td>
        </tr>)}
    </tbody>
  </table>
  <p data-mnp-empty hidden>該当する機種がありません。会社や価格帯を変えてください。</p>
</section>

<script>
  for (const section of document.querySelectorAll<HTMLElement>("[data-mnp-prices]")) {
    const filters = section.querySelector<HTMLElement>("[data-mnp-filters]")!;
    const carrier = section.querySelector<HTMLSelectElement>("[data-mnp-carrier]")!;
    const max = section.querySelector<HTMLSelectElement>("[data-mnp-max]")!;
    const status = section.querySelector<HTMLElement>("[data-mnp-count]")!;
    const empty = section.querySelector<HTMLElement>("[data-mnp-empty]")!;
    const rows = [...section.querySelectorAll<HTMLElement>("[data-mnp-id]")];
    filters.hidden = false;
    function refresh() {
      const now = Date.now();
      let shown = 0;
      for (const row of rows) {
        const price = Number(row.dataset.price);
        const ended = row.dataset.state === "ended" || Boolean(row.dataset.ends && Date.parse(row.dataset.ends) <= now);
        const stale = now - Date.parse(row.dataset.checked!) >= 48 * 60 * 60 * 1000;
        row.classList.toggle("mnp-expired", ended);
        row.querySelector<HTMLElement>("[data-mnp-ended]")!.hidden = !ended;
        row.querySelector<HTMLElement>("[data-mnp-checking]")!.hidden = ended || row.dataset.state !== "checking";
        row.querySelector<HTMLElement>("[data-mnp-stale]")!.hidden = !stale;
        const inBudget = !max.value || (max.value === "over" ? price > 100000 : price <= Number(max.value));
        row.hidden = Boolean((carrier.value && row.dataset.carrier !== carrier.value) || !inBudget);
        if (!row.hidden) shown++;
      }
      status.textContent = `${shown}件`;
      empty.hidden = shown !== 0;
    }
    filters.addEventListener("change", refresh);
    window.addEventListener("pageshow", refresh);
    refresh();
    window.setInterval(refresh, 60_000);
  }
</script>

<style>
  .mnp-prices { margin-block: 2rem; color: var(--fg); }
  .mnp-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .25rem 1rem; }
  .mnp-heading h2 { margin: 0; scroll-margin-top: 116px; }
  .mnp-heading p, .mnp-filters p { margin: 0; font-size: .875rem; color: var(--fg); }
  .mnp-filters { display: flex; flex-wrap: wrap; gap: .75rem; align-items: end; margin: 1rem 0; }
  .mnp-filters label { display: grid; gap: .25rem; font-weight: 650; font-size: .875rem; }
  .mnp-filters select { min-height: 44px; max-width: 100%; border: 1px solid var(--line); border-radius: 9px; background: var(--bg-elev); color: var(--fg); padding-inline: .55rem; font: inherit; }
  .mnp-filters p { margin: 0 0 .55rem auto; }
  .mnp-prices table.mnp-table { width: 100%; margin: .65rem 0 0; border-collapse: collapse; table-layout: fixed; color: var(--fg); background: transparent; }
  .mnp-prices table.mnp-table :is(th,td) { border: 0; border-bottom: 1px solid var(--line); padding: .8rem .55rem; background: transparent; color: var(--fg); vertical-align: top; text-align: left; overflow-wrap: anywhere; }
  .mnp-table thead { border-bottom: 2px solid var(--fg); }
  .mnp-table thead th:first-child { width: 19%; }
  .mnp-table thead th:nth-child(2) { width: 11%; }
  .mnp-table thead th:nth-child(3) { width: 14%; }
  .mnp-table thead th:nth-child(4) { width: 24%; }
  .mnp-table a { color: var(--fg); font-size: .83rem; text-decoration: underline; text-underline-offset: .2em; }
  .mnp-model, .mnp-carrier, .mnp-small, .mnp-flag { display: block; }
  .mnp-photo { margin: .6rem 0 0; }
  .mnp-photo img { display: block; width: 74px; height: auto; border-radius: 6px; }
  .mnp-photo figcaption, .mnp-photo a { color: var(--fg); font-size: .75rem; font-weight: 400; }
  .mnp-carrier, .mnp-small { font-size: .82rem; line-height: 1.55; font-weight: 400; }
  .mnp-small + .mnp-small { margin-top: .25rem; }
  .mnp-model { margin: .15rem 0 .25rem; line-height: 1.35; }
  .mnp-yen { white-space: nowrap; font-variant-numeric: tabular-nums; display: block; font-size: 1.075rem; }
  .mnp-buy .mnp-yen { font-size: 1.25rem; }
  .mnp-mobile-label { display: none; }
  .mnp-flag { font-weight: 750; border-inline-start: 2px solid currentColor; padding-inline-start: .35rem; font-size: .83rem; margin-bottom: .4rem; }
  .mnp-expired :is(.mnp-buy,.mnp-return) .mnp-yen { text-decoration: line-through; }
  .mnp-prices [hidden] { display: none !important; }
  .mnp-sr { position: absolute; width: 1px; height: 1px; clip-path: inset(50%); overflow: hidden; white-space: nowrap; }
  @media (min-width: 830px) {
    .mnp-prices { margin-top: 0; }
    .mnp-filters { gap: 1.4rem; }
    .mnp-filters label { grid-template-columns: auto minmax(145px, 210px); align-items: center; gap: .6rem; }
    .mnp-prices table.mnp-table :is(th,td) { padding: .9rem .7rem; }
    .mnp-model { font-size: 1.12rem; }
  }
  @media (max-width: 829px) {
    .mnp-filters { display: grid; grid-template-columns: 1fr 1fr; align-items: start; }
    .mnp-filters p { grid-column: 1 / -1; margin: 0; }
    .mnp-prices table.mnp-table, .mnp-table tbody { display: block; }
    .mnp-table thead { position: absolute; width: 1px; height: 1px; clip-path: inset(50%); overflow: hidden; white-space: nowrap; }
    .mnp-table tbody tr { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); margin: 0 0 .8rem; border: 1px solid var(--line); border-radius: 12px; padding: .15rem .65rem; }
    .mnp-table tbody :is(th,.mnp-return,.mnp-terms) { grid-column: 1 / -1; }
    .mnp-prices table.mnp-table :is(th,td) { padding: .65rem .2rem; }
    .mnp-table .mnp-terms { border-bottom: 0 !important; }
    .mnp-mobile-label { display: block; font-size: .86rem; font-weight: 700; }
  }
</style>
