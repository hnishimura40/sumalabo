---
// Main2.dc.html: white surface, teal / orange decisions, segment map and sticky comparison columns.
---
<script>
function setupRenewal(){document.querySelectorAll('.comparison-renewal').forEach(root=>{const tabs=[...root.querySelectorAll<HTMLButtonElement>('[data-r-tab]')];const activate=(tab:HTMLButtonElement)=>{tabs.forEach(t=>{t.setAttribute('aria-selected',String(t===tab));t.tabIndex=t===tab?0:-1;});root.querySelectorAll<HTMLElement>('[data-r-panel]').forEach(p=>p.hidden=p.dataset.rPanel!==tab.dataset.rTab);};tabs.forEach((tab,i)=>{tab.onclick=()=>activate(tab);tab.onkeydown=e=>{let n=i;if(e.key==='ArrowRight')n=(i+1)%tabs.length;else if(e.key==='ArrowLeft')n=(i-1+tabs.length)%tabs.length;else if(e.key==='Home')n=0;else if(e.key==='End')n=tabs.length-1;else return;e.preventDefault();activate(tabs[n]);tabs[n].focus();};});if(tabs[0])activate(tabs[0]);});}
setupRenewal();document.addEventListener('astro:page-load',setupRenewal);
</script>
<style is:global>
.article-content .comparison-renewal{--r-line:#e3e0d6;max-width:100%;min-width:0;background:#fff;color:#15171c;padding:24px;border-radius:16px;line-height:1.7;overflow-wrap:anywhere}
.article-content .comparison-renewal *{box-sizing:border-box;min-width:0}.article-content .comparison-renewal h2{font-size:25px;border:0;margin:44px 0 20px}.article-content .comparison-renewal h3{border:0;font-size:21px;margin:10px 0}.article-content .comparison-renewal p,.article-content .comparison-renewal li{color:#394451;font-size:14px}.article-content .comparison-renewal a{color:#146b65}
.r-summary{background:#f4f2ea;padding:20px;border-radius:12px}.r-summary dl{display:grid;grid-template-columns:140px minmax(0,1fr);gap:10px}.r-summary dd{margin:0}.r-summary dt{font-weight:700}.r-picks{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.r-pick{border:1px solid var(--r-line);border-radius:14px;padding:22px;background:#fff}.r-featured{border-top:5px solid #1e9c8b}.r-card-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:24px;align-items:center}.r-photo{margin:0!important}.r-photo img{object-fit:contain;max-height:220px}.r-photo figcaption{font-size:11px;color:#5b6472}.r-eyebrow{font-weight:800;color:#146b65!important}.r-bars{list-style:none;padding:0!important;font-size:12px}.r-bar{display:block;height:8px;background:#ece9df;border-radius:6px;margin:6px 0 12px}.r-bar span{display:block;height:100%;background:#15171c;border-radius:6px}.r-runner{border-top:1px solid var(--r-line);padding-top:12px}.r-map{border:1px solid var(--r-line);border-radius:12px;padding:20px}.r-map-row{display:grid;grid-template-columns:100px minmax(0,1fr);gap:16px;align-items:center;border-bottom:1px solid var(--r-line)}.r-map-track{height:160px;position:relative;background:linear-gradient(to right,#f5f4ef,#fff)}.r-dot{position:absolute;top:25px;max-width:110px;font-size:11px;padding:6px;border-left:3px solid #aaa;background:#f4f2ea}.r-dot:nth-child(even){top:85px}.r-dot small{display:block}.r-dot.r-selected{border-color:#1e9c8b;background:#e8f7f2}.r-chips{display:none}.r-tabs{display:flex;flex-wrap:wrap;gap:8px;margin:20px 0}.r-tabs button{border:1px solid var(--r-line);border-radius:8px;background:#f4f2ea;color:#15171c;padding:12px;cursor:pointer}.r-tabs [aria-selected=true]{background:#146b65;color:white}.r-tablewrap{overflow-x:auto;max-width:100%;border:1px solid var(--r-line);border-radius:12px;overscroll-behavior-inline:contain}.article-content .comparison-renewal table.r-table{display:table!important;table-layout:auto;width:100%;min-width:760px;border-collapse:separate;border-spacing:0;overflow:visible}.r-table th,.r-table td{padding:12px 14px!important;border-bottom:1px solid var(--r-line);text-align:left;vertical-align:top;font-size:13px!important;white-space:normal!important}.r-table th{background:#f4f2ea}.r-table th:first-child{position:sticky;left:0;min-width:170px;max-width:210px;background:#fff;z-index:1;box-shadow:2px 0 0 var(--r-line)}.r-table td{min-width:130px;max-width:280px}.r-table small{display:block}.r-table .r-photo img{max-height:64px}.r-common{border-left:3px solid #1e9c8b;padding:0 16px;margin:24px 0}.comparison-renewal details{margin:16px 0}.comparison-renewal [hidden]{display:none!important}.comparison-renewal :focus-visible{outline:3px solid #1e9c8b;outline-offset:3px}
@media(max-width:720px){.article-content .comparison-renewal{padding:16px}.r-card-grid,.r-picks{grid-template-columns:minmax(0,1fr)}.r-pick{padding:16px}.r-summary dl{grid-template-columns:minmax(0,1fr);gap:4px}.r-summary dd{margin-bottom:10px}.r-map{display:none}.r-chips{display:flex;flex-direction:column;gap:14px}.r-chips ul{display:flex;flex-wrap:wrap;gap:8px;padding:0!important;list-style:none}.r-chips li{border:1px solid var(--r-line);padding:6px;border-radius:8px}.r-card-grid .r-photo{max-width:240px;justify-self:center}.article-content .comparison-renewal h3{font-size:20px}.r-tabs{display:flex;flex-wrap:nowrap;overflow-x:auto;padding-bottom:8px}.r-tabs button{flex-shrink:0}.r-tablewrap:focus-visible{outline:2px solid #146b65}}
</style>
