---
// Main2.dc.html: white surface, teal / orange decisions, segment map and sticky comparison columns.
---
<script>
function setupRenewal(){document.querySelectorAll('.comparison-renewal').forEach(root=>{const tabs=[...root.querySelectorAll<HTMLButtonElement>('[data-r-tab]')];const activate=(tab:HTMLButtonElement)=>{tabs.forEach(t=>{t.setAttribute('aria-selected',String(t===tab));t.tabIndex=t===tab?0:-1;});root.querySelectorAll<HTMLElement>('[data-r-panel]').forEach(p=>p.hidden=p.dataset.rPanel!==tab.dataset.rTab);};tabs.forEach((tab,i)=>{tab.onclick=()=>activate(tab);tab.onkeydown=e=>{let n=i;if(e.key==='ArrowRight')n=(i+1)%tabs.length;else if(e.key==='ArrowLeft')n=(i-1+tabs.length)%tabs.length;else if(e.key==='Home')n=0;else if(e.key==='End')n=tabs.length-1;else return;e.preventDefault();activate(tabs[n]);tabs[n].focus();};});if(tabs[0])activate(tabs[0]);});}
setupRenewal();document.addEventListener('astro:page-load',setupRenewal);
</script>
<style is:global>
.article-content .comparison-renewal{--r-line:#e3e0d6;max-width:100%;min-width:0;background:#fff;color:#15171c;padding:24px;border-radius:16px;line-height:1.7;overflow-wrap:anywhere}
.article-content .comparison-renewal *{box-sizing:border-box;min-width:0}.article-content .comparison-renewal h2{font-size:25px;border:0;margin:44px 0 20px}.article-content .comparison-renewal h3{border:0;font-size:21px;margin:10px 0}.article-content .comparison-renewal p,.article-content .comparison-renewal li{color:#394451;font-size:14px}.article-content .comparison-renewal a{color:#146b65}
.article-content .comparison-renewal :is(h2,h3,h4,dt,strong){color:#15171c!important}.r-summary{background:#f4f2ea;padding:20px;border-radius:12px}.r-summary dl{display:grid;grid-template-columns:140px minmax(0,1fr);gap:10px}.r-summary dd{margin:0}.r-summary dt{font-weight:700}.r-picks{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.r-pick{border:1px solid var(--r-line);border-radius:14px;padding:22px;background:#fff}.r-featured{border-top:5px solid #1e9c8b}.r-card-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:24px;align-items:center}.r-photo{margin:0!important}.r-photo img{object-fit:contain;max-height:220px}.r-photo figcaption{font-size:11px;color:#5b6472}.r-eyebrow{font-weight:800;color:#146b65!important}.r-bars{list-style:none;padding:0!important;font-size:12px}.r-bar{display:block;height:8px;background:#ece9df;border-radius:6px;margin:6px 0 12px}.r-bar span{display:block;height:100%;background:#15171c;border-radius:6px}.r-runner{border-top:1px solid var(--r-line);padding-top:12px}.r-map{border:1px solid var(--r-line);border-radius:12px;padding:20px}.r-map-row{display:grid;grid-template-columns:100px minmax(0,1fr);gap:16px;align-items:center;border-bottom:1px solid var(--r-line)}.r-map-track{height:160px;position:relative;background:linear-gradient(to right,#f5f4ef,#fff)}.r-dot{position:absolute;top:25px;max-width:110px;font-size:11px;padding:6px;border-left:3px solid #aaa;background:#f4f2ea}.r-dot:nth-child(even){top:85px}.r-dot small{display:block}.r-dot.r-selected{border-color:#1e9c8b;background:#e8f7f2}.r-chips{display:none}.r-tabs{display:flex;flex-wrap:wrap;gap:8px;margin:20px 0}.r-tabs button{border:1px solid var(--r-line);border-radius:8px;background:#f4f2ea;color:#15171c;padding:12px;cursor:pointer}.r-tabs [aria-selected=true]{background:#146b65;color:white}.r-tablewrap{overflow-x:auto;max-width:100%;border:1px solid var(--r-line);border-radius:12px;overscroll-behavior-inline:contain}.article-content .comparison-renewal table.r-table{display:table!important;table-layout:auto;width:100%;min-width:760px;border-collapse:separate;border-spacing:0;overflow:visible}.r-table th,.r-table td{padding:12px 14px!important;border-bottom:1px solid var(--r-line);text-align:left;vertical-align:top;font-size:13px!important;white-space:normal!important}.r-table th{background:#f4f2ea}.r-table th:first-child{position:sticky;left:0;min-width:170px;max-width:210px;background:#fff;z-index:1;box-shadow:2px 0 0 var(--r-line)}.r-table td{min-width:130px;max-width:280px}.r-table small{display:block}.r-table .r-photo img{max-height:64px}.r-common{border-left:3px solid #1e9c8b;padding:0 16px;margin:24px 0}.comparison-renewal details{margin:16px 0}.comparison-renewal [hidden]{display:none!important}.comparison-renewal :focus-visible{outline:3px solid #1e9c8b;outline-offset:3px}
@media(max-width:720px){.article-content .comparison-renewal{padding:16px}.r-card-grid,.r-picks{grid-template-columns:minmax(0,1fr)}.r-pick{padding:16px}.r-summary dl{grid-template-columns:minmax(0,1fr);gap:4px}.r-summary dd{margin-bottom:10px}.r-map{display:none}.r-chips{display:flex;flex-direction:column;gap:14px}.r-chips ul{display:flex;flex-wrap:wrap;gap:8px;padding:0!important;list-style:none}.r-chips li{border:1px solid var(--r-line);padding:6px;border-radius:8px}.r-card-grid .r-photo{max-width:240px;justify-self:center}.article-content .comparison-renewal h3{font-size:20px}.r-tabs{display:flex;flex-wrap:nowrap;overflow-x:auto;padding-bottom:8px}.r-tabs button{flex-shrink:0}.r-tablewrap:focus-visible{outline:2px solid #146b65}}
</style>

<style is:global>
.article-content .comparison-renewal .r-visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%)}.comparison-renewal .r-summary{padding:24px;background:#f4f2ea;border-radius:16px}.article-content .comparison-renewal .r-summary h2{font-size:13px;margin:0 0 14px;letter-spacing:.08em}.r-summary dl{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 28px;margin:0}.r-summary dt{font-size:14px;font-weight:900}.r-summary dd{font-size:14px;margin:4px 0 0;line-height:1.65}.r-pick.r-featured{border:0;padding:0;margin:40px 0;background:transparent}.r-featured .r-card-grid{grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:28px;align-items:center}.r-photo-stage{position:relative;background:#f4f2ea;border-radius:20px;padding:28px;display:flex;align-items:center;justify-content:center}.r-photo-stage .r-photo{width:100%;max-width:420px}.r-photo-stage .rakuten-affiliate-image,.r-photo-stage .rakuten-affiliate-image-link{width:100%!important;height:auto!important}.r-photo-stage .rakuten-affiliate-image-link img{width:100%!important;height:auto!important;aspect-ratio:1;max-height:none;border:0!important;border-radius:0!important;background:transparent!important;mix-blend-mode:multiply;object-fit:contain}.r-photo-stage figcaption{font-size:10px;margin-top:6px}.r-award{position:absolute;top:-14px;left:-12px;width:108px;height:108px;border-radius:50%;background:#f4c430;color:#15171c;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:11px;font-weight:900;line-height:1.3;box-shadow:0 4px 0 #15171c;transform:rotate(-8deg)}.r-award small{font-size:10px}.r-award strong{font-size:15px}.r-card-copy{display:flex;flex-direction:column;gap:12px}.article-content .comparison-renewal .r-slot{align-self:flex-start;margin:0;padding:3px 8px;border-radius:4px;background:#15171c;color:#f4c430;font-size:12px;font-weight:900}.article-content .comparison-renewal .r-claim{font-size:32px;margin:0;border:0;padding:0;line-height:1.3;font-weight:900}.article-content .comparison-renewal .r-product-name{font-size:24px;font-weight:900;margin:0;color:#15171c}.r-reasons{list-style:none;padding:0!important;margin:0;display:flex;flex-direction:column;gap:6px}.r-reasons li{font-size:14px!important;line-height:1.6}.r-ok{color:#1e9c8b;font-weight:900}.r-no{color:#d9641e;font-weight:900}.r-position{border-top:1px solid #e3e0d6;padding-top:12px}.r-position h4{margin:0 0 10px;font-size:12px}.r-bars{margin:0!important;padding:0!important}.r-bars li{display:grid;grid-template-columns:110px minmax(0,1fr) 80px;gap:10px;align-items:center;margin-bottom:8px;font-size:12px!important}.r-bars strong{font-size:11px;text-align:right}.r-bar{margin:0}.article-content .comparison-renewal .r-price-note{font-size:10px;margin:0;color:#8a919c}.r-card-copy .renewal-prices{margin:0}.r-difference{display:grid;grid-template-columns:44px minmax(0,1fr);gap:12px;align-items:start;margin-top:22px;border:2px solid #15171c;border-radius:14px;padding:14px 16px;background:#fff}.r-difference img{width:44px;height:44px;object-fit:contain;margin:0}.r-difference p{font-size:14px!important;margin:0;line-height:1.65}.r-difference strong{background:#f4c430;padding:1px 6px;border-radius:3px}.r-picks .r-card-grid{grid-template-columns:130px minmax(0,1fr);gap:16px;align-items:start}.r-picks .r-photo-stage{padding:10px;border-radius:12px}.article-content .comparison-renewal .r-picks .r-claim{font-size:20px}.article-content .comparison-renewal .r-picks .r-product-name{font-size:14px}.r-picks .r-pick{padding:20px}.r-picks .r-difference{padding:10px;border-width:1px;grid-template-columns:32px minmax(0,1fr);gap:8px}.r-picks .r-difference img{width:32px;height:32px}.r-picks .r-difference p{font-size:12px!important}.r-table th .r-photo{width:64px!important;--product-image-size:64px}.r-table th .r-photo img{max-height:64px}
@media(max-width:720px){.r-summary dl,.r-featured .r-card-grid,.r-picks{grid-template-columns:minmax(0,1fr)}.comparison-renewal .r-summary{padding:18px}.r-summary dl{gap:12px}.r-featured .r-card-grid{gap:24px}.r-pick.r-featured{margin-top:36px}.r-award{width:84px;height:84px;font-size:10px;left:-8px;top:-12px}.r-award strong{font-size:12px}.r-featured .r-photo-stage{padding:26px;min-height:240px}.r-featured .r-photo-stage .r-photo{max-width:300px}.article-content .comparison-renewal .r-claim{font-size:24px}.r-bars li{grid-template-columns:90px minmax(0,1fr) 65px;gap:8px}.r-picks .r-card-grid{grid-template-columns:minmax(0,1fr)}.r-picks .r-photo-stage{max-width:200px;justify-self:center;width:100%}.r-difference{padding:12px}.r-difference p{font-size:13px!important}}
</style>

<style is:global>
