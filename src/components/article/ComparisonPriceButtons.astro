---
import { buildMallLink } from '../../config/affiliate';
interface Props { model: string; rakutenUrl: string; price: number | null; }
const {model,rakutenUrl,price}=Astro.props;
const stores=[['rakuten','楽天',rakutenUrl],['amazon','Amazon','https://www.amazon.co.jp/s?k='+encodeURIComponent(model)]] as const;
---
<div class="renewal-prices" aria-label="価格を確認する">
{stores.map(([store,label,url])=>{const built=buildMallLink(store,url);return <a href={built.href} target="_blank" rel={built.affiliate?'nofollow sponsored noopener':'noopener'} data-price-store={store} data-price-model={model}>{label}で見る ▶ {price?price.toLocaleString('ja-JP')+'円〜':'価格確認'}（広告）</a>;})}
</div>
<style>
  .renewal-prices{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}
  :global(html.dark) .renewal-prices {
    --price-fill: var(--fg);
    --price-inverse: var(--bg-sunk);
    --price-outline: var(--bg-elev);
  }
  .renewal-prices a{display:block;padding:10px 14px;background:var(--price-fill,#15171c);border:2px solid var(--price-fill,#15171c);color:var(--price-inverse,#fff)!important;border-radius:8px;font-size:13px;font-weight:700;overflow-wrap:anywhere}
  .renewal-prices a[data-price-store="amazon"]{background:var(--price-outline,#fff);color:var(--price-fill,#15171c)!important}
</style>
