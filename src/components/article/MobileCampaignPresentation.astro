<script>
  const section = document.querySelector<HTMLElement>(".mobile-campaigns");
  if (section) {
    const filters = section.querySelector<HTMLElement>(".campaign-filters");
    const buttons = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-audience-filter]"));
    const carrier = section.querySelector<HTMLSelectElement>("[data-carrier-filter]");
    const rows = Array.from(section.querySelectorAll<HTMLElement>(".campaign-table tbody tr"));
    const offers = Array.from(section.querySelectorAll<HTMLElement>(".campaign-detail-list > details"));
    const status = section.querySelector<HTMLElement>(".campaign-count");
    const empty = section.querySelector<HTMLElement>(".campaign-empty");
    let audience = "all";

    const update = () => {
      for (const item of [...rows, ...offers]) {
        const audiences = item.dataset.audiences?.split(" ").filter(Boolean) || [];
        const audienceMatches = audience === "all" || !audiences.length || audiences.includes(audience);
        item.hidden = !audienceMatches || (carrier?.value !== "all" && item.dataset.carrier !== carrier?.value);
      }
      const count = rows.filter(row => !row.hidden).length;
      if (status) status.textContent = `${count}件を表示`;
      if (empty) empty.hidden = count > 0;
    };

    for (const button of buttons) {
      button.addEventListener("click", () => {
        audience = button.dataset.audienceFilter || "all";
        for (const option of buttons) option.setAttribute("aria-pressed", String(option === button));
        update();
      });
    }
    carrier?.addEventListener("change", update);
    if (filters) filters.hidden = false;

    const openLinkedOffer = () => {
      const target = document.getElementById(location.hash.slice(1));
      if (!(target instanceof HTMLDetailsElement) || !section.contains(target)) return;
      target.open = true;
      const history = target.closest<HTMLDetailsElement>(".campaign-history");
      if (history) history.open = true;
      if (target.hidden) {
        audience = "all";
        if (carrier) carrier.value = "all";
        for (const button of buttons) button.setAttribute("aria-pressed", String(button.dataset.audienceFilter === "all"));
        update();
      }
      target.scrollIntoView({ block: "start" });
    };
    window.addEventListener("hashchange", openLinkedOffer);
    section.addEventListener("click", event => {
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[href^="#offer-"]');
      if (link?.hash === location.hash) openLinkedOffer();
    });
    openLinkedOffer();
  }
</script>

