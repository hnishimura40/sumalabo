<script>
  function setupComparisons() {
    document.querySelectorAll<HTMLElement>('.pc-comparison').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = 'true';
      root.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const link = target.closest<HTMLAnchorElement>('a[data-pc-open]');
        if (link) {
          const detail = document.getElementById(link.hash.slice(1));
          if (detail instanceof HTMLDetailsElement) detail.open = true;
        }
        const filter = target.closest<HTMLButtonElement>('button[data-pc-filter]');
        if (!filter) return;
        const mode = filter.dataset.pcFilter;
        root.querySelectorAll<HTMLButtonElement>('[data-pc-filter]').forEach((button) => button.setAttribute('aria-pressed', String(button === filter)));
        let count = 0;
        root.querySelectorAll<HTMLTableRowElement>('.pc-table tbody tr').forEach((row) => {
          row.hidden = mode === 'eligible' ? row.dataset.status !== 'eligible' : mode === 'held' ? row.dataset.status === 'eligible' : false;
          if (!row.hidden) count++;
        });
        const counter = root.querySelector('[data-pc-count]');
        if (counter) counter.textContent = `${count}製品を表示中`;
      });
    });
  }
  setupComparisons();
  document.addEventListener('astro:page-load', setupComparisons);
</script>

