<script>
  function setupComparisons() {
    document.querySelectorAll<HTMLElement>('.pc-comparison').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = 'true';
      let statusMode = 'all';
      let shortlistMode = false;
      const selected = new Set<string>();
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-pc-tab]')];
      function activateTab(button: HTMLButtonElement) {
        tabs.forEach((tab) => {
          tab.setAttribute('aria-selected', String(tab === button));
          tab.tabIndex = tab === button ? 0 : -1;
          const panel = root.querySelector<HTMLElement>(`#${tab.getAttribute('aria-controls')}`);
          if (panel) panel.hidden = tab !== button;
        });
      }
      if (tabs.length) {
        root.querySelector<HTMLElement>('.pc-tabs')!.hidden = false;
        activateTab(tabs[0]);
      }
      function applyFilters() {
        root.querySelectorAll<HTMLTableRowElement>('tbody tr[data-product-id]').forEach((row) => {
          const statusMatches = statusMode === 'eligible' ? row.dataset.status === 'eligible' : statusMode === 'held' ? row.dataset.status !== 'eligible' : true;
          row.hidden = !statusMatches || (shortlistMode && !selected.has(row.dataset.productId!));
        });
        const counter = root.querySelector('[data-pc-count]');
        const visible = [...root.querySelectorAll<HTMLTableRowElement>('.pc-overview tbody tr')].filter(row => !row.hidden).length;
        if (counter) counter.textContent = `${visible}製品を表示中`;
        const note = root.querySelector('[data-pc-selected-count]');
        if (note) note.textContent = `${selected.size}製品を選択中（最大3）${shortlistMode && visible === 0 ? '／現在の条件に一致する製品なし' : ''}`;
        const selectedButton = root.querySelector<HTMLButtonElement>('[data-pc-shortlist="selected"]');
        if (selectedButton) selectedButton.disabled = selected.size === 0;
        root.querySelectorAll('[data-pc-shortlist]').forEach(button => button.setAttribute('aria-pressed', String((button.getAttribute('data-pc-shortlist') === 'selected') === shortlistMode)));
      }
      root.addEventListener('change', (event) => {
        const input = event.target;
        if (!(input instanceof HTMLInputElement) || !input.dataset.pcSelect) return;
        if (input.checked && selected.size === 3) {
          input.checked = false;
          const note = root.querySelector('[data-pc-selected-count]');
          if (note) note.textContent = '比較は最大3製品です。別の製品を選ぶには先にチェックを外してください。';
          return;
        }
        if (input.checked) selected.add(input.dataset.pcSelect);
        else selected.delete(input.dataset.pcSelect);
        if (!selected.size) shortlistMode = false;
        applyFilters();
      });
      root.addEventListener('keydown', (event) => {
        const target = event.target;
        if (!(event instanceof KeyboardEvent) || !(target instanceof HTMLButtonElement) || !target.dataset.pcTab) return;
        const index = tabs.indexOf(target);
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault(); activateTab(tabs[next]); tabs[next].focus();
      });
      root.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const link = target.closest<HTMLAnchorElement>('a[data-pc-open]');
        if (link) {
          const detail = document.getElementById(link.hash.slice(1));
          if (detail instanceof HTMLDetailsElement) detail.open = true;
        }
        if (target.closest('.pc-cell-sources a')) {
          const sources = root.querySelector<HTMLDetailsElement>('#pc-identity-sources');
          if (sources) sources.open = true;
        }
        const tab = target.closest<HTMLButtonElement>('[data-pc-tab]');
        if (tab) activateTab(tab);
        const shortlist = target.closest<HTMLButtonElement>('[data-pc-shortlist]');
        if (shortlist) {
          shortlistMode = shortlist.dataset.pcShortlist === 'selected';
          statusMode = 'all';
          root.querySelectorAll<HTMLButtonElement>('[data-pc-filter]').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.pcFilter === 'all')));
          applyFilters();
        }
        if (target.closest('[data-pc-clear]')) {
          selected.clear(); shortlistMode = false;
          root.querySelectorAll<HTMLInputElement>('[data-pc-select]').forEach(input => input.checked = false);
          applyFilters();
        }
        const filter = target.closest<HTMLButtonElement>('button[data-pc-filter]');
        if (!filter) return;
        statusMode = filter.dataset.pcFilter || 'all';
        root.querySelectorAll<HTMLButtonElement>('[data-pc-filter]').forEach((button) => button.setAttribute('aria-pressed', String(button === filter)));
        applyFilters();
      });
    });
  }
  setupComparisons();
  document.addEventListener('astro:page-load', setupComparisons);
</script>

