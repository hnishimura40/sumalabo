---
// AffiliateLinks — productId 参照型の購入リンク欄。
// 2026-07-11: リンク生成を src/config/affiliate.ts（ID一元管理）経由に変更。
// data/affiliateLinks.ts には素のモール URL を入れる。アフィリエイト ID が
// 未設定のあいだは通常リンク（rel="noopener"）、設定後は自動で
// もしも経由のアフィリエイトリンク（rel="sponsored"）になる。
import { affiliateLinks, type AffiliateProductId, type AffiliateStore } from "../data/affiliateLinks";
import { buildMallLink, type MallStore } from "../config/affiliate";

interface Props {
  productId: AffiliateProductId;
}

const { productId } = Astro.props;
const links = affiliateLinks[productId];

const stores: Array<{
  key: AffiliateStore;
  label: string;
  pendingLabel: string;
}> = [
  { key: "amazon", label: "Amazonで見る", pendingLabel: "Amazonリンク準備中" },
  { key: "rakuten", label: "楽天で見る", pendingLabel: "楽天リンク準備中" },
  { key: "yahoo", label: "Yahooで見る", pendingLabel: "Yahooリンク準備中" },
  { key: "official", label: "公式で見る", pendingLabel: "公式リンク準備中" },
];

const MALL_STORES: ReadonlyArray<AffiliateStore> = ["amazon", "rakuten", "yahoo"];
---

<div class="affiliate-links" aria-label="購入リンク欄">
  {stores.map((store) => {
    const raw = links[store.key];
    // URL が空の store はボタン自体を出さない（「準備中」表示は廃止・2026-07-19）。
    if (!raw) return null;
    const isMall = MALL_STORES.includes(store.key);
    const built = isMall ? buildMallLink(store.key as MallStore, raw) : { href: raw, affiliate: false };
    return built.href ? (
      <a
        class={`affiliate-button affiliate-button--${store.key}`}
        href={built.href}
        target="_blank"
        rel={built.affiliate ? "nofollow sponsored noopener" : "noopener"}
      >
        {store.label}
      </a>
    ) : null;
  })}
</div>

<style>
  .affiliate-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    border-top: 1px solid var(--line-soft);
    padding-top: 12px;
  }

  .affiliate-button {
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--teal) 38%, var(--line));
    border-radius: 999px;
    background: var(--teal);
    padding: 8px 13px;
    color: #fff;
    font-size: 13px;
    font-weight: 800;
    line-height: 1.35;
    text-decoration: none;
  }

  .affiliate-button--rakuten {
    background: color-mix(in srgb, var(--teal) 84%, var(--mint));
  }

  .affiliate-button--yahoo {
    background: color-mix(in srgb, var(--teal) 72%, var(--fg));
  }

  .affiliate-button--official {
    background: color-mix(in srgb, var(--teal) 62%, var(--slate));
  }

  .affiliate-button--pending {
    border-style: dashed;
    border-color: color-mix(in srgb, var(--fg-soft) 26%, var(--line));
    background: color-mix(in srgb, var(--bg-elev) 88%, var(--bg-tint));
    color: var(--fg-soft);
  }

  @media (max-width: 520px) {
    .affiliate-links {
      flex-direction: column;
    }

    .affiliate-button {
      width: 100%;
    }
  }
</style>
