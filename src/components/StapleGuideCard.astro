---
// D: 一覧に差し込む「定番ガイド」カード。
// ArticleCard と同じグリッドセルに収まる形にしつつ、「定番ガイド」バッジ＋左アクセントで
// 新着ニュースと視覚的に区別する。日付は「更新日」表記のまま（新着と誤認させない）。
import type { StapleCard } from "../lib/staple-cards";
import { listLabel } from "../lib/staple-cards";

interface Props {
  card: StapleCard;
}

const { card } = Astro.props;
---

<a
  class="staple-card"
  href={`/articles/${card.slug}/`}
  data-drainage="list"
  data-drainage-target={card.slug}
>
  <div class="thumbnail">
    {
      card.thumbnail ? (
        <img src={card.thumbnail} alt={card.thumbnailAlt} loading="lazy" />
      ) : (
        <div class="thumbnail-placeholder" aria-hidden="true">
          <span>すまラボ</span>
        </div>
      )
    }
    <span class="staple-badge">{listLabel}</span>
  </div>
  <div class="staple-body">
    <h3>{card.label}</h3>
    <p>{card.blurb}</p>
    <time datetime={card.updated}>更新日: {card.updated}</time>
  </div>
</a>

<style>
  /* 新着ニュースと区別: 左のティールアクセント＋「定番ガイド」バッジ。
     背景も僅かにティール寄りにして「常設の定番」であることを示す。 */
  .staple-card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    min-height: 100%;
    color: var(--color-text);
    text-decoration: none;
    background: color-mix(in srgb, var(--bg-elev) 88%, var(--teal-tint));
    border: 1px solid var(--color-border);
    border-left: 3px solid color-mix(in srgb, var(--teal) 70%, var(--line-strong));
    border-radius: var(--radius-lg);
    transition:
      border-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .staple-card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .thumbnail {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--bg-tint);
    border-bottom: 1px solid var(--line-soft);
  }

  .thumbnail img,
  .thumbnail-placeholder {
    width: 100%;
    height: 100%;
  }

  .thumbnail img {
    object-fit: cover;
  }

  .thumbnail-placeholder {
    display: grid;
    place-items: center;
    color: var(--fg-faint);
    background:
      linear-gradient(135deg, var(--bg-tint), var(--bg-sunk)),
      var(--bg-tint);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .staple-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    display: inline-flex;
    align-items: center;
    padding: 3px 9px;
    border-radius: 999px;
    background: #0f766e;
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }

  .staple-body {
    display: grid;
    gap: 8px;
    padding: 18px 20px 20px;
  }

  h3 {
    margin: 0;
    color: var(--fg);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.5;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  p {
    margin: 0;
    color: var(--color-muted);
    font-size: 13px;
    line-height: 1.65;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  time {
    margin-top: 4px;
    color: var(--fg-faint);
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.02em;
  }
</style>
