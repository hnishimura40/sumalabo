---
import {featured,featuredAxes} from '../data/ai-featured';
---
<section class="featured-section" id="major" aria-labelledby="major-heading">
 <div class="featured-heading"><div><p class="ai-eyebrow">毎日の相棒を選ぶ</p><h2 id="major-heading">まずは、この6つから。</h2></div><a href="#major-compare">機能を横に並べる ↓</a></div>
 <div class="featured-grid">
 {featured.map(p=><article class={`featured-card brand-${p.theme}`} data-featured={p.id}>
  <header><span class="featured-mark" aria-hidden="true">{p.mark}</span><div><h3>{p.name}</h3><small>{p.entry.provider} · {p.entry.country}</small></div></header>
  <h4>{p.lead}</h4><p class="featured-fit">{p.fit}</p>
  <ul class="featured-tags" aria-label={`${p.name}の特徴`}>{p.tags.map(tag=><li>{tag}</li>)}</ul>
  <p class="featured-price">{p.price}</p>
  <p class="featured-tradeoff">{p.tradeoff}</p>
  <a class="featured-detail-link" href={`#major-detail-${p.id}`} data-open-featured={p.id}>機能・料金・日本での条件 <span aria-hidden="true">↗</span></a>
 </article>)}
 </div>
 <p class="featured-note">この6つは、すまラボが入口として取り上げるサービスです。掲載順は性能順位ではありません。選びどころは公式機能をもとにした編集上の整理です。無料枠には上限があり、有料価格は代表例です。通貨・税・全プランは下の詳細へ。</p>
</section>
<section class="featured-comparison" id="major-compare" aria-labelledby="major-compare-heading">
 <p class="ai-eyebrow">同じ項目で見比べる</p><h2 id="major-compare-heading">そのAIで、何ができる？</h2>
 <p class="ai-small-note">使いたい機能から選んでみましょう。「未確認」は非対応という意味ではありません。利用枠・日本での提供条件はサービスごとに異なります。</p>
 <fieldset class="featured-filter"><legend>表示するAI</legend>{featured.map(p=><label><input type="checkbox" value={p.id} checked data-featured-toggle />{p.name}</label>)}<button type="button" id="featured-show-all">6つすべて表示</button></fieldset>
 <p class="featured-scroll-hint" id="featured-table-status" aria-live="polite">6つを表示中。表は左右にスクロールできます。</p>
 <div class="ai-table-wrap featured-table-wrap" tabindex="0" role="region" aria-label="主要6サービスの機能比較表">
 <table class="ai-compare-table featured-table"><caption>主要6サービスの機能・代表料金（2026年11月15日確認）</caption><thead><tr><th scope="col">やりたいこと</th>{featured.map(p=><th scope="col" data-featured-column={p.id}><a href={`#major-detail-${p.id}`} data-open-featured={p.id}>{p.name}</a></th>)}</tr></thead>
 <tbody>{featuredAxes.map((axis,i)=><tr><th scope="row">{axis}</th>{featured.map(p=><td data-featured-column={p.id}>{p.cells[i]}</td>)}</tr>)}<tr><th scope="row">無料・有料の入口</th>{featured.map(p=><td data-featured-column={p.id}>{p.price}<a class="detail-link" href={`#major-detail-${p.id}`} data-open-featured={p.id}>全プラン・条件へ</a></td>)}</tr></tbody></table>
 </div><p id="featured-table-empty" hidden>比べたいAIを1つ以上選ぶか、「6つすべて表示」を押してください。</p>
</section>
<section class="featured-details" id="major-details" aria-labelledby="major-details-heading"><h2 id="major-details-heading">気になるAIを、もう少し詳しく。</h2>
 <p class="ai-small-note">6つともオンラインのサービスです。以下の国は提供組織の拠点で、データの保存先・処理先とは別です。公開モデルや自分のPCで動かす道具は、下の用途別から探せます。</p>
 {featured.map(p=><details class="ai-detail" id={`major-detail-${p.id}`}><summary>{p.name}<span class="featured-summary">{p.lead}</span></summary><div class="ai-detail-body"><dl><dt>できること</dt><dd>{p.entry.distinction}</dd><dt>料金・利用枠</dt><dd>{p.entry.cost}</dd><dt>日本で使う条件</dt><dd>{p.entry.availability}</dd><dt>提供元・国</dt><dd>{p.entry.provider}／{p.entry.country}。{p.entry.countryNote}</dd><dt>選ぶ前の注意</dt><dd>{p.entry.caution}</dd></dl><nav class="ai-related" aria-label={`${p.name}の機能別比較`}>{p.related.map(([label,url])=><a href={url}>{label}の比較</a>)}<a href={p.website} target="_blank" rel="noopener noreferrer">公式サービスへ ↗</a></nav><p class="ai-small-note">一次資料・確認日：{p.entry.checkedAt}</p><div class="ai-source-links">{[...new Map(p.entry.sources.map(s=>[s.url,s])).values()].map(s=><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>)}</div></div></details>)}
</section>
<script>
 const toggles=[...document.querySelectorAll<HTMLInputElement>('[data-featured-toggle]')];
 const updateFeatured=()=>{const selected=new Set(toggles.filter(t=>t.checked).map(t=>t.value));for(const cell of document.querySelectorAll<HTMLElement>('[data-featured-column]'))cell.hidden=!selected.has(cell.dataset.featuredColumn!);document.querySelector<HTMLElement>('.featured-table-wrap')!.hidden=selected.size===0;document.querySelector<HTMLElement>('#featured-table-empty')!.hidden=selected.size>0;document.querySelector('#featured-table-status')!.textContent=selected.size?`${selected.size}つを表示中。表は左右にスクロールできます。`:'表示するAIを選んでください。';};
 toggles.forEach(t=>t.addEventListener('change',updateFeatured));document.querySelector('#featured-show-all')?.addEventListener('click',()=>{toggles.forEach(t=>t.checked=true);updateFeatured();});
 const openFeatured=(id:string)=>{const detail=document.getElementById(`major-detail-${id}`);if(detail instanceof HTMLDetailsElement)detail.open=true;};
 document.querySelectorAll<HTMLElement>('[data-open-featured]').forEach(a=>a.addEventListener('click',()=>openFeatured(a.dataset.openFeatured!)));
 const restoreFeaturedHash=()=>{const match=location.hash.match(/^#major-detail-([a-z]+)$/);if(match)openFeatured(match[1]);};restoreFeaturedHash();window.addEventListener('hashchange',restoreFeaturedHash);
</script>
<style>
 .featured-section,.featured-comparison,.featured-details{scroll-margin-top:100px;margin-top:32px}.featured-heading{display:flex;justify-content:space-between;align-items:end;gap:18px;margin-bottom:22px}.featured-heading h2{margin:0}.featured-heading>a{font-size:13px;white-space:nowrap}.featured-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.featured-card{--brand:#3574c5;display:flex;flex-direction:column;min-width:0;background:var(--bg-elev);border:1px solid var(--line);border-top:3px solid var(--brand);border-radius:12px;padding:22px}.brand-green{--brand:#23846c}.brand-clay{--brand:#b16b4b}.brand-ink{--brand:#737d8d}.brand-violet{--brand:#8472c5}.brand-rose{--brand:#b97197}.featured-card header{display:flex;gap:12px;align-items:center}.featured-mark{display:grid;place-items:center;width:42px;height:42px;flex-shrink:0;background:var(--bg-sunk);color:var(--fg);border:1px solid var(--line);border-radius:10px;font-size:19px;font-weight:800}.featured-card h3{font-size:25px;line-height:1.2;margin:0 0 5px;letter-spacing:-.02em}.featured-card small{font-size:10px;color:var(--fg-mid)}.featured-card h4{font-size:17px;line-height:1.65;margin:20px 0 8px;letter-spacing:-.02em}.featured-card .featured-fit{font-size:13px;color:var(--fg-mid);margin:0;min-height:48px}.featured-tags{display:flex;gap:6px;flex-wrap:wrap;padding:0;list-style:none;margin:16px 0}.featured-tags li{font-size:10px;background:var(--bg-sunk);padding:5px 8px;border-radius:4px;color:var(--fg-mid)}.featured-card .featured-price{font-weight:800;font-size:13px;margin:0 0 10px}.featured-card .featured-tradeoff{font-size:11px;color:var(--fg-mid);margin:0 0 18px}.featured-detail-link{display:flex;justify-content:space-between;gap:8px;font-size:12px;font-weight:700;border-top:1px solid var(--line);padding-top:14px;margin-top:auto;text-decoration:none}.featured-note{font-size:11px;color:var(--fg-mid);margin:16px 0 0}.featured-comparison{padding-top:32px;border-top:1px solid var(--line);margin-top:38px}.featured-filter{display:flex;gap:10px 18px;align-items:center;flex-wrap:wrap;border:0;padding:0;margin:20px 0 12px}.featured-filter legend{font-size:12px;font-weight:700;margin-bottom:10px}.featured-filter label{display:flex;gap:6px;align-items:center;font-size:13px;cursor:pointer}.featured-filter input{width:17px;height:17px;accent-color:var(--teal)}.featured-filter button{font-size:11px;border:1px solid var(--line-strong);border-radius:5px;background:var(--bg-elev);padding:7px 10px;cursor:pointer}.featured-scroll-hint{font-size:11px;color:var(--fg-mid)}.featured-table th,.featured-table td{min-width:137px;max-width:170px;padding:14px;font-size:12px}.featured-table tbody th{position:sticky;left:0;z-index:1;min-width:100px;background:var(--bg-sunk);font-size:11px}.featured-table thead th{white-space:nowrap}.featured-table th[hidden],.featured-table td[hidden],.featured-table-wrap[hidden],#featured-table-empty[hidden]{display:none}.featured-details{margin-top:38px}.featured-details h2{font-size:24px}.featured-summary{font-size:11px;font-weight:400;color:var(--fg-mid);margin-left:18px}.featured-details .ai-detail{scroll-margin-top:100px}
 @media(max-width:900px){.featured-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
 @media(max-width:580px){.featured-grid{grid-template-columns:1fr;gap:14px}.featured-card{padding:20px}.featured-card .featured-fit{min-height:0}.featured-heading{display:block}.featured-heading>a{display:inline-block;margin-top:12px}.featured-card h4{margin-top:16px}.featured-card h3{font-size:24px}.featured-summary{display:block;margin:7px 0 0 18px}.featured-table td{min-width:145px}.featured-table tbody th{min-width:84px}.featured-filter{gap:12px 16px}.featured-details h2{font-size:22px}}
</style>
