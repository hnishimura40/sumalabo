---
import AiServiceLogo from './AiServiceLogo.astro';
import {featured} from '../data/ai-featured';
import {capabilityLabels,capabilityNames,negativeEvidence} from '../data/ai-featured-guide';
import {featuredPricingCheckedAt} from '../data/ai-featured-pricing';
import AiStrengthStories from './AiStrengthStories.astro';
import AiModelsAndBenchmarks from './AiModelsAndBenchmarks.astro';
import AiTypeGuide from './AiTypeGuide.astro';
import {comparisonPlans,planCapabilities,planCapabilityAxes,planCapabilitiesCheckedAt} from '../data/ai-plan-capabilities';
---
<section class="featured-section" id="major" aria-labelledby="major-heading">
 <div class="featured-heading"><div><p class="ai-eyebrow">毎日の相棒を選ぶ</p><h2 id="major-heading">まずは、この6つから。</h2></div><a href="#major-compare">機能を横に並べる ↓</a></div>
 <div class="featured-grid">
 {featured.map(p=><article class={`featured-card brand-${p.theme}`} data-featured={p.id}>
  <header><AiServiceLogo id={p.id} size={52} /><div><h3>{p.name}</h3><small>{p.entry.provider} · {p.entry.country}</small></div></header>
  <h4>{p.lead}</h4><p class="featured-fit">{p.fit}</p>
  <ul class="featured-tags" aria-label={`${p.name}の特徴`}>{p.tags.map(tag=><li>{tag}</li>)}</ul>
  <dl class="featured-plans"><div data-free-summary={p.id}><dt>無料でできること</dt><dd>{p.pricing.free}</dd></div><div data-paid-summary={p.id}><dt>有料で増えること</dt><dd>{p.pricing.paid}</dd></div></dl><p class="featured-price">有料の例：{p.pricing.example}</p>
  <p class="featured-tradeoff">{p.tradeoff}</p>
  <a class="featured-story-link" href="#strengths" data-show-strength={p.id}>ひまりと強みを見る →</a>
  <a class="featured-detail-link" href={`#major-detail-${p.id}`} data-open-featured={p.id}>機能・料金・日本での条件 <span aria-hidden="true">↗</span></a>
 </article>)}
 </div>
 <p class="featured-note">この6つは、すまラボが入口として取り上げるサービスです。掲載順は性能順位ではありません。選びどころは公式機能をもとにした編集上の整理です。主要6サービスの料金・無料枠は{featuredPricingCheckedAt}確認。無料枠には上限があり、有料価格は代表例です。通貨・税・契約条件は下の詳細へ。</p>
</section>
<AiTypeGuide />
<AiStrengthStories />
<section class="featured-comparison" id="major-compare" aria-labelledby="major-compare-heading">
 <p class="ai-eyebrow">無料と有料を分けて見比べる</p><h2 id="major-compare-heading">まず無料で。必要になったら、有料へ。</h2>
 <nav class="plan-jumps" aria-label="無料・有料の比較表へ">{comparisonPlans.map(plan=><a href={`#compare-${plan.id}`}>{plan.label} ↓</a>)}</nav>
 <p class="ai-small-note">○＝その表の無料枠・対象有料プランで対応、△＝地域・段階提供などの条件付き、×＝その表の対象プランでは非対応。○でも使用量の上限があります。日本の個人利用を基本に、地域限定は明記。外部アプリ・API・コードでの代替制作は含めません。無料・有料の提供範囲は{planCapabilitiesCheckedAt}確認。</p>
 <fieldset class="featured-filter"><legend>表示するAI</legend>{featured.map(p=><label><input type="checkbox" value={p.id} checked data-featured-toggle /><AiServiceLogo id={p.id} size={22} />{p.name}</label>)}<button type="button" id="featured-show-all">6つすべて表示</button></fieldset>
 <p class="featured-scroll-hint" id="featured-table-status" aria-live="polite">6つを表示中。表は左右にスクロールできます。</p>
 {comparisonPlans.map(plan=><section class={`plan-comparison plan-${plan.id}`} id={`compare-${plan.id}`} aria-labelledby={`compare-${plan.id}-heading`}>
  <div class="plan-heading"><span class="plan-label">{plan.id==='free'?'FREE · 月額0円':'PAID · 必要な機能を追加'}</span><h3 id={`compare-${plan.id}-heading`}>{plan.title}</h3><p>{plan.intro}</p></div>
  <div class="ai-table-wrap ai-plain-table-wrap featured-table-wrap" tabindex="0" role="region" aria-label={`主要6サービス・${plan.label}機能表`}>
   <table class="ai-compare-table ai-plain-table featured-table" data-plan-table={plan.id}><caption>主要6サービス・{plan.label}（提供範囲：{planCapabilitiesCheckedAt}）</caption>
    <thead><tr><th scope="col">やりたいこと</th>{featured.map(p=><th scope="col" data-featured-column={p.id}><a href={`#major-detail-${p.id}`} data-open-featured={p.id}><AiServiceLogo id={p.id} size={26} /> {p.name}</a></th>)}</tr></thead>
    <tbody><tr class="plan-price-row"><th scope="row">{plan.id==='free'?'月額料金・利用枠':'有料プランの価格例'}</th>{featured.map(p=><td data-featured-column={p.id}><strong>{plan.id==='free'?'月額0円':p.pricing.example}</strong><small>{plan.id==='free'?'使用量に上限あり。回復条件はサービス別。':'全機能込みの価格ではありません。下の対象プランも確認。'}</small><a href={p.pricing.source} target="_blank" rel="noopener noreferrer">公式の料金・条件 ↗</a></td>)}</tr>
    {planCapabilityAxes.map(axis=><tr data-capability={axis.key}><th scope="row"><span>{axis.label}</span><small class="capability-scope">{axis.scope}</small></th>{featured.map(p=>{const c=planCapabilities[plan.id][p.id][axis.key];return <td data-featured-column={p.id} data-capability-status={c.status}><span class={`capability-symbol capability-${c.status}`} aria-label={capabilityNames[c.status]}>{capabilityLabels[c.status]}</span><a class="capability-description" href={c.source} target="_blank" rel="noopener noreferrer">{c.text} ↗</a></td>;})}</tr>)}</tbody>
   </table>
  </div>
 </section>)}
 <p id="featured-table-empty" hidden>比べたいAIを1つ以上選ぶか、「6つすべて表示」を押してください。</p>
</section>
<section class="featured-details" id="major-details" aria-labelledby="major-details-heading"><h2 id="major-details-heading">気になるAIを、もう少し詳しく。</h2>
 <p class="ai-small-note">6つともオンラインのサービスです。以下の国は提供組織の拠点で、データの保存先・処理先とは別です。公開モデルや自分のPCで動かす道具は、下の用途別から探せます。</p>
 {featured.map(p=><details class="ai-detail" id={`major-detail-${p.id}`}><summary><AiServiceLogo id={p.id} size={28} /> {p.name}<span class="featured-summary">{p.lead}</span></summary><div class="ai-detail-body"><dl><dt>できること</dt><dd>{p.entry.distinction}</dd><dt>無料と有料</dt><dd>{p.pricing.free}<br />{p.pricing.paid}<br /><a href={p.pricing.source} target="_blank" rel="noopener noreferrer">料金・無料枠の公式説明 ↗</a>（{featuredPricingCheckedAt}確認）</dd><dt>料金・利用枠</dt><dd>{p.entry.cost}</dd><dt>日本で使う条件</dt><dd>{p.entry.availability}</dd><dt>提供元・国</dt><dd>{p.entry.provider}／{p.entry.country}。{p.entry.countryNote}</dd><dt>選ぶ前の注意</dt><dd>{p.entry.caution}</dd></dl><details class="capability-rationale"><summary>×の対象プランと判定根拠</summary><ul>{comparisonPlans.flatMap(plan=>planCapabilityAxes.filter(axis=>planCapabilities[plan.id][p.id][axis.key].status==='no').map(axis=>{const c=planCapabilities[plan.id][p.id][axis.key];const e=negativeEvidence[p.id+'.'+axis.key];return <li><strong>× {plan.label}：{axis.label}</strong><p>{e?`${e.basis}：${e.reason}`:`対象プランの公式説明：${c.text}`}</p><a href={c.source} target="_blank" rel="noopener noreferrer">公式の説明・一覧 ↗</a></li>;}))}</ul>{!comparisonPlans.some(plan=>planCapabilityAxes.some(axis=>planCapabilities[plan.id][p.id][axis.key].status==='no'))&&<p>無料・有料の両表に×の項目はありません。○・△にもプランや利用枠の条件があります。</p>}</details><nav class="ai-related" aria-label={`${p.name}の機能別比較`}>{p.related.map(([label,url])=><a href={url}>{label}の比較</a>)}<a href={p.website} target="_blank" rel="noopener noreferrer">公式サービスへ ↗</a></nav><p class="ai-small-note">一次資料・確認日：{p.entry.checkedAt}</p><div class="ai-source-links">{[...new Map(p.entry.sources.map(s=>[s.url,s])).values()].map(s=><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>)}</div></div></details>)}
</section>
<details class="featured-advanced" id="advanced-models"><summary>もっと詳しく：モデル・ベンチマークを見る<span>モデル名や性能の数字から選びたい方へ</span></summary><AiModelsAndBenchmarks /><p class="ai-small-note"><a href="/ai/tests/">既存の文章課題の参考記録・原データを見る →</a></p></details>
<script>
 const advanced=document.querySelector<HTMLDetailsElement>('#advanced-models');
 const advancedHashes=new Set(['#major-models','#major-benchmarks']);
 const revealAdvanced=()=>{if(advanced&&advancedHashes.has(location.hash)){advanced.open=true;requestAnimationFrame(()=>document.getElementById(location.hash.slice(1))?.scrollIntoView());}};
 document.querySelectorAll<HTMLAnchorElement>('a[href="#major-models"],a[href="#major-benchmarks"]').forEach(a=>a.addEventListener('click',()=>{if(advanced)advanced.open=true;}));
 window.addEventListener('hashchange',revealAdvanced);revealAdvanced();
 const toggles=[...document.querySelectorAll<HTMLInputElement>('[data-featured-toggle]')];
 const updateFeatured=()=>{const selected=new Set(toggles.filter(t=>t.checked).map(t=>t.value));for(const cell of document.querySelectorAll<HTMLElement>('[data-featured-column]'))cell.hidden=!selected.has(cell.dataset.featuredColumn!);for(const wrap of document.querySelectorAll<HTMLElement>('.featured-table-wrap'))wrap.hidden=selected.size===0;document.querySelector<HTMLElement>('#featured-table-empty')!.hidden=selected.size>0;document.querySelector('#featured-table-status')!.textContent=selected.size?`${selected.size}つを表示中。無料・有料の両方の表に反映します。表は左右にスクロールできます。`:'表示するAIを選んでください。';};
 toggles.forEach(t=>t.addEventListener('change',updateFeatured));document.querySelector('#featured-show-all')?.addEventListener('click',()=>{toggles.forEach(t=>t.checked=true);updateFeatured();});
 const openFeatured=(id:string)=>{const detail=document.getElementById(`major-detail-${id}`);if(detail instanceof HTMLDetailsElement)detail.open=true;};
 document.querySelectorAll<HTMLElement>('[data-open-featured]').forEach(a=>a.addEventListener('click',()=>openFeatured(a.dataset.openFeatured!)));
 const restoreFeaturedHash=()=>{const match=location.hash.match(/^#major-detail-([a-z]+)$/);if(match)openFeatured(match[1]);};restoreFeaturedHash();window.addEventListener('hashchange',restoreFeaturedHash);
</script>
<style>
 .plan-jumps{display:flex;gap:12px;flex-wrap:wrap;margin:20px 0}.plan-jumps a{padding:10px 18px;border:1px solid var(--line-strong);border-radius:7px;background:var(--bg-elev);font-size:13px;font-weight:800;text-decoration:none}.plan-comparison{scroll-margin-top:100px;margin-top:30px}.plan-heading{padding:20px;border:1px solid var(--line);border-left:4px solid var(--teal);border-radius:9px;background:var(--bg-elev);margin-bottom:16px}.plan-label{font-size:11px;letter-spacing:.08em;color:var(--teal-deep);font-weight:800}.plan-heading h3{font-size:23px;line-height:1.5;margin:9px 0}.plan-heading p{font-size:13px;line-height:1.9;color:var(--fg-mid);margin:0}.plan-price-row strong{display:block;font-size:13px;line-height:1.8}.plan-price-row small{display:block;font-size:10px;line-height:1.8;margin:8px 0;color:var(--fg-mid)}.plan-price-row a{font-size:10px}.featured-table caption{text-align:left;padding:8px 0 14px;font-size:12px;color:var(--fg-mid)}
 .featured-plans{margin:0 0 14px;font-size:12px}.featured-plans>div{margin:0 0 12px}.featured-plans dt{font-size:10px;font-weight:800;color:var(--teal-deep);margin-bottom:5px}.featured-plans dd{margin:0;line-height:1.8;color:var(--fg-mid)}.featured-advanced{margin-top:34px;padding:18px 22px;border:1px solid var(--line);border-radius:10px;background:var(--bg-elev);scroll-margin-top:100px}.featured-advanced>summary{cursor:pointer;font-size:16px;font-weight:800}.featured-advanced>summary span{display:block;font-size:12px;font-weight:400;color:var(--fg-mid);margin:8px 0 0 18px}.capability-rationale{font-size:12px;margin:18px 0}.capability-rationale summary{font-size:13px;padding:10px 0}.capability-rationale ul{padding-left:18px}.capability-rationale li{margin:12px 0}.capability-rationale p{margin:5px 0}
 .featured-story-link{font-size:12px;font-weight:700;margin:0 0 14px;text-decoration:none}.capability-symbol{display:block;font-weight:900;font-size:25px;line-height:1.3;margin-bottom:8px}.capability-yes{color:var(--teal-deep)}.capability-limited{color:var(--fg)}.capability-no{color:var(--fg-mid)}.capability-description{font-size:11px;text-decoration:none;line-height:1.8;display:block}.capability-description:hover{text-decoration:underline}.capability-scope{display:block;max-width:135px;font-size:9px;line-height:1.65;color:var(--fg-mid);font-weight:400;margin-top:8px}
 .featured-section,.featured-comparison,.featured-details{scroll-margin-top:100px;margin-top:32px}.featured-heading{display:flex;justify-content:space-between;align-items:end;gap:18px;margin-bottom:22px}.featured-heading h2{margin:0}.featured-heading>a{font-size:13px;white-space:nowrap}.featured-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.featured-card{--brand:#3574c5;display:flex;flex-direction:column;min-width:0;background:var(--bg-elev);border:1px solid var(--line);border-top:3px solid var(--brand);border-radius:12px;padding:22px}.brand-green{--brand:#23846c}.brand-clay{--brand:#b16b4b}.brand-ink{--brand:#737d8d}.brand-violet{--brand:#8472c5}.brand-rose{--brand:#b97197}.featured-card header{display:flex;gap:12px;align-items:center}.featured-card h3{font-size:25px;line-height:1.2;margin:0 0 5px;letter-spacing:-.02em}.featured-card small{font-size:10px;color:var(--fg-mid)}.featured-card h4{font-size:17px;line-height:1.65;margin:20px 0 8px;letter-spacing:-.02em}.featured-card .featured-fit{font-size:13px;color:var(--fg-mid);margin:0;min-height:48px}.featured-tags{display:flex;gap:6px;flex-wrap:wrap;padding:0;list-style:none;margin:16px 0}.featured-tags li{font-size:10px;background:var(--bg-sunk);padding:5px 8px;border-radius:4px;color:var(--fg-mid)}.featured-card .featured-price{font-weight:800;font-size:13px;margin:0 0 10px}.featured-card .featured-tradeoff{font-size:11px;color:var(--fg-mid);margin:0 0 18px}.featured-detail-link{display:flex;justify-content:space-between;gap:8px;font-size:12px;font-weight:700;border-top:1px solid var(--line);padding-top:14px;margin-top:auto;text-decoration:none}.featured-note{font-size:11px;color:var(--fg-mid);margin:16px 0 0}.featured-comparison{padding-top:32px;border-top:1px solid var(--line);margin-top:38px}.featured-filter{display:flex;gap:10px 18px;align-items:center;flex-wrap:wrap;border:0;padding:0;margin:20px 0 12px}.featured-filter legend{font-size:12px;font-weight:700;margin-bottom:10px}.featured-filter label{display:flex;gap:6px;align-items:center;font-size:13px;cursor:pointer}.featured-filter input{width:17px;height:17px;accent-color:var(--teal)}.featured-filter button{font-size:11px;border:1px solid var(--line-strong);border-radius:5px;background:var(--bg-elev);padding:7px 10px;cursor:pointer}.featured-scroll-hint{font-size:11px;color:var(--fg-mid)}.featured-table th,.featured-table td{min-width:137px;max-width:170px;padding:14px;font-size:12px}.featured-table tbody th{position:static;min-width:100px;background:transparent;font-size:11px}.featured-table thead th{white-space:nowrap}.featured-table th[hidden],.featured-table td[hidden],.featured-table-wrap[hidden],#featured-table-empty[hidden]{display:none}.featured-details{margin-top:38px}.featured-details h2{font-size:24px}.featured-summary{font-size:11px;font-weight:400;color:var(--fg-mid);margin-left:18px}.featured-details .ai-detail{scroll-margin-top:100px}
 @media(max-width:900px){.featured-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
 @media(max-width:580px){.featured-grid{grid-template-columns:1fr;gap:14px}.featured-card{padding:20px}.featured-card .featured-fit{min-height:0}.featured-heading{display:block}.featured-heading>a{display:inline-block;margin-top:12px}.featured-card h4{margin-top:16px}.featured-card h3{font-size:24px}.featured-summary{display:block;margin:7px 0 0 18px}.featured-table td{min-width:145px}.featured-table tbody th{min-width:84px}.featured-filter{gap:12px 16px}.featured-details h2{font-size:22px}}
</style>
