---
// 検品用の強制更新（Pull-to-Refresh）。読者向け機能ではなく、デプロイ後確認用。
//
// 背景（2026-07-20 調査）:
//   - sw.js は fetch ハンドラを持たず、ページのキャッシュはしていない（push専用）。
//   - HTML は Cache-Control: max-age=0, must-revalidate / cf-cache-status: DYNAMIC
//     ＝エッジもブラウザも HTML は毎回取り直す。
//   - よって「更新が見えない」真因はキャッシュではなく、**standalone(PWA)が再ナビゲート
//     しないこと**。アプリを再起動するまで最後に読み込んだページが残り続ける。
//   - ただし画像は `max-age=14400`（4時間）。同じパスに再生成した画像を差し替えても、
//     通常リロードではブラウザHTTPキャッシュから旧画像が出る＝検品には不十分。
//   → 対策: 再ナビゲート(reload) に加えて、**画像を cache:'reload' で取り直してから**
//     リロードする。エッジは deploy 側の cache purge 完了を前提にし、URL にキャッシュ
//     バスターは付けない（URL/計測を汚さないため）。
//
// 露出は控えめ: 既定では standalone(PWA=Hiroの検品環境)でのみ有効。
// 通常のブラウザ読者には何も変わらない（ネイティブのPTRとリロードボタンがあるため）。
// 動作確認用に ?ptr=1 または localStorage['sumalabo-ptr']='1' で有効化できる。
---

<div id="force-refresh-ind" class="force-refresh" hidden aria-hidden="true">
  <span class="force-refresh__text">更新中…</span>
</div>

<button id="update-banner" class="update-banner" type="button" hidden>
  新しい版があります（タップで更新）
</button>

<script>
  (() => {
    const IND_ID = "force-refresh-ind";
    const THRESHOLD = 70; // これ以上引いたら発動
    const MAX_PULL = 110;

    function enabled() {
      try {
        if (new URLSearchParams(location.search).has("ptr")) return true;
        if (localStorage.getItem("sumalabo-ptr") === "1") return true;
      } catch {
        /* ignore */
      }
      // 既定は PWA(standalone) のみ＝検品環境限定
      return (
        window.matchMedia?.("(display-mode: standalone)").matches ||
        (window.navigator as any).standalone === true
      );
    }

    if (!enabled()) return;

    const ind = document.getElementById(IND_ID);
    if (!ind) return;

    // ネイティブの pull-to-refresh を抑止して二重発動を防ぐ（縦のオーバースクロールのみ）
    document.documentElement.style.overscrollBehaviorY = "contain";

    let startY = 0;
    let dy = 0;
    let armed = false;
    let pulling = false;
    let running = false;

    function lightboxOpen() {
      const lb = document.getElementById("article-lightbox");
      return !!lb && (lb.classList.contains("open") || !lb.hasAttribute("hidden"));
    }

    function show(text: string) {
      ind!.querySelector(".force-refresh__text")!.textContent = text;
      ind!.hidden = false;
      ind!.style.transform = "translateY(0)";
      ind!.style.opacity = "1";
    }

    function hide() {
      ind!.hidden = true;
      ind!.style.transform = "";
      ind!.style.opacity = "";
    }

    function reset() {
      armed = false;
      pulling = false;
      dy = 0;
      if (!running) hide();
    }

    async function forceRefresh() {
      if (running) return; // 二重発動ガード
      running = true;
      show("更新中…");
      try {
        // 1. Service Worker のキャッシュを破棄（現状 sw.js は未使用だが将来の保険）
        if (window.caches?.keys) {
          const keys = await caches.keys();
          await Promise.all(keys.map((k) => caches.delete(k)));
        }
        // 2. SW 自体の更新を促す
        if (navigator.serviceWorker?.getRegistration) {
          const reg = await navigator.serviceWorker.getRegistration();
          await reg?.update().catch(() => {});
        }
        // 3. HTML と画像を HTTP キャッシュをバイパスして取り直す。
        //    画像は max-age=14400 のため、これをやらないと通常リロードでは旧画像が出る。
        const urls = new Set<string>([location.href]);
        document.querySelectorAll("img[src]").forEach((el) => {
          const src = (el as HTMLImageElement).currentSrc || (el as HTMLImageElement).src;
          if (src && src.startsWith(location.origin)) urls.add(src);
        });
        await Promise.all(
          [...urls].map((u) =>
            fetch(u, { cache: "reload", credentials: "same-origin" }).catch(() => {}),
          ),
        );
      } catch {
        /* 失敗してもリロードは行う */
      }
      // 4. 取り直した内容でリロード
      location.reload();
    }

    window.addEventListener(
      "touchstart",
      (e) => {
        if (running) return;
        if (e.touches.length !== 1) return; // ピンチズーム等は無視
        if (window.scrollY > 0) return; // 最上部でのみ
        if (lightboxOpen()) return; // 画像ズーム中は無視
        startY = e.touches[0].clientY;
        dy = 0;
        armed = true;
        pulling = false;
      },
      { passive: true },
    );

    window.addEventListener(
      "touchmove",
      (e) => {
        if (!armed || running) return;
        if (e.touches.length !== 1 || window.scrollY > 0 || lightboxOpen()) {
          reset();
          return;
        }
        dy = e.touches[0].clientY - startY;
        if (dy <= 0) {
          // 上方向＝通常スクロールなので手を出さない
          reset();
          return;
        }
        pulling = true;
        // 引いている間はネイティブのスクロール/PTRを止める
        if (e.cancelable) e.preventDefault();
        const p = Math.min(dy, MAX_PULL);
        ind!.hidden = false;
        ind!.style.transform = `translateY(${Math.min(p / 2, 40)}px)`;
        ind!.style.opacity = String(Math.min(p / THRESHOLD, 1));
        ind!.querySelector(".force-refresh__text")!.textContent =
          dy > THRESHOLD ? "離すと更新" : "引いて更新";
      },
      { passive: false },
    );

    window.addEventListener(
      "touchend",
      () => {
        if (running) return;
        if (pulling && dy > THRESHOLD) {
          forceRefresh();
        } else {
          reset();
        }
      },
      { passive: true },
    );

    window.addEventListener("touchcancel", reset, { passive: true });

    // ── 新デプロイ検知バナー ───────────────────────────────────────────
    // /version.json のビルドIDと、このページに焼かれた <meta name="sumalabo-build">
    // を比較し、違えば「新しい版があります」を出して、タップで上の forceRefresh() を呼ぶ。
    const PAGE_LOADED_AT = Date.now();
    const MIN_PAGE_AGE_MS = 60_000; // 読み込み直後は判定しない（deploy伝播レース対策）
    const MIN_INTERVAL_MS = 30_000; // 連続チェックの間引き
    const CONFIRM_DELAY_MS = 10_000; // 差分を検知したら再確認してから出す（エッジ不整合対策）

    const banner = document.getElementById("update-banner") as HTMLButtonElement | null;
    const currentBuild =
      document.querySelector<HTMLMetaElement>('meta[name="sumalabo-build"]')?.content || "";

    let lastCheck = 0;
    let checking = false;
    let bannerShown = false;

    async function fetchBuildId(): Promise<string> {
      try {
        const res = await fetch("/version.json", {
          cache: "no-store",
          credentials: "same-origin",
        });
        if (!res.ok) return "";
        const json = await res.json();
        return json?.buildId || "";
      } catch {
        return "";
      }
    }

    async function checkForUpdate() {
      if (!banner || !currentBuild || bannerShown || checking || running) return;
      // 伝播レース猶予: 開いた直後は判定しない
      if (Date.now() - PAGE_LOADED_AT < MIN_PAGE_AGE_MS) return;
      if (Date.now() - lastCheck < MIN_INTERVAL_MS) return;
      lastCheck = Date.now();
      checking = true;
      try {
        const first = await fetchBuildId();
        if (!first || first === currentBuild) return;
        // 伝播途中でエッジごとに版が揺れている可能性があるため、間をおいて再確認。
        // 同じ新IDが2回続けて返ったときだけ「本当に新版が出た」と判定する。
        await new Promise((r) => setTimeout(r, CONFIRM_DELAY_MS));
        const second = await fetchBuildId();
        if (second && second === first && second !== currentBuild) {
          bannerShown = true;
          banner.hidden = false;
        }
      } finally {
        checking = false;
      }
    }

    banner?.addEventListener("click", () => {
      banner.hidden = true;
      forceRefresh();
    });

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) checkForUpdate();
    });
    window.addEventListener("focus", checkForUpdate);
  })();
</script>

<style>
  .force-refresh {
    position: fixed;
    top: 8px;
    left: 50%;
    z-index: 3000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-elev);
    box-shadow: var(--shadow-md);
    color: var(--fg-soft);
    font-size: 12px;
    font-weight: 700;
    transform: translateY(-8px);
    opacity: 0;
    transition:
      transform 120ms ease,
      opacity 120ms ease;
    translate: -50% 0;
    pointer-events: none;
  }

  /* 新デプロイ検知バナー。読者が見ても違和感のない控えめな通知トーンにする
     （広告・警告色にしない。下部中央の小さなピル）。 */
  .update-banner {
    position: fixed;
    bottom: calc(12px + env(safe-area-inset-bottom, 0px));
    left: 50%;
    z-index: 3000;
    translate: -50% 0;
    max-width: calc(100vw - 32px);
    padding: 9px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-elev);
    box-shadow: var(--shadow-md);
    color: var(--fg);
    font-size: 12.5px;
    font-weight: 700;
    line-height: 1.4;
    cursor: pointer;
    animation: update-banner-in 160ms ease-out;
  }

  .update-banner:active {
    transform: scale(0.98);
  }

  @keyframes update-banner-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
