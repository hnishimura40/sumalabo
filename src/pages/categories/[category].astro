---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import StapleGuideCard from "../../components/StapleGuideCard.astro";
import CategoryNav from "../../components/CategoryNav.astro";
import { categories, getCategoryBySlug } from "../../lib/categories";
import { isListableArticle, sortArticles } from "../../lib/articles";
import { buildStapleCards, interleaveStaples } from "../../lib/staple-cards";
import { buildBreadcrumbSchema } from "../../lib/structured-data";

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const all = await getCollection("articles");
const articles = all
  .filter(isListableArticle)
  .filter((article) => article.data.category === category.name)
  .sort(sortArticles);

// D: 定番ガイドを差し込む。ただしこのカテゴリに既に並んでいる収益記事は重複回避で除外。
const staples = buildStapleCards(all).filter(
  (s) => !articles.some((a) => a.data.slug === s.slug),
);
const items = interleaveStaples(articles, staples);

const currentCategory = getCategoryBySlug(category.slug) ?? category;

// パンくず構造化データ（2026-07-25 追加）。ホーム → カテゴリ。
const breadcrumbSchema = buildBreadcrumbSchema([{ name: currentCategory.name }]);
---

<BaseLayout
  title={currentCategory.name}
  description={currentCategory.description}
  canonicalPath={`/categories/${currentCategory.slug}/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <section class="page-shell">
    <header class="category-header">
      <div>
        <a class="back-link" href="/articles/">記事一覧へ</a>
        <p class="eyebrow">Category</p>
        <h1>{currentCategory.name}</h1>
        <p>{currentCategory.description}</p>
      </div>
      <span>{currentCategory.slug}</span>
    </header>

    {
      articles.length > 0 ? (
        <section class="article-section" aria-labelledby="category-articles-title">
          <div class="section-heading">
            <p class="eyebrow">Articles</p>
            <h2 id="category-articles-title">このカテゴリの記事</h2>
          </div>
          <div class="article-grid">
            {
              items.map((item) =>
                item.kind === "article" ? (
                  <ArticleCard article={item.entry.data} />
                ) : (
                  <StapleGuideCard card={item.card} />
                ),
              )
            }
          </div>
        </section>
      ) : (
        <div class="empty-state">
          <span>Preparing</span>
          <strong>このカテゴリの記事はまだ準備中です。</strong>
          <p>
            公開準備ができた記事から、このページに自動で表示されます。先に記事一覧や他カテゴリも確認できます。
          </p>
          <div class="empty-actions">
            <a href="/articles/">記事一覧を見る</a>
            <a href="/categories/mobile-plan/">通信費カテゴリを見る</a>
          </div>
        </div>
      )
    }

    <CategoryNav
      activeSlug={currentCategory.slug}
      title="ほかのカテゴリも見る"
      text="すまラボでは、ニュース、実体験・検証、スマホ選び、通信費、周辺機器を分けて整理しています。"
    />
  </section>
</BaseLayout>

<style>
  .category-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 20px;
    align-items: end;
    margin-bottom: 30px;
    padding: clamp(24px, 5vw, 38px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, var(--teal-tint), transparent 60%),
      var(--bg-elev);
    box-shadow: var(--shadow-sm);
  }

  .back-link {
    display: inline-block;
    margin-bottom: 14px;
    color: var(--fg-mid);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--teal);
  }

  .eyebrow {
    margin: 0 0 8px;
    color: var(--teal);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--fg);
    font-size: clamp(32px, 7vw, 52px);
    line-height: 1.2;
    letter-spacing: 0;
  }

  .category-header p:last-child {
    max-width: 720px;
    margin: 14px 0 0;
    color: var(--fg-soft);
    font-size: 16px;
    line-height: 1.8;
  }

  .category-header > span {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 5px 10px;
    color: var(--fg-mid);
    background: var(--bg-sunk);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .article-section {
    margin-top: 34px;
  }

  .section-heading {
    display: grid;
    gap: 6px;
    margin-bottom: 16px;
  }

  h2 {
    margin: 0;
    color: var(--fg);
    font-size: clamp(24px, 4vw, 32px);
    line-height: 1.35;
    letter-spacing: 0;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
  }

  .empty-state {
    display: grid;
    gap: 8px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
    box-shadow: var(--shadow-sm);
  }

  .empty-state span {
    width: fit-content;
    border-radius: 999px;
    padding: 3px 8px;
    color: var(--fg-mid);
    background: var(--bg-sunk);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .empty-state p {
    max-width: 680px;
    margin: 0;
    color: var(--fg-soft);
    line-height: 1.7;
  }

  .empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }

  .empty-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 7px 12px;
    background: var(--bg-sunk);
    color: var(--fg);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }

  .empty-actions a:first-child {
    background: var(--teal);
    color: #ffffff;
    border-color: var(--teal);
  }

  @media (max-width: 640px) {
    .category-header {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .category-header > span {
      width: fit-content;
    }
  }
</style>
