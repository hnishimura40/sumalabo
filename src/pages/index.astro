---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { siteConfig } from "../config/site";

const sorted = (await import("../lib/articles")).getSortedVisibleArticles(
  await getCollection("articles"),
);
// ヒーロー = 最新1本、新着グリッド = その次から
const [lead, ...restAll] = sorted;
const rest = restAll.slice(0, 6);

// ヒーローの「30秒サマリー先頭1行」は description の1文目を使う
// （既存記事は Summary30 未搭載のため description を代用。先頭の句点まで）
function firstLine(text) {
  const t = (text || "").trim();
  const cut = t.search(/[。！？]/);
  return cut >= 0 ? t.slice(0, cut + 1) : t;
}
const leadSummary = lead ? firstLine(lead.data.description) : "";

// トップのカテゴリ枠（流入最優先: ニュース筆頭 / 通信費は枠から外す。ページ自体は残す）
const homeCategories = [
  {
    slug: "news",
    name: "ニュースをかみくだく",
    description: "AI・スマホ・ガジェットのニュースを、やさしく整理します。",
  },
  {
    slug: "hands-on",
    name: "やってみた・検証",
    description: "実際に使って・試して分かったことを、体験ベースで整理します。",
  },
  {
    slug: "smartphone",
    name: "スマホの選び方",
    description: "iPhone・Android・中古など、選び方で迷う点を整理します。",
  },
  {
    slug: "gadgets",
    name: "周辺機器・ガジェット",
    description: "充電器・モバイルバッテリー・周辺機器の選び方を整理します。",
  },
];

// JSON-LD WebSite schema（M3 SEO基盤）
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.siteName,
  url: siteConfig.siteUrl,
  description: siteConfig.siteDescription,
  publisher: { "@type": "Organization", name: siteConfig.siteName, url: siteConfig.siteUrl },
  inLanguage: "ja",
};
---

<BaseLayout canonicalPath="/">
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <section class="page-shell">
    <h1 class="sr-only">すまラボ — スマホ・AI・ガジェットをやさしく整理</h1>

    {/* ===== ヒーロー: 最新記事の大型カード ===== */}
    {
      lead && (
        <section class="lead-hero" aria-label="最新記事">
          <a class="lead-card" href={`/articles/${lead.data.slug}/`}>
            <div class="lead-media">
              {lead.data.thumbnail ? (
                <img
                  src={lead.data.thumbnail}
                  alt={lead.data.thumbnailAlt || ""}
                  width="1280"
                  height="720"
                  fetchpriority="high"
                  decoding="async"
                />
              ) : (
                <div class="lead-media-placeholder" aria-hidden="true">
                  すまラボ
                </div>
              )}
            </div>
            <div class="lead-body">
              <span class="lead-eyebrow">最新記事</span>
              <h2 class="lead-title">{lead.data.title}</h2>
              {leadSummary && <p class="lead-summary">{leadSummary}</p>}
              <span class="lead-cta">この記事を読む →</span>
            </div>
          </a>
        </section>
      )
    }

    {/* ===== クイックカテゴリ: ニュース筆頭・3枚（通信費/eSIM固定枠は撤去） ===== */}
    <nav class="quick-cats" aria-label="主要カテゴリ">
      {
        homeCategories.map((c) => (
          <a class="quick-cat" href={`/categories/${c.slug}/`}>
            <span class="quick-cat-name">{c.name}</span>
          </a>
        ))
      }
      <a class="quick-cat quick-cat--all" href="/articles/">
        <span class="quick-cat-name">記事一覧</span>
      </a>
    </nav>

    {/* ===== 新着記事グリッド ===== */}
    <section class="section-block">
      <div class="section-heading section-heading--with-action">
        <div>
          <h2>新着記事</h2>
          <p>公開中の記事から、新しいものを中心に表示しています。</p>
        </div>
        <a class="section-action" href="/articles/">記事一覧を見る</a>
      </div>
      <div class="article-list">
        {rest.map((article) => <ArticleCard article={article.data} />)}
      </div>
    </section>

    {/* ===== キャラ紹介: 小さな帯（格下げ） ===== */}
    <a class="char-strip" href="/characters/" aria-label="らぼまる・ひまりについて">
      <img
        class="char-strip-img"
        src="/images/characters/duo-guide.webp"
        alt="すまラボの案内役、らぼまるとひまり"
        width="880"
        height="660"
        loading="lazy"
        decoding="async"
      />
      <span class="char-strip-text">
        <strong>案内役：らぼまる &amp; ひまり</strong>
        <small>むずかしい話を、ふたりが読みやすく噛み砕きます。</small>
      </span>
      <span class="char-strip-cta" aria-hidden="true">→</span>
    </a>

    {/* ===== カテゴリ枠: ニュース筆頭・3枠（通信費は枠外） ===== */}
    <section class="section-block">
      <div class="section-heading">
        <h2>カテゴリ</h2>
        <p>知りたいテーマから、記事を探せます。</p>
      </div>
      <div class="category-grid">
        {
          homeCategories.map((category) => (
            <a href={`/categories/${category.slug}/`}>
              <strong>{category.name}</strong>
              <span>{category.description}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="site-note" aria-label="すまラボの運営方針">
      <div>
        <strong>すまラボの運営方針</strong>
        <p>読者が選びやすく、損しにくい判断につながる情報整理を大切にしています。</p>
      </div>
      <div class="site-note-links">
        <a href="/about/">すまラボについて</a>
        <a href="/characters/">らぼまる・ひまりについて</a>
        <a href="/disclosure/">広告・アフィリエイトについて</a>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ===== ヒーロー: 最新記事カード ===== */
  .lead-hero {
    margin: 0 0 20px;
  }

  .lead-card {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    overflow: hidden;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: var(--shadow-md);
    color: var(--fg);
    text-decoration: none;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      border-color 160ms ease;
  }

  .lead-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
    border-color: var(--line-strong);
  }

  .lead-card:focus-visible {
    outline: 3px solid var(--brand);
    outline-offset: 2px;
  }

  .lead-media {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--bg-sunk);
  }

  .lead-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lead-media-placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    color: var(--fg-faint);
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .lead-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(20px, 3vw, 34px);
  }

  .lead-eyebrow {
    align-self: start;
    padding: 3px 12px;
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--brand);
    font-size: 12.5px;
    font-weight: 700;
  }

  .lead-title {
    margin: 2px 0 0;
    font-family: var(--font-heading);
    font-size: clamp(21px, 2.6vw, 28px);
    line-height: 1.4;
  }

  .lead-summary {
    margin: 0;
    color: var(--fg-mid);
    font-size: 15px;
    line-height: 1.8;
  }

  .lead-cta {
    margin-top: auto;
    color: var(--brand);
    font-weight: 700;
    font-size: 14.5px;
  }

  /* ===== クイックカテゴリ ===== */
  .quick-cats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 0 0 46px;
  }

  .quick-cat {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 58px;
    padding: 12px 14px;
    border-radius: 14px;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    color: var(--fg);
    text-decoration: none;
    text-align: center;
    transition:
      border-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .quick-cat:hover {
    border-color: var(--brand);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .quick-cat:focus-visible {
    outline: 3px solid var(--brand);
    outline-offset: 2px;
  }

  .quick-cat-name {
    font-size: 14.5px;
    font-weight: 700;
  }

  .quick-cat--all {
    background: var(--brand-soft);
    border-color: color-mix(in srgb, var(--brand) 30%, transparent);
  }

  /* ===== セクション見出し ===== */
  .section-block + .section-block {
    margin-top: 42px;
  }

  .section-heading {
    margin-bottom: 16px;
  }

  .section-heading--with-action {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
  }

  .section-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--brand);
    color: #ffffff;
    padding: 8px 14px;
    font-size: 13.5px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition:
      filter 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .section-action:hover {
    box-shadow: var(--shadow-sm);
    filter: brightness(1.05);
    transform: translateY(-1px);
  }

  h2 {
    margin: 0;
    font-size: 26px;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .section-heading p {
    margin: 6px 0 0;
    color: var(--color-muted);
  }

  .article-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  /* ===== キャラ帯 ===== */
  .char-strip {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 42px;
    padding: 12px 18px 12px 12px;
    background: var(--labo-bg);
    border: 1px solid color-mix(in srgb, var(--labo) 22%, transparent);
    border-radius: 16px;
    color: var(--fg);
    text-decoration: none;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .char-strip:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .char-strip:focus-visible {
    outline: 3px solid var(--labo);
    outline-offset: 2px;
  }

  .char-strip-img {
    flex: none;
    width: 96px;
    height: 72px;
    object-fit: contain;
  }

  .char-strip-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .char-strip-text strong {
    font-size: 15px;
    font-family: var(--font-heading);
  }

  .char-strip-text small {
    color: var(--fg-mid);
    font-size: 13px;
    line-height: 1.6;
  }

  .char-strip-cta {
    margin-left: auto;
    color: var(--labo);
    font-size: 20px;
    font-weight: 700;
  }

  /* ===== カテゴリ枠 ===== */
  .category-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .category-grid a {
    display: grid;
    align-content: start;
    gap: 6px;
    min-height: 104px;
    padding: 18px;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    color: var(--color-text);
    text-decoration: none;
    transition:
      border-color 160ms ease,
      transform 160ms ease;
  }

  .category-grid a:hover {
    border-color: var(--brand);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }

  .category-grid strong {
    font-size: 17px;
    line-height: 1.45;
    font-family: var(--font-heading);
  }

  .category-grid span {
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.6;
  }

  /* ===== 運営方針ノート ===== */
  .site-note {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-top: 42px;
    padding: 18px;
    background: var(--brand-soft);
    border: 1px solid color-mix(in srgb, var(--brand) 20%, transparent);
    border-radius: var(--radius-lg);
  }

  .site-note strong {
    display: block;
    font-size: 15px;
  }

  .site-note p {
    margin: 4px 0 0;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .site-note-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: end;
  }

  .site-note-links a {
    padding: 7px 11px;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    color: var(--fg);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }

  /* ===== レスポンシブ ===== */
  @media (max-width: 820px) {
    .lead-card {
      grid-template-columns: 1fr;
    }

    .quick-cats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .article-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .category-grid {
      grid-template-columns: 1fr;
    }

    .site-note {
      align-items: flex-start;
      flex-direction: column;
    }

    .site-note-links {
      justify-content: start;
    }
  }

  @media (max-width: 520px) {
    .section-heading--with-action {
      align-items: start;
      flex-direction: column;
    }

    .article-list {
      grid-template-columns: 1fr;
    }

    .char-strip-img {
      width: 76px;
      height: 58px;
    }
  }
</style>
