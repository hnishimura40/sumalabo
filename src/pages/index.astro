---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { categories } from "../lib/categories";
import { getSortedVisibleArticles } from "../lib/articles";

const articles = getSortedVisibleArticles(await getCollection("articles")).slice(0, 6);
---

<BaseLayout canonicalPath="/">
  <section class="page-shell">
    <div class="hero">
      <div class="hero-copy">
        <p class="eyebrow">スマホ・AI・ガジェットの整理メディア</p>
        <h1>すまラボ</h1>
        <p class="lead">むずかしいスマホ・AI・ガジェットの話を、わかりやすく。</p>
        <p>
          すまラボは、ニュースを要約するだけでなく「それで何が変わるのか」「誰に関係あるのか」「買う・選ぶ判断にどうつながるのか」まで整理するメディアです。
        </p>
      </div>
      <nav class="hero-panel" aria-label="すまラボの主要カテゴリ">
        <div class="hero-panel-heading">
          <span>すまラボの入口</span>
          <small>知りたいテーマから探す</small>
        </div>
        <a href="/categories/smartphone/">
          <strong>スマホの選び方</strong>
          <span>iPhone・Android・中古スマホを整理</span>
        </a>
        <a href="/categories/mobile-plan/">
          <strong>通信費を下げる</strong>
          <span>格安SIM・eSIM・乗り換えの基本</span>
        </a>
        <a href="/articles/what-is-esim/">
          <strong>eSIM入門</strong>
          <span>まず知りたい仕組みと注意点</span>
        </a>
        <a href="/categories/gadgets/">
          <strong>周辺機器比較</strong>
          <span>充電器・モバイルバッテリー選び</span>
        </a>
      </nav>
    </div>

    <section class="section-block">
      <div class="section-heading section-heading--with-action">
        <div>
          <h2>新着記事</h2>
          <p>公開中の記事から、新しいものを中心に表示しています。</p>
        </div>
        <a class="section-action" href="/articles/">記事一覧を見る</a>
      </div>
      <div class="article-list">
        {articles.map((article) => <ArticleCard article={article.data} />)}
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <h2>カテゴリ</h2>
        <p>まずは4つの入口から、知りたいテーマを選べる形にしていきます。</p>
      </div>
      <div class="category-grid">
        {categories.map((category) => (
          <a href={`/categories/${category.slug}/`}>
            <strong>{category.name}</strong>
            <span>{category.description}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="site-note" aria-label="すまラボの運営方針">
      <div>
        <strong>すまラボの運営方針</strong>
        <p>読者が選びやすく、損しにくい判断につながる情報整理を大切にしています。</p>
      </div>
      <div class="site-note-links">
        <a href="/about/">すまラボについて</a>
        <a href="/characters/">らぼまる・ひまりについて</a>
        <a href="/disclosure/">広告・アフィリエイトについて</a>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 320px);
    gap: 32px;
    align-items: center;
    margin-bottom: 46px;
    padding: clamp(24px, 5vw, 42px);
    background: var(--bg-elev);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .eyebrow {
    margin: 0 0 10px;
    color: var(--color-mint-dark);
    font-size: 13px;
    font-weight: 800;
  }

  h1 {
    margin: 0;
    font-size: clamp(42px, 8vw, 72px);
    line-height: 1.1;
    letter-spacing: 0;
  }

  .lead {
    margin: 18px 0 10px;
    font-size: clamp(20px, 4vw, 28px);
    font-weight: 800;
    line-height: 1.45;
  }

  .hero-copy > p:not(.eyebrow):not(.lead) {
    margin: 0;
    color: var(--color-muted);
    font-size: 16px;
  }

  .hero-panel {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    overflow: hidden;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 86% 10%, color-mix(in srgb, var(--teal) 20%, transparent), transparent 28%),
      linear-gradient(135deg, var(--teal-tint), transparent 62%),
      var(--bg-sunk);
  }

  .hero-panel::after {
    content: "";
    position: absolute;
    top: 18px;
    right: 18px;
    width: 34px;
    height: 34px;
    border: 4px solid color-mix(in srgb, var(--teal) 52%, transparent);
    border-radius: 50%;
    opacity: 0.34;
    pointer-events: none;
  }

  .hero-panel::before {
    content: "";
    position: absolute;
    top: 48px;
    right: 13px;
    width: 18px;
    height: 5px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--teal) 52%, transparent);
    opacity: 0.34;
    transform: rotate(45deg);
    pointer-events: none;
  }

  .hero-panel-heading {
    grid-column: 1 / -1;
    display: grid;
    gap: 4px;
    padding: 0 46px 2px 2px;
  }

  .hero-panel-heading span {
    color: var(--fg);
    font-size: 15px;
    font-weight: 800;
    line-height: 1.4;
  }

  .hero-panel-heading small {
    color: var(--fg-soft);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.5;
  }

  .hero-panel a {
    position: relative;
    display: grid;
    align-content: start;
    min-height: 112px;
    gap: 6px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--bg-elev) 88%, transparent), color-mix(in srgb, var(--bg-elev) 70%, transparent)),
      color-mix(in srgb, var(--bg-sunk) 88%, var(--teal-tint));
    color: var(--fg);
    padding: 14px;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .hero-panel a:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }

  .hero-panel a::before {
    content: "";
    width: 22px;
    height: 3px;
    border-radius: 999px;
    background: var(--teal);
    opacity: 0.78;
  }

  .hero-panel strong {
    font-size: 15px;
    line-height: 1.45;
  }

  .hero-panel a span {
    color: var(--fg-soft);
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1.55;
  }

  .section-block + .section-block {
    margin-top: 42px;
  }

  .section-heading {
    margin-bottom: 16px;
  }

  .section-heading--with-action {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
  }

  .section-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--teal);
    color: #ffffff;
    padding: 8px 14px;
    font-size: 13.5px;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    transition:
      filter 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .section-action:hover {
    box-shadow: var(--shadow-sm);
    filter: brightness(1.05);
    transform: translateY(-1px);
  }

  h2 {
    margin: 0;
    font-size: 28px;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .section-heading p {
    margin: 6px 0 0;
    color: var(--color-muted);
  }

  .category-grid,
  .article-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .category-grid a {
    min-height: 104px;
    padding: 18px;
    background: var(--bg-elev);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .category-grid a {
    display: grid;
    align-content: start;
    gap: 6px;
    color: var(--color-text);
    text-decoration: none;
    transition:
      border-color 160ms ease,
      transform 160ms ease;
  }

  .category-grid a:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }

  .category-grid strong {
    font-size: 17px;
    line-height: 1.45;
  }

  .category-grid span {
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .article-list {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .site-note {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-top: 42px;
    padding: 18px;
    background: var(--teal-tint);
    border: 1px solid var(--teal-tint-2);
    border-radius: var(--radius-lg);
  }

  .site-note strong {
    display: block;
    font-size: 15px;
  }

  .site-note p {
    margin: 4px 0 0;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .site-note-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: end;
  }

  .site-note-links a {
    padding: 7px 11px;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    color: var(--fg);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-panel {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .article-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-note {
      align-items: flex-start;
      flex-direction: column;
    }

    .site-note-links {
      justify-content: start;
    }
  }

  @media (max-width: 520px) {
    .section-heading--with-action {
      align-items: start;
      flex-direction: column;
    }

    .hero-panel {
      grid-template-columns: 1fr;
    }

    .hero-panel a {
      min-height: auto;
    }

    .category-grid {
      grid-template-columns: 1fr;
    }

    .article-list {
      grid-template-columns: 1fr;
    }
  }
</style>
