---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { categories } from "../lib/categories";
import { isListableArticle, sortArticles } from "../lib/articles";

const articles = (await getCollection("articles"))
  .filter(isListableArticle)
  .sort(sortArticles)
  .slice(0, 3);
---

<BaseLayout canonicalPath="/">
  <section class="page-shell">
    <div class="hero">
      <div class="hero-copy">
        <p class="eyebrow">スマホ・AI・ガジェットの整理メディア</p>
        <h1>すまラボ</h1>
        <p class="lead">むずかしいスマホ・AI・ガジェットの話を、わかりやすく。</p>
        <p>
          すまラボは、ニュースを要約するだけでなく「それで何が変わるのか」「誰に関係あるのか」「買う・選ぶ判断にどうつながるのか」まで整理するメディアです。
        </p>
        <div class="hero-actions">
          <a href="/articles/">記事一覧を見る</a>
          <a href="/articles/what-is-esim/">eSIM記事を見る</a>
        </div>
      </div>
      <div class="hero-panel" aria-hidden="true">
        <span>SMARTPHONE</span>
        <span>AI</span>
        <span>eSIM</span>
        <span>GADGET</span>
      </div>
    </div>

    <section class="section-block">
      <div class="section-heading">
        <h2>カテゴリ</h2>
        <p>まずは4つの入口から、知りたいテーマを選べる形にしていきます。</p>
      </div>
      <div class="category-grid">
        {categories.map((category) => (
          <a href={`/categories/${category.slug}/`}>
            <strong>{category.name}</strong>
            <span>{category.description}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <h2>新着記事</h2>
        <p>公開中の記事から、新しいものを中心に表示しています。</p>
      </div>
      <div class="article-list">
        {articles.map((article) => <ArticleCard article={article.data} />)}
      </div>
    </section>

    <section class="site-note" aria-label="すまラボの運営方針">
      <div>
        <strong>すまラボの運営方針</strong>
        <p>読者が選びやすく、損しにくい判断につながる情報整理を大切にしています。</p>
      </div>
      <div class="site-note-links">
        <a href="/about/">すまラボについて</a>
        <a href="/disclosure/">広告・アフィリエイトについて</a>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 320px);
    gap: 32px;
    align-items: center;
    margin-bottom: 46px;
    padding: clamp(24px, 5vw, 42px);
    background: var(--bg-elev);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .eyebrow {
    margin: 0 0 10px;
    color: var(--color-mint-dark);
    font-size: 13px;
    font-weight: 800;
  }

  h1 {
    margin: 0;
    font-size: clamp(42px, 8vw, 72px);
    line-height: 1.1;
    letter-spacing: 0;
  }

  .lead {
    margin: 18px 0 10px;
    font-size: clamp(20px, 4vw, 28px);
    font-weight: 800;
    line-height: 1.45;
  }

  .hero-copy > p:not(.eyebrow):not(.lead) {
    margin: 0;
    color: var(--color-muted);
    font-size: 16px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .hero-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    border-radius: var(--radius-md);
    padding: 8px 14px;
    font-size: 13.5px;
    font-weight: 700;
    text-decoration: none;
  }

  .hero-actions a:first-child {
    background: var(--teal);
    color: #ffffff;
  }

  .hero-actions a:last-child {
    border: 1px solid var(--color-border);
    background: var(--bg-elev);
    color: var(--color-text);
  }

  .hero-panel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, var(--teal-tint), transparent 62%),
      var(--bg-sunk);
  }

  .hero-panel span {
    display: grid;
    place-items: center;
    min-height: 78px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--bg-elev) 78%, transparent);
    color: var(--fg-mid);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .section-block + .section-block {
    margin-top: 42px;
  }

  .section-heading {
    margin-bottom: 16px;
  }

  h2 {
    margin: 0;
    font-size: 28px;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .section-heading p {
    margin: 6px 0 0;
    color: var(--color-muted);
  }

  .category-grid,
  .article-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .category-grid a {
    min-height: 104px;
    padding: 18px;
    background: var(--bg-elev);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .category-grid a {
    display: grid;
    align-content: start;
    gap: 6px;
    color: var(--color-text);
    text-decoration: none;
    transition:
      border-color 160ms ease,
      transform 160ms ease;
  }

  .category-grid a:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }

  .category-grid strong {
    font-size: 17px;
    line-height: 1.45;
  }

  .category-grid span {
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .article-list {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .site-note {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-top: 42px;
    padding: 18px;
    background: var(--teal-tint);
    border: 1px solid var(--teal-tint-2);
    border-radius: var(--radius-lg);
  }

  .site-note strong {
    display: block;
    font-size: 15px;
  }

  .site-note p {
    margin: 4px 0 0;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .site-note-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: end;
  }

  .site-note-links a {
    padding: 7px 11px;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    color: var(--fg);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-note {
      align-items: flex-start;
      flex-direction: column;
    }

    .site-note-links {
      justify-content: start;
    }
  }

  @media (max-width: 520px) {
    .category-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
