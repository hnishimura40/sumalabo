---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { categories } from "../lib/categories";
import { getSortedVisibleArticles } from "../lib/articles";
import { siteConfig } from "../config/site";

const articles = getSortedVisibleArticles(await getCollection("articles")).slice(0, 6);

// JSON-LD WebSite schema（M3 SEO基盤）
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.siteName,
  url: siteConfig.siteUrl,
  description: siteConfig.siteDescription,
  publisher: { "@type": "Organization", name: siteConfig.siteName, url: siteConfig.siteUrl },
  inLanguage: "ja",
};
---

<BaseLayout canonicalPath="/">
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <section class="page-shell">
    <h1 class="sr-only">すまラボ — スマホ・AI・ガジェットをやさしく整理</h1>

    <section class="hero" aria-label="すまラボの主要な入口">
      {/* 背景リーダー画像（PC=横長 / スマホ=縦長を出し分け、ボタンは含まない） */}
      <picture class="hero-bg">
        <source
          media="(max-width: 720px)"
          type="image/webp"
          srcset="/images/hero/sumalabo-hero-mobile.webp"
        />
        <source media="(max-width: 720px)" srcset="/images/hero/sumalabo-hero-mobile.png" />
        <source type="image/webp" srcset="/images/hero/sumalabo-hero-desktop.webp" />
        <img
          src="/images/hero/sumalabo-hero-desktop.png"
          alt="すまラボ。スマホ・AI・ガジェットをやさしく整理。案内役のひまりとらぼまるのイラスト。"
          decoding="async"
          fetchpriority="high"
        />
      </picture>

      {/* 主要CTA「記事を探す」：PCは背景画像の左下に大きく重ね、スマホは画像下に幅広表示 */}
      <a class="hero-cta-search" href="/articles/" aria-label="記事を探す">
        <img src="/images/hero/btn-search.webp" alt="" decoding="async" />
        <span class="sr-only">記事を探す</span>
      </a>
    </section>

    {/* カテゴリ4つ：PC=4列 / スマホ=2列の統一CSSカード（全て同サイズ・同高さ） */}
    <nav class="hero-category-row" aria-label="すまラボの主要カテゴリ">
      <a class="hero-category-card" href="/categories/smartphone/">
        <span class="hero-category-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2.5" /><line x1="10.5" y1="18.5" x2="13.5" y2="18.5" /></svg>
        </span>
        <span class="hero-category-label">スマホの選び方</span>
      </a>
      <a class="hero-category-card" href="/categories/mobile-plan/">
        <span class="hero-category-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4l6 7 6-7" /><line x1="12" y1="11" x2="12" y2="20" /><line x1="8" y1="13.5" x2="16" y2="13.5" /><line x1="8" y1="16.5" x2="16" y2="16.5" /></svg>
        </span>
        <span class="hero-category-label">通信費を下げる</span>
      </a>
      <a class="hero-category-card" href="/categories/gadgets/">
        <span class="hero-category-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14v-3a8 8 0 0 1 16 0v3" /><rect x="2.5" y="13.5" width="4" height="7" rx="1.5" /><rect x="17.5" y="13.5" width="4" height="7" rx="1.5" /></svg>
        </span>
        <span class="hero-category-label">周辺機器・ガジェット</span>
      </a>
      <a class="hero-category-card" href="/articles/what-is-esim/">
        <span class="hero-category-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h7l4 4v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z" /><rect x="9" y="12" width="6" height="6" rx="1" /></svg>
        </span>
        <span class="hero-category-label">eSIM入門</span>
      </a>
    </nav>

    <section class="section-block">
      <div class="section-heading section-heading--with-action">
        <div>
          <h2>新着記事</h2>
          <p>公開中の記事から、新しいものを中心に表示しています。</p>
        </div>
        <a class="section-action" href="/articles/">記事一覧を見る</a>
      </div>
      <div class="article-list">
        {articles.map((article) => <ArticleCard article={article.data} />)}
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <h2>カテゴリ</h2>
        <p>まずは4つの入口から、知りたいテーマを選べる形にしていきます。</p>
      </div>
      <div class="category-grid">
        {categories.map((category) => (
          <a href={`/categories/${category.slug}/`}>
            <strong>{category.name}</strong>
            <span>{category.description}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="site-note" aria-label="すまラボの運営方針">
      <div>
        <strong>すまラボの運営方針</strong>
        <p>読者が選びやすく、損しにくい判断につながる情報整理を大切にしています。</p>
      </div>
      <div class="site-note-links">
        <a href="/about/">すまラボについて</a>
        <a href="/characters/">らぼまる・ひまりについて</a>
        <a href="/disclosure/">広告・アフィリエイトについて</a>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ===== Hero（背景画像 + CTA + カテゴリカード） ===== */
  .hero {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .hero-bg,
  .hero-bg img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-bg img {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-border);
  }

  /* 主要CTA「記事を探す」：PCは背景の左下に大きく重ねる */
  .hero-cta-search {
    position: absolute;
    left: 4%;
    top: 78%;
    width: 40%;
    display: block;
    text-decoration: none;
    border-radius: 18px;
    transition:
      transform 160ms ease,
      filter 160ms ease;
  }

  .hero-cta-search img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 6px 14px rgba(20, 90, 100, 0.2));
    transition: filter 160ms ease;
  }

  .hero-cta-search:hover,
  .hero-cta-search:focus-visible {
    transform: translateY(-2px);
    outline: none;
  }

  .hero-cta-search:hover img,
  .hero-cta-search:focus-visible img {
    filter: drop-shadow(0 12px 22px rgba(20, 90, 100, 0.32)) brightness(1.03);
  }

  .hero-cta-search:focus-visible {
    outline: 3px solid var(--teal);
    outline-offset: 4px;
  }

  /* カテゴリ4枚：統一CSSカード。PC=4列、スマホ=2列。全て同サイズ・同高さ。 */
  .hero-category-row {
    width: 100%;
    max-width: 1200px;
    margin: 18px auto 46px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .hero-category-card {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 88px;
    padding: 16px 18px;
    border-radius: 18px;
    background:
      linear-gradient(180deg, var(--bg-elev), color-mix(in srgb, var(--teal-tint) 70%, var(--bg-elev)));
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    color: var(--fg);
    text-decoration: none;
    transition:
      border-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .hero-category-card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .hero-category-card:focus-visible {
    outline: 3px solid var(--teal);
    outline-offset: 2px;
  }

  .hero-category-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 13px;
    background: color-mix(in srgb, var(--teal) 16%, var(--bg-elev));
    color: var(--teal);
  }

  .hero-category-icon svg {
    width: 26px;
    height: 26px;
  }

  .hero-category-label {
    font-size: 15.5px;
    font-weight: 800;
    line-height: 1.4;
  }

  .section-block + .section-block {
    margin-top: 42px;
  }

  .section-heading {
    margin-bottom: 16px;
  }

  .section-heading--with-action {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
  }

  .section-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--teal);
    color: #ffffff;
    padding: 8px 14px;
    font-size: 13.5px;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    transition:
      filter 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .section-action:hover {
    box-shadow: var(--shadow-sm);
    filter: brightness(1.05);
    transform: translateY(-1px);
  }

  h2 {
    margin: 0;
    font-size: 28px;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .section-heading p {
    margin: 6px 0 0;
    color: var(--color-muted);
  }

  .category-grid,
  .article-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .category-grid a {
    min-height: 104px;
    padding: 18px;
    background: var(--bg-elev);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .category-grid a {
    display: grid;
    align-content: start;
    gap: 6px;
    color: var(--color-text);
    text-decoration: none;
    transition:
      border-color 160ms ease,
      transform 160ms ease;
  }

  .category-grid a:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }

  .category-grid strong {
    font-size: 17px;
    line-height: 1.45;
  }

  .category-grid span {
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.6;
  }

  .article-list {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .site-note {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-top: 42px;
    padding: 18px;
    background: var(--teal-tint);
    border: 1px solid var(--teal-tint-2);
    border-radius: var(--radius-lg);
  }

  .site-note strong {
    display: block;
    font-size: 15px;
  }

  .site-note p {
    margin: 4px 0 0;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .site-note-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: end;
  }

  .site-note-links a {
    padding: 7px 11px;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    color: var(--fg);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }

  /* スマホ幅：縦長背景に切替。画像の下に CTA(1列) → カテゴリ(2列) を通常配置。 */
  @media (max-width: 720px) {
    .hero {
      margin-bottom: 0;
    }

    /* 主要CTA「記事を探す」は画像下に1列・幅広（巨大化させない） */
    .hero-cta-search {
      position: static;
      left: auto;
      top: auto;
      width: 100%;
      max-width: 420px;
      margin: 16px auto 0;
    }

    .hero-cta-search:hover,
    .hero-cta-search:focus-visible {
      transform: none;
    }

    /* カテゴリは2列グリッド（PCと同じカード、列数だけ変更） */
    .hero-category-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin-top: 14px;
    }

    /* スマホはアイコンを上、ラベルを下の縦組みにして高さをそろえる */
    .hero-category-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
      min-height: 92px;
      padding: 14px;
    }

    .hero-category-icon {
      width: 38px;
      height: 38px;
      border-radius: 11px;
    }

    .hero-category-icon svg {
      width: 22px;
      height: 22px;
    }

    .hero-category-label {
      font-size: 14px;
    }
  }

  @media (max-width: 820px) {
    .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .article-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-note {
      align-items: flex-start;
      flex-direction: column;
    }

    .site-note-links {
      justify-content: start;
    }
  }

  @media (max-width: 520px) {
    .section-heading--with-action {
      align-items: start;
      flex-direction: column;
    }

    .category-grid {
      grid-template-columns: 1fr;
    }

    .article-list {
      grid-template-columns: 1fr;
    }
  }
</style>
