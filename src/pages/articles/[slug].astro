---
import { getCollection, render } from "astro:content";
import {siteConfig} from "../../config/site";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import ArticleAffiliatePlacements from "../../components/article/ArticleAffiliatePlacements.astro";
import { getAdjacentArticles, getSortedVisibleArticles } from "../../lib/articles";

export async function getStaticPaths() {
  const articles = getSortedVisibleArticles(await getCollection("articles"));

  return articles.map((article) => {
    const { previousArticle, nextArticle } = getAdjacentArticles(articles, article.data.slug);

    return {
      params: { slug: article.data.slug },
      props: {
        article,
        previousArticle: previousArticle?.data,
        nextArticle: nextArticle?.data,
      },
    };
  });
}

const { article, previousArticle, nextArticle } = Astro.props;
const { Content, headings } = await render(article);
const renewal=siteConfig.renewalArticleLayout && /data-renewal-kind=|<AiArticleV2\b/.test(article.body || "");
---

<ArticleLayout
  article={article.data}
  previousArticle={previousArticle}
  nextArticle={nextArticle}
  headings={headings}
  renewal={renewal}
>
  <Content />
  {!renewal && <ArticleAffiliatePlacements slug={article.data.slug} />}
</ArticleLayout>
