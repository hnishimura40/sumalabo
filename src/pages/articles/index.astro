---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import StapleGuideCard from "../../components/StapleGuideCard.astro";
import CategoryNav from "../../components/CategoryNav.astro";
import { isListableArticle, sortArticles } from "../../lib/articles";
import { buildStapleCards, interleaveStaples } from "../../lib/staple-cards";

const all = await getCollection("articles");
const articles = all.filter(isListableArticle).sort(sortArticles);
// D: 定番ガイド(収益記事)を N 件ごとに差し込む
const items = interleaveStaples(articles, buildStapleCards(all));
---

<BaseLayout
  title="記事一覧"
  description="すまラボの記事一覧です。スマホ・AI・ガジェットの選び方や通信費の見直しを、分かりやすく整理します。"
  canonicalPath="/articles/"
>
  <section class="page-shell">
    <header class="list-header">
      <p class="eyebrow">Articles</p>
      <h1>記事一覧</h1>
      <p>
        スマホ・AI・ガジェットの話を、専門用語をかみくだいて整理した記事一覧です。
      </p>
    </header>

    <section class="article-types" aria-label="記事タイプ">
      <div>
        <span>foundation</span>
        <strong>土台記事</strong>
        <p>用語や選び方を、あとで迷わないように整理します。</p>
      </div>
      <div>
        <span>revenue</span>
        <strong>比較・判断記事</strong>
        <p>買う、乗り換える、選ぶ前の判断軸をまとめます。</p>
      </div>
      <div>
        <span>news</span>
        <strong>話題解説</strong>
        <p>新機能やニュースを生活者目線でかみくだきます。</p>
      </div>
    </section>

    <CategoryNav
      title="テーマ別に探す"
      text="知りたい内容が決まっている場合は、カテゴリから入ると目的の記事に近づきやすくなります。"
    />

    {
      articles.length > 0 ? (
        <section class="article-section" aria-labelledby="article-section-title">
          <div class="section-heading">
            <p class="eyebrow">Latest</p>
            <h2 id="article-section-title">公開中の記事</h2>
            <p>
              公開準備ができた本番記事を掲載しています。選び方の土台記事から、具体的な比較記事まで順番に確認できます。
            </p>
          </div>
          <div class="article-grid">
            {
              items.map((item) =>
                item.kind === "article" ? (
                  <ArticleCard article={item.entry.data} />
                ) : (
                  <StapleGuideCard card={item.card} />
                ),
              )
            }
          </div>
        </section>
      ) : (
        <div class="empty-state">
          <span>Preparing</span>
          <strong>記事はまだ準備中です。</strong>
          <p>公開準備ができた記事からここに表示されます。先にカテゴリから、今後扱うテーマを確認できます。</p>
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .list-header {
    margin-bottom: 24px;
    padding: clamp(24px, 5vw, 38px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, var(--teal-tint), transparent 58%),
      var(--bg-elev);
    box-shadow: var(--shadow-sm);
  }

  .eyebrow {
    margin: 0 0 8px;
    color: var(--teal);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--fg);
    font-size: clamp(34px, 7vw, 58px);
    line-height: 1.18;
    letter-spacing: 0;
  }

  .list-header p:last-child {
    max-width: 720px;
    margin: 14px 0 0;
    color: var(--fg-soft);
    font-size: 16px;
    line-height: 1.8;
  }

  .article-types {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin: 24px 0 36px;
  }

  .article-types div,
  .empty-state {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
    box-shadow: var(--shadow-sm);
  }

  .article-types div {
    display: grid;
    gap: 7px;
    padding: 18px;
  }

  .article-types span,
  .empty-state span {
    width: fit-content;
    border-radius: 999px;
    padding: 3px 8px;
    color: var(--fg-mid);
    background: var(--bg-sunk);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .article-types strong {
    color: var(--fg);
    font-size: 16px;
    line-height: 1.45;
  }

  .article-types p {
    margin: 0;
    color: var(--fg-soft);
    font-size: 13px;
    line-height: 1.7;
  }

  .article-section {
    margin-top: 44px;
  }

  .section-heading {
    display: grid;
    gap: 6px;
    margin-bottom: 16px;
  }

  h2 {
    margin: 0;
    color: var(--fg);
    font-size: clamp(24px, 4vw, 32px);
    line-height: 1.35;
    letter-spacing: 0;
  }

  .section-heading p:last-child {
    max-width: 760px;
    margin: 0;
    color: var(--fg-soft);
    line-height: 1.75;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
  }

  .empty-state {
    display: grid;
    gap: 8px;
    margin-top: 34px;
    padding: 24px;
  }

  .empty-state p {
    margin: 0;
    color: var(--fg-soft);
    line-height: 1.7;
  }

  @media (max-width: 760px) {
    .article-types {
      grid-template-columns: 1fr;
    }
  }
</style>
