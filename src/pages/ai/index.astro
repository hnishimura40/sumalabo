---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharacterBubble from '../../components/article/CharacterBubble.astro';
import {entries,categories,features,benchmarks,checkedAt} from '../../data/ai-comparison';
const places={cloud:'クラウドで作業',local:'端末内で作業',hybrid:'端末内／クラウド・構成別'};
const inference=(e:typeof entries[number])=>['local','workflow','model'].includes(e.category)?'モデル・構成に依存':'サービス提供側のクラウド';
const groups={summary:'用途・選ぶ理由',creation:'画像・動画・音楽',work:'調査・作業の実行',access:'実行場所・公開条件'};
const companions=entries.filter(e=>e.category==='companion');
---
<BaseLayout title="AI比較ガイド｜チャット・エージェント・画像・動画・音楽・公開モデル" description="AIを用途から横断比較。ChatGPT・Gemini・Claude、Dots・Muse、ローカル実行ツールと公開モデルを、機能・実行場所・条件・根拠から選ぶ常設ガイド。" canonicalPath="/ai/" noindex={true}>
 <div class="ai-guide" id="ai-guide">
  <header class="guide-hero">
   <div><p class="eyebrow">すまラボの常設ガイド / 初版プレビュー</p><h1>AIは、<br />何を任せたいかで選ぶ。</h1><p class="hero-lead">話す。調べる。作る。仕事を進める。<br />チャットの順位だけでは見えない違いを、同じ表で。</p><p class="verification">機能概要の確認：<time datetime={checkedAt}>{checkedAt}</time> · {entries.length}件 · ベンチマークの入口 {benchmarks.length}件</p><a class="primary-link" href="#compare">比較表で選ぶ <span aria-hidden="true">↓</span></a></div>
   <div class="hero-side"><img src="/images/characters/duo_guide_half.webp" alt="比較表を一緒に読み解くひまりとらぼまる" width="430" height="430" /><p>「すごいAI」から、<br /><strong>「自分に合うAI」へ。</strong></p></div>
  </header>
  <nav class="guide-nav" aria-label="AI比較ガイドの目次"><a href="#compare">横断比較</a><a href="#companion">常時動くAI秘書</a><a href="#gemini">Geminiでできること</a><a href="#open">ローカル・公開モデル</a><a href="#benchmarks">ベンチマーク</a><a href="#method">確認方法・更新</a></nav>
  <section class="start-section" aria-labelledby="start-title"><div class="section-heading"><p class="eyebrow">最初の一歩</p><h2 id="start-title">やりたいことから、候補を絞ろう。</h2><p>今のAIで困っていなければ、追加契約を急ぐ必要はありません。まずは同じ作業を試し、直す手間まで比べましょう。</p></div>
   <div class="purpose-grid">{[
    ['chat','文章・相談','言い回し、要約、考えの整理'],['research','調べもの','出典と資料をたどる'],['image','画像を作る','生成・編集・参照画像'],['video','動画を作る','生成・編集・音声の条件'],['music','曲を作る','歌・BGM・制作後の利用条件'],['code','開発する','コード変更・テスト・確認'],['automation','仕事を任せる','単発の実行か、継続する仕事か'],
   ].map(([key,label,description])=><button type="button" class="purpose-card" data-purpose={key}><strong>{label}<span aria-hidden="true">↗</span></strong><span>{description}</span></button>)}</div>
  </section>
  <div class="reader-bubbles"><CharacterBubble speaker="himari" mood="curious">Geminiは動画も音楽も作れるのに、チャットの成績だけでは選べないよね？</CharacterBubble><CharacterBubble speaker="labo" mood="point">その通り。画像を読む・画像を作る、音声で話す・曲を作る、は別の機能。料金や使える地域も、機能ごとに確かめよう。</CharacterBubble></div>
  <section id="compare" class="compare-section" aria-labelledby="compare-title"><div class="section-heading"><p class="eyebrow">機能・用途・条件を横断比較</p><h2 id="compare-title">あなたの条件で、同じ表を見比べる。</h2><p>「対応」は製品全体で無条件に使える意味ではありません。プラン・地域・接続・モデルの条件を併せて確認してください。実機テストの順位ではなく、公式に説明された機能概要です。</p></div>
   <form class="filters" id="ai-filters" role="search"><label class="search-label">サービス名・やりたいこと<input id="ai-search" name="q" type="search" placeholder="例：Gemini、音楽、ローカル" autocomplete="off" /></label><label>種類<select name="category" id="ai-category"><option value="">すべて</option>{Object.entries(categories).map(([key,label])=><option value={key}>{label}</option>)}</select></label><label>使いたい機能<select name="feature" id="ai-feature"><option value="">すべて</option>{Object.entries(features).map(([key,label])=><option value={key}>{label}</option>)}</select></label><label>実行場所<select name="place" id="ai-place"><option value="">すべて</option><option value="cloud">クラウド</option><option value="hybrid">ローカル／構成別</option></select></label><button type="reset" class="reset-button">条件を戻す</button></form>
   <div class="table-toolbar"><div class="view-buttons" role="group" aria-label="比較する項目">{Object.entries(groups).map(([key,label])=><button type="button" data-view={key} aria-pressed={key==='summary'?'true':'false'}>{label}</button>)}</div><p id="ai-count" aria-live="polite">{entries.length}件を表示</p></div>
   <p class="table-help" id="table-help">表は横にスクロールできます。左のチェックで3件まで選び、違いを並べて読めます。「未確認」は非対応という意味ではありません。「実行場所」は作業・ツールの場所です。AIが答えを考える推論の場所は別欄で確認してください。</p>
   <div class="table-wrap" role="region" aria-label="AIの横断比較表" aria-describedby="table-help" tabindex="0"><table class="matrix" id="ai-matrix"><caption class="sr-only">AIサービス・ツール・モデル群の公式機能概要。確認日と条件を各行に記載。</caption><thead><tr><th scope="col" class="select-col">並べる</th><th scope="col" class="name-col">サービス・ツール・モデル</th><th scope="col" data-group="summary">こんな人に</th><th scope="col" data-group="summary">特徴と選ぶ理由</th>{Object.entries(features).map(([key,label])=><th scope="col" data-group={['image','video','music','voice'].includes(key)?'creation':'work'}>{label}</th>)}<th scope="col" data-group="summary access">実行場所</th><th scope="col" data-group="access">推論の場所</th><th scope="col" data-group="access">公開・ライセンスの扱い</th><th scope="col" data-group="summary access">費用の仕組み</th><th scope="col" data-group="access">利用条件</th><th scope="col" data-group="summary creation work access">注意点・公式出典</th></tr></thead><tbody>
    {entries.map(e=><tr data-entry={e.id} data-category={e.category} data-place={e.deployment} data-features={Object.keys(e.features).join(' ')} data-search={[e.name,e.provider,e.purpose,e.distinction,e.openness,...Object.values(e.features)].join(' ').toLowerCase()}><td class="select-col"><input type="checkbox" data-select={e.id} aria-label={`${e.name}を比較に追加`} /></td><th scope="row" class="name-col"><a href={`#detail-${e.id}`}>{e.name}</a><span class="entry-provider">{e.provider}</span><span class="entry-kind">{e.kind} · {categories[e.category]}</span><small class="row-date" data-confirmed={e.checkedAt}>確認 {e.checkedAt}</small></th><td data-group="summary">{e.purpose}</td><td data-group="summary">{e.distinction}</td>{Object.keys(features).map(key=><td data-group={['image','video','music','voice'].includes(key)?'creation':'work'} class:list={['feature-cell',{'unconfirmed':!e.features[key as keyof typeof features]}]}>{e.features[key as keyof typeof features]||'未確認'}</td>)}<td data-group="summary access">{places[e.deployment]}</td><td data-group="access">{inference(e)}</td><td data-group="access">{e.openness}</td><td data-group="summary access">{e.cost}</td><td data-group="access">{e.availability}</td><td data-group="summary creation work access"><p>{e.caution}</p><div class="source-links">{e.sources.map(s=><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>)}</div></td></tr>)}
   </tbody></table></div><p id="ai-empty" hidden>条件に合う候補がありません。機能の確認範囲を広げるか、「条件を戻す」を使ってください。</p>
   <section id="selected-panel" class="selected-panel" aria-labelledby="selected-title" hidden><div class="selection-heading"><h3 id="selected-title">選んだAIを並べて比較</h3><button id="clear-selection" type="button">選択を解除</button></div><p id="selection-message" aria-live="polite">3件まで選べます。</p><div class="table-wrap" tabindex="0" role="region" aria-label="選んだAIの詳細比較"><table id="selected-table"></table></div><button type="button" id="copy-compare">この比較条件のURLをコピー</button><span id="copy-status" role="status"></span></section>
   <noscript><p>絞り込み・選択比較にはJavaScriptが必要です。比較表の全項目と各出典はそのまま読めます。</p></noscript>
  </section>
  <section id="companion" aria-labelledby="companion-title"><div class="section-heading"><p class="eyebrow">Dots・Muse・Duet</p><h2 id="companion-title">「常時動くAI秘書」は、何が違う？</h2><p>単に返答するチャット、依頼を実行するエージェント、会話の間も仕事を続けるAIは役割が重なります。ここでは継続作業の仕組みを比べます。</p></div><div class="table-wrap" tabindex="0" role="region" aria-label="常時稼働AIの比較"><table><thead><tr><th>サービス</th><th>仕事を続ける場所・入口</th><th>記憶・連携・制御</th><th>使える条件</th></tr></thead><tbody>{companions.map(e=><tr><th scope="row"><a href={`#detail-${e.id}`}>{e.name}</a></th><td>{e.distinction}</td><td>{e.caution}</td><td>{e.availability}<div class="source-links">{e.sources.map(s=><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>)}</div></td></tr>)}</tbody></table></div><p class="note">「24時間動く」は、PCの電源、接続アプリ、連携先の許可、利用枠、処理の継続条件まで無制限という意味ではありません。実測していない完走率は掲載していません。</p></section>
  <section id="gemini" aria-labelledby="gemini-title"><div class="section-heading"><p class="eyebrow">一つの「対応」にまとめない</p><h2 id="gemini-title">Geminiなら、ここまで分けて比べる。</h2></div><div class="feature-grid">{[
   ['画像','Nano Banana系','生成・編集・参照画像・文字の扱い','https://gemini.google/overview/image-generation/'],['動画','Gemini Omni','作成・編集・入力素材・尺・音声の条件','https://gemini.google/overview/video-generation/'],['音楽','Lyria系','歌・楽器音・曲の長さ・利用条件','https://gemini.google/overview/music-generation/'],['調査・会話・資料','Geminiの各機能','Deep Research・Live・Canvas・Google連携','https://gemini.google/overview/']
  ].map(([label,name,description,url])=><article class="feature-card"><p class="eyebrow">{label}</p><h3>{name}</h3><p>{description}</p><a href={url} target="_blank" rel="noopener noreferrer">公式の機能・対象条件 ↗</a></article>)}</div><p class="note">Gemini Notebookの「動画要約」とGemini Omniの「映像生成」も別です。入力できる形式と、出力として作れる形式を混同しません。</p></section>
  <section id="open" aria-labelledby="open-title"><div class="section-heading"><p class="eyebrow">二つの軸で考える</p><h2 id="open-title">オンラインとオープンソースは、二択ではない。</h2></div><div class="feature-grid two"><article class="feature-card"><h3>① どこで動かす？</h3><p>提供元のクラウド／自分のPC／自分のサーバー。端末にアプリがあっても、推論や外部ツールがクラウドで動く場合があります。</p></article><article class="feature-card"><h3>② 何が公開されている？</h3><p>アプリのコード／モデルの重み／学習コード・データ情報／ライセンス。重みをダウンロードできるだけで、すべてがオープンソースになるわけではありません。</p><a href="https://opensource.org/ai/open-source-ai-definition" target="_blank" rel="noopener noreferrer">OSIのOpen Source AI定義 ↗</a></article></div><CharacterBubble speaker="labo" mood="point">OllamaやLM Studioは「動かす道具」、QwenやGemmaは「選ぶモデルの系列」。道具と頭脳を同じ順位に並べず、組み合わせて選ぼう。必要メモリーや商用条件も、正式モデルごとの確認が必要だよ。</CharacterBubble></section>
  <section id="benchmarks" aria-labelledby="bench-title"><div class="section-heading"><p class="eyebrow">順位を読む前に</p><h2 id="bench-title">何の上手さを測った数字？</h2><p>異なる試験の点数を足して「万能1位」は作りません。未取得のスコアは推測せず、測定元の現在の結果へ案内します。</p></div><div class="table-wrap" tabindex="0" role="region" aria-label="ベンチマークの読み分け"><table><thead><tr><th>評価</th><th>対象</th><th>読み取れること</th><th>比べる前の条件</th></tr></thead><tbody>{benchmarks.map(b=><tr><th scope="row"><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name} ↗</a></th><td>{b.scope}</td><td>{b.meaning}</td><td>{b.caution}</td></tr>)}</tbody></table></div><p class="note">正式モデルID、測定日、試験の版、推論設定、ツール・試行数、費用、測定主体を記録してから数値を掲載します。音楽の好み、キャラクターの一貫性、日本語の文字、再生成の手間は、チャットの成績だけでは分かりません。</p></section>
  <section aria-labelledby="details-title"><div class="section-heading"><p class="eyebrow">条件と根拠をたどる</p><h2 id="details-title">各サービス・ツール・モデル群の確認メモ</h2></div><div class="detail-grid">{entries.map(e=><details id={`detail-${e.id}`}><summary><strong>{e.name}</strong><span>{categories[e.category]} · {e.kind}</span></summary><div class="detail-body"><p>{e.distinction}</p><dl><dt>向いている人</dt><dd>{e.purpose}</dd><dt>先に確認すること</dt><dd>{e.caution}</dd><dt>実行場所・公開条件</dt><dd>{places[e.deployment]}。{e.openness}</dd><dt>費用・利用条件</dt><dd>{e.cost}。{e.availability}</dd><dt>確認範囲</dt><dd>{e.checkedAt}に公式の機能概要を確認。定量性能・実機完走率・全プランの実利用を検証した記録ではありません。</dd></dl><div class="source-links">{e.sources.map(s=><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>)}</div><a class="back-link" href="#compare">比較表へ戻る ↑</a></div></details>)}</div></section>
  <section id="method" class="method-card" aria-labelledby="method-title"><p class="eyebrow">すまラボの比較方針</p><h2 id="method-title">広さだけでなく、確認できる比較へ。</h2><ul><li><strong>事実：</strong>公式の機能、プラン、地域、条件。根拠URLと確認日を付ける。</li><li><strong>外部評価：</strong>ベンチマークの測定者・版・設定を添える。異なる指標を合算しない。</li><li><strong>実測：</strong>同じ日本語課題で、成功率・所要時間・再生成回数・実費・人の修正を記録。未実施の結果は載せない。</li><li><strong>編集上の判断：</strong>どんな人に合い、どんな人は今のままでよいかを理由付きで示す。</li></ul><p>初版は26件の機能概要と比較の入口です。料金の数値、日本提供、個別モデルのライセンス・必要メモリーは確認が揃ったものから追加します。各行の「未確認」を「非対応」に置き換えません。</p><p id="freshness-note">料金・提供条件は変わります。確認から30日を超えた行は再確認の表示に切り替わります。</p><div class="related"><a href="/articles/ai-model-benchmark-cost-guide-2026/">従来のモデル・費用ガイド</a><a href="/articles/ai-youtube-video-creation-guide-2026/">動画制作の実用ガイド</a><a href="/articles/202611-ai-slopcodebench/">継続開発のベンチマークを読む</a></div></section>
 </div>
<script id="ai-comparison-data" type="application/json" set:html={JSON.stringify({entries:entries.map(e=>({...e,inference:inference(e)})),features,categories,places}).replace(/</g,'\\u003c')}></script>
</BaseLayout>
<script>
 const payload=document.getElementById('ai-comparison-data');
 if(payload){
 const data=JSON.parse(payload.textContent||'{}');
 const form=document.querySelector<HTMLFormElement>('#ai-filters')!;
 const search=document.querySelector<HTMLInputElement>('#ai-search')!;
 const category=document.querySelector<HTMLSelectElement>('#ai-category')!;
 const feature=document.querySelector<HTMLSelectElement>('#ai-feature')!;
 const place=document.querySelector<HTMLSelectElement>('#ai-place')!;
 const rows=Array.from(document.querySelectorAll<HTMLTableRowElement>('[data-entry]'));
 const selections=Array.from(document.querySelectorAll<HTMLInputElement>('[data-select]'));
 const views=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-view]'));
 const params=new URLSearchParams(location.search);let view=['summary','creation','work','access'].includes(params.get('view')||'')?params.get('view')!:'summary';
 const known=new Set(data.entries.map((e:any)=>e.id));const selected=new Set<string>((params.get('compare')||'').split(',').filter(id=>known.has(id)).slice(0,3));
 search.value=params.get('q')||'';category.value=params.get('category')||'';feature.value=params.get('feature')||'';place.value=params.get('place')||'';
 const el=(tag:string,text:string)=>{const element=document.createElement(tag);element.textContent=text;return element;};
 function shareState(){const p=new URLSearchParams();for(const [k,v]of Object.entries({q:search.value.trim(),category:category.value,feature:feature.value,place:place.value,view:view==='summary'?'':view,compare:[...selected].join(',')}))if(v)p.set(k,v);history.replaceState(null,'',location.pathname+(p.size?'?'+p:'')+location.hash);}
 function renderSelected(){
  const panel=document.querySelector<HTMLElement>('#selected-panel')!;panel.hidden=selected.size===0;const table=document.querySelector('#selected-table')!;table.replaceChildren();const list=data.entries.filter((e:any)=>selected.has(e.id));
  const head=document.createElement('thead'),headRow=document.createElement('tr');headRow.append(el('th','比較項目'));for(const e of list){const h=el('th',e.name);h.setAttribute('scope','col');headRow.append(h);}head.append(headRow);table.append(head);
  const body=document.createElement('tbody');const fields=[['こんな人に','purpose'],['特徴','distinction'],['実行場所','deployment'],['推論の場所','inference'],['公開条件','openness'],['費用の仕組み','cost'],['利用条件','availability'],['注意点','caution']];
  for(const [label,key]of fields){const tr=document.createElement('tr'),th=el('th',label);th.setAttribute('scope','row');tr.append(th);for(const e of list)tr.append(el('td',key==='deployment'?data.places[e[key]]:e[key]));body.append(tr);}
  for(const [key,label]of Object.entries(data.features)){const tr=document.createElement('tr');tr.append(el('th',String(label)));for(const e of list)tr.append(el('td',e.features[key]||'未確認'));body.append(tr);}
  const sources=document.createElement('tr');sources.append(el('th','公式出典・確認日'));for(const e of list){const td=document.createElement('td');for(const s of e.sources){const a=el('a',s.label+' ↗') as HTMLAnchorElement;a.href=s.url;a.target='_blank';a.rel='noopener noreferrer';td.append(a,document.createElement('br'));}td.append(el('small',e.checkedAt));sources.append(td);}body.append(sources);table.append(body);
  for(const input of selections){input.checked=selected.has(input.dataset.select!);input.disabled=selected.size>=3&&!input.checked;}
  document.querySelector('#selection-message')!.textContent=`${selected.size}件を選択中。最大3件。選んだ内容は絞り込みを変えても保持します。`;
 }
 function filter(){let count=0;const query=search.value.trim().toLocaleLowerCase('ja');for(const row of rows){const show=(!query||row.dataset.search!.includes(query))&&(!category.value||row.dataset.category===category.value)&&(!place.value||row.dataset.place===place.value)&&(!feature.value||row.dataset.features!.split(' ').includes(feature.value));row.hidden=!show;if(show)count++;}document.querySelector('#ai-count')!.textContent=`${data.entries.length}件中 ${count}件を表示`;document.querySelector<HTMLElement>('#ai-empty')!.hidden=count>0;shareState();}
 function setView(next:string){view=next;for(const cell of document.querySelectorAll<HTMLElement>('[data-group]'))cell.hidden=!cell.dataset.group!.split(' ').includes(view);for(const button of views)button.setAttribute('aria-pressed',String(button.dataset.view===view));shareState();}
 form.addEventListener('submit',event=>event.preventDefault());form.addEventListener('input',filter);form.addEventListener('change',filter);form.addEventListener('reset',()=>queueMicrotask(()=>{view='summary';setView(view);filter();}));
 for(const button of views)button.addEventListener('click',()=>setView(button.dataset.view!));
 for(const input of selections)input.addEventListener('change',()=>{const id=input.dataset.select!;if(input.checked&&selected.size<3)selected.add(id);else selected.delete(id);renderSelected();shareState();});
 for(const button of document.querySelectorAll<HTMLButtonElement>('[data-purpose]'))button.addEventListener('click',()=>{category.value='';place.value='';search.value='';feature.value=button.dataset.purpose!;setView(['image','video','music','voice'].includes(feature.value)?'creation':'work');filter();document.querySelector('#compare')!.scrollIntoView({behavior:'smooth'});});
 document.querySelector('#clear-selection')!.addEventListener('click',()=>{selected.clear();renderSelected();shareState();});
 document.querySelector('#copy-compare')!.addEventListener('click',async()=>{const status=document.querySelector('#copy-status')!;try{await navigator.clipboard.writeText(location.href);status.textContent='コピーしました';}catch{status.textContent='アドレス欄のURLをコピーしてください';}});
 document.addEventListener('click',event=>{const anchor=(event.target as Element).closest<HTMLAnchorElement>('a[href^="#detail-"]');if(anchor){const details=document.getElementById(anchor.hash.slice(1));if(details instanceof HTMLDetailsElement)details.open=true;}});
 for(const date of document.querySelectorAll<HTMLElement>('[data-confirmed]')){const age=(Date.now()-Date.parse(date.dataset.confirmed+'T00:00:00+09:00'))/86400000;if(age>30){date.textContent+=' · 再確認が必要';date.classList.add('stale');}}
