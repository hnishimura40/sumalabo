---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AiFeatured from '../../components/AiFeatured.astro';
import {featured} from '../../data/ai-featured';
import CharacterBubble from '../../components/article/CharacterBubble.astro';
import {guideSections,sectionGroups,sectionEntries,entrySearchTerms} from '../../data/ai-guide-sections';
import {entries,checkedAt} from '../../data/ai-comparison';
import '../../styles/ai-guide.css';
const examples=(s:typeof guideSections[number])=>s.slug==='models'?'Qwen / Gemma / PLaMo / Sarashina など':sectionEntries(s).filter(e=>!featured.some(p=>p.id===e.id)).map(e=>e.id==='notebook'?'Gemini Notebook':e.name).join(' / ')||'主要サービスを、用途に合う項目で詳しく比較';
---
<BaseLayout title="AI比較ガイド｜主要6サービスと用途別の選び方" description="Gemini・ChatGPT・Claude・Grok・Copilot・Museを大きく比較。ほかのAIも用途別に紹介。35件の料金・日本条件・国、モデル・ベンチマーク・実測を確認できます。" canonicalPath="/ai/">
 <div class="ai-guide ai-directory">
  <header class="directory-hero"><div><p class="ai-eyebrow">すまラボの常設AIガイド</p><h1>毎日のAI、どれにする？</h1><p class="directory-lead">まずは6つの選びどころを見比べる。もっと探したくなったら、やりたいことから。</p><p class="directory-meta">主要6サービス · 全35件 · 公式情報の確認：<time datetime={checkedAt}>{checkedAt}</time></p></div><img src="/images/characters/duo_guide_half.webp" alt="AI選びを案内するひまりとらぼまる" width="260" height="260" /></header>
  <nav class="directory-jumps" aria-label="AIガイドの入口"><a href="#major">主要6サービス</a><a href="#major-compare">6つの機能比較</a><a href="#major-models">モデル</a><a href="#major-benchmarks">ベンチマーク</a><a href="#more">用途別にもっと探す</a><a href="#evaluate">独自実測</a></nav>
  <AiFeatured />
  <section class="directory-more" id="more" aria-labelledby="more-heading"><p class="ai-eyebrow">ほかにも、こんなAIがあります</p><h2 id="more-heading">やりたいことから、もう一歩。</h2><p class="directory-lead">曲ならSuno、資料調査ならPerplexity。主要6サービスとあわせて、用途に合う候補を探せます。</p>
  <form class="directory-search" role="search"><label for="directory-query">AI名から分類を探す</label><input id="directory-query" type="search" placeholder="例：Gemini、Dots、Suno、ローカル" autocomplete="off" /><p id="directory-count" aria-live="polite">気になる用途から、ほかの候補も見てみましょう。</p></form>
  {sectionGroups.map(group=><section class="directory-group" id={group.id} data-directory-group aria-labelledby={`heading-${group.id}`}><div class="directory-group-heading"><h2 id={`heading-${group.id}`}>{group.title}</h2><p>{group.description}</p></div><div class="directory-grid">{guideSections.filter(s=>s.group===group.id).map(s=><a class="directory-card" href={`/ai/${s.slug}/`} data-directory-card data-search={[s.title,s.shortTitle,s.description,...sectionEntries(s).flatMap(entrySearchTerms)].join(' ').toLowerCase()}><div class="directory-card-title"><h3>{s.shortTitle}</h3><span aria-hidden="true">→</span></div><p>{s.description}</p><small>{examples(s)}</small><span class="directory-card-count">{s.slug==='models'?'具体的な10モデルへ':`${s.ids.length}件を同じ項目で比較`}</span></a>)}</div></section>)}
  <p id="directory-empty" hidden>該当する分類がありません。AI名や用途を変えるか、検索欄を空にしてください。</p>
  </section>
  <section class="directory-evaluation" id="evaluate" aria-labelledby="heading-evaluate"><div class="directory-group-heading"><h2 id="heading-evaluate">性能の数字を、確かめたい方へ。</h2><p>さらに詳しい性能評価や、すまラボの独自実測を読めます。</p></div><div class="evaluation-grid"><a class="directory-card" href="/ai/benchmarks/"><div class="directory-card-title"><h3>ベンチマークを読む</h3><span aria-hidden="true">→</span></div><p>同一指数の7モデルに加え、Arena・開発・PC操作など6系統の記録と根拠。</p><small>Artificial Analysis / Arena / SWE-bench など</small></a><a class="directory-card" href="/ai/tests/"><div class="directory-card-title"><h3>すまラボの独自実測</h3><span aria-hidden="true">→</span></div><p>同じ日本語6課題を4モデルで各3回。設定・回答・時間・使用量を公開。</p><small>小規模な文章課題の結果と限界を確認する</small></a></div></section>
  <div class="directory-bubble"><CharacterBubble speaker="himari" mood="curious">Geminiって、相談にも画像にも音楽にも出てくるの？</CharacterBubble><CharacterBubble speaker="labo" mood="point">そう。まず6つの中から普段の相棒を考えて、得意な道具を足すと選びやすいよ。曲ならSuno、調べものならPerplexityなども比べられる。今のAIで足りているなら、追加契約を急がなくても大丈夫。</CharacterBubble></div>
  <footer class="directory-method"><h2>このガイドの読み方</h2><p>掲載順は性能順位ではありません。用途の近い候補をまとめ、料金や日本での条件を一次資料で確認しています。国は開発組織の拠点で、データ保存先や安全性の順位ではありません。分類間で候補が重複するため、分類ごとの件数の合計は掲載35件と一致しません。</p><p>全サービスを実測したランキングではありません。料金・提供条件は変わるため、各ページの確認日と詳細の根拠を確認してください。今のAIで困っていなければ、追加契約を急ぐ必要はありません。</p><p class="directory-references">比較項目・導線の参考：<a href="https://ai.manapick.app/compare/" target="_blank" rel="noopener noreferrer">manapick AI</a>、<a href="https://www.aicompare.ninja/ja/" target="_blank" rel="noopener noreferrer">AI Compare Ninja</a>、<a href="https://artificialanalysis.ai/" target="_blank" rel="noopener noreferrer">Artificial Analysis</a>。見た目を再現したものではなく、このページの配置は独自に設計しています。製品の事実は各提供元の一次資料を参照しています。</p></footer>
 </div>
 <script type="application/json" id="ai-guide-directory-data" set:html={JSON.stringify({entries,featured:featured.map(p=>p.id),sections:guideSections.map(s=>({slug:s.slug,ids:s.ids}))}).replace(/</g,'\u003c')}></script>
</BaseLayout>
<script>
 const input=document.querySelector<HTMLInputElement>('#directory-query');
 input?.closest('form')?.addEventListener('submit',e=>e.preventDefault());
 input?.addEventListener('input',()=>{const q=input.value.trim().toLocaleLowerCase('ja');let count=0;for(const card of document.querySelectorAll<HTMLElement>('[data-directory-card]')){card.hidden=Boolean(q&&!card.dataset.search!.includes(q));if(!card.hidden)count++;}for(const group of document.querySelectorAll<HTMLElement>('[data-directory-group]'))group.hidden=![...group.querySelectorAll<HTMLElement>('[data-directory-card]')].some(c=>!c.hidden);document.querySelector('#directory-count')!.textContent=q?`${count}分類が見つかりました`:'気になる用途から、ほかの候補も見てみましょう。';document.querySelector<HTMLElement>('#directory-empty')!.hidden=count>0;});
</script>
<style>
 .directory-more{border-top:1px solid var(--line);margin-top:48px;padding-top:36px;scroll-margin-top:100px}.directory-more>h2{margin-bottom:8px}
 .directory-hero{display:grid;grid-template-columns:1fr 140px;align-items:center;gap:28px;padding:0 0 18px}.directory-hero h1{font-size:clamp(29px,3.5vw,42px);line-height:1.35}.directory-hero img{width:140px;height:140px;object-fit:contain;border-radius:18px}.directory-lead{font-size:15px;color:var(--fg-mid)}.directory-meta{font-size:11px;color:var(--fg-mid);line-height:1.8}.directory-jumps{display:flex;gap:10px;flex-wrap:wrap;border-block:1px solid var(--line);padding:16px 0}.directory-jumps a{font-size:13px;text-decoration:none;padding:5px 12px;background:var(--bg-elev);border:1px solid var(--line);border-radius:6px}.directory-search{display:grid;grid-template-columns:200px minmax(0,1fr);gap:8px 20px;margin:28px 0}.directory-search label{align-self:center;font-size:14px;font-weight:700}.directory-search input{width:100%;min-width:0;padding:11px 14px;border:1px solid var(--line-strong);border-radius:7px;background:var(--bg-elev);box-sizing:border-box}.directory-search p{grid-column:2;font-size:12px;color:var(--fg-mid);margin:0}.directory-group{margin-top:40px;scroll-margin-top:100px}.directory-group-heading{margin-bottom:18px}.directory-group-heading p{font-size:14px;color:var(--fg-mid);margin:0}.directory-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.directory-card{display:flex;flex-direction:column;padding:22px;background:var(--bg-elev);border:1px solid var(--line);border-radius:12px;color:var(--fg)!important;text-decoration:none;min-width:0}.directory-card:hover{border-color:var(--teal);background:var(--teal-tint)}.directory-card-title{display:flex;gap:12px;justify-content:space-between;align-items:center}.directory-card h3{font-size:19px;line-height:1.5;margin:0}.directory-card-title>span{color:var(--teal);font-size:22px}.directory-card p{font-size:14px;color:var(--fg-mid);margin:12px 0}.directory-card small{font-size:11px;color:var(--fg-mid);line-height:1.8;overflow-wrap:anywhere}.directory-card-count{font-size:11px;color:var(--teal);margin-top:auto;padding-top:15px;font-weight:700}.directory-evaluation{margin-top:48px;padding-top:32px;border-top:1px solid var(--line);scroll-margin-top:100px}.evaluation-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.directory-bubble{margin-top:40px}.directory-method{border-top:1px solid var(--line);margin-top:38px;padding-top:26px}.directory-method h2{font-size:21px}.directory-method p{font-size:13px;color:var(--fg-mid)}.directory-references{font-size:11px!important}.directory-card[hidden],.directory-group[hidden],#directory-empty[hidden]{display:none}
 @media(max-width:850px){.directory-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.directory-hero{grid-template-columns:1fr 120px}.directory-hero img{width:120px;height:120px}}
 @media(max-width:580px){.directory-hero{grid-template-columns:1fr;padding-top:4px;gap:0}.directory-hero img{display:none}.directory-lead{font-size:15px}.directory-jumps{gap:6px}.directory-jumps a{font-size:11px;padding:6px 9px}.directory-search{grid-template-columns:1fr;gap:9px}.directory-search p{grid-column:1}.directory-grid,.evaluation-grid{grid-template-columns:1fr}.directory-card{padding:18px}.directory-card h3{font-size:18px}.directory-group{margin-top:32px}}
</style>
