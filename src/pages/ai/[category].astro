---
import AiGuideLayout from '../../layouts/AiGuideLayout.astro';
import CharacterBubble from '../../components/article/CharacterBubble.astro';
import AiServiceLogo from '../../components/AiServiceLogo.astro';
import logoSources from '../../data/ai-logo-sources.json';
import AiEvidence from '../../components/AiEvidence.astro';
import {guideSections,sectionEntries,axisText,priceEntrances,japanLabels,entrySearchTerms} from '../../data/ai-guide-sections';
export function getStaticPaths(){return guideSections.map(section=>({params:{category:section.slug},props:{section}}));}
const {section}=Astro.props;
const list=sectionEntries(section);
const countries=[...new Set(list.map(e=>e.country.split('（')[0]))];
const statusCount=new Set(list.map(e=>e.japanStatus)).size;
const isModels=section.slug==='models';
const places={cloud:'クラウド',local:'端末内',hybrid:'端末内／クラウド・構成別'};
const comparisonData={entries:list.map(e=>({...e,logo:logoSources.find(l=>l.id===e.id)?.path,priceEntrance:priceEntrances[e.id],axes:section.axes.map(a=>axisText(e,a,section.slug))})),axes:section.axes.map(a=>a.label),places,japanLabels};
---
<AiGuideLayout title={section.title} description={section.description} path={`/ai/${section.slug}/`} current={section.shortTitle}>
 <details class="ai-callout ai-reading-note"><summary>{section.question} <span>比較の見方</span></summary><p>{section.note}</p></details>
 {isModels?<AiEvidence mode="models" />:<>
 <form id="ai-filters" class="ai-filters" role="search"><label class="search-field">この分類で検索<input id="ai-search" type="search" placeholder="サービス名・特徴" autocomplete="off" /></label><label hidden={countries.length<2}>開発元の国・地域<select id="ai-country" aria-label="開発元の国・地域"><option value="">すべて</option>{countries.map(c=><option value={c}>{c}</option>)}</select></label><label hidden={statusCount<2}>日本で使う条件<select id="ai-japan" aria-label="日本で使う条件"><option value="">すべて</option>{Object.entries(japanLabels).filter(([key])=>list.some(e=>e.japanStatus===key)).map(([key,label])=><option value={key}>{label}</option>)}</select></label><button type="reset">条件を戻す</button></form>
 <div class="ai-table-toolbar"><p id="ai-count" aria-live="polite">{list.length}件を比較</p><a id="view-selected" href="#selected-panel" hidden>選んだAIを比較する</a></div>
 <p class="ai-small-note" id="table-help">この分類に関係する項目だけを比較します。最大3件を選んで並べられます。掲載順は性能順位ではありません。表は横にスクロールできます。</p>
 <div class="ai-table-wrap" tabindex="0" role="region" aria-label={`${section.shortTitle}の比較表`} aria-describedby="table-help"><table class="ai-compare-table" id="ai-matrix"><caption>{section.shortTitle}：機能と料金の入口</caption><thead><tr><th class="select-col" scope="col">選ぶ</th><th class="name-col" scope="col">サービス・ツール</th>{section.axes.map(a=><th scope="col">{a.label}</th>)}<th scope="col">料金の入口</th><th scope="col">日本で使う条件</th></tr></thead><tbody>{list.map(e=><tr data-entry={e.id} data-country={e.country.split('（')[0]} data-japan={e.japanStatus} data-search={[...entrySearchTerms(e),e.country,e.distinction,e.purpose,...Object.values(e.features)].join(' ').toLowerCase()}><td class="select-col"><input type="checkbox" data-select={e.id} aria-label={`${e.name}を比較に追加`} /></td><th scope="row" class="name-col"><a href={`#detail-${e.id}`}><AiServiceLogo id={e.id} size={26} /> {e.name}</a><span class="entry-meta">{e.provider} · {e.country.split('（')[0]}</span><span class="entry-meta">{e.kind} · 確認 {e.checkedAt}</span></th>{section.axes.map(a=><td class="axis-cell">{axisText(e,a,section.slug)}</td>)}<td class="price-cell">{priceEntrances[e.id]}<br /><a class="detail-link" href={`#detail-${e.id}`}>全プラン・税・追加料金 ↓</a></td><td><strong class="ai-japan-tag">{japanLabels[e.japanStatus]}</strong><br /><a class="detail-link" href={`#detail-${e.id}`}>提供条件・根拠 ↓</a></td></tr>)}</tbody></table></div>
 <p id="ai-empty" hidden>条件に合う候補がありません。「条件を戻す」でこの分類の全件に戻せます。</p>
 <p class="ai-small-note">料金は個人向け等の代表的な入口です。「$」は米ドル、€はユーロです。USD/EURの円換算はしていません。月払い・年払い・税・使用枠・商用条件・API別課金は下の詳細で確認してください。無料枠の制限や機材費も別です。</p>
 <section class="ai-selection" id="selected-panel" hidden aria-labelledby="selection-title"><div class="ai-selection-heading"><h2 id="selection-title">選んだAIの違い</h2><button type="button" id="clear-selection">選択を解除</button></div><p id="selection-message" aria-live="polite"></p><div class="ai-table-wrap" tabindex="0" role="region" aria-label="選んだAIの詳細比較"><table class="ai-compare-table" id="selected-table"></table></div><button type="button" id="copy-compare">この比較のURLをコピー</button><span role="status" id="copy-status"></span></section>
 <noscript><p>比較表と詳細はそのまま読めます。絞り込み・選択比較にはJavaScriptが必要です。</p></noscript>
 <section class="ai-details" aria-labelledby="detail-title"><h2 id="detail-title">料金・提供条件と根拠</h2><p class="ai-details-intro">読みたいサービスだけ開けます。表の短い表示で省いた料金の条件や、公式資料はこちらにまとめています。</p>{list.map(e=><details class="ai-detail" id={`detail-${e.id}`}><summary><AiServiceLogo id={e.id} size={24} /> {e.name}の料金・日本対応・注意点</summary><div class="ai-detail-body"><dl><dt>選ぶ理由</dt><dd>{e.distinction}</dd><dt>全プラン・費用</dt><dd>{e.cost}</dd><dt>日本で使う条件</dt><dd>{e.availability}</dd><dt>開発元の国・地域</dt><dd>{e.country}。{e.countryNote}</dd><dt>実行・公開条件</dt><dd>{places[e.deployment]}。{e.openness}</dd><dt>注意点</dt><dd>{e.caution}</dd><dt>確認日</dt><dd data-confirmed={e.checkedAt}>{e.checkedAt}。公式説明の確認であり、全プランを実機で検証した記録ではありません。</dd></dl><div class="ai-source-links">{[...new Map(e.sources.map(s=>[s.url,s])).values()].map(s=><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>)}</div><div class="ai-related">{guideSections.filter(s=>s.slug!==section.slug&&s.ids.includes(e.id)).map(s=><a href={`/ai/${s.slug}/`}>{s.shortTitle}でも比較する →</a>)}</div></div></details>)}</section>
 <script type="application/json" id="ai-comparison-data" set:html={JSON.stringify(comparisonData).replace(/</g,'\u003c')}></script>
 </>}
 {['local','models'].includes(section.slug)&&<section class="ai-callout"><h2>「どこで動く」と「何が公開される」は別。</h2><p>アプリがPC内で動いても、推論や外部APIはクラウドの場合があります。コードの公開、モデルの重みの公開、商用・再配布条件を分けて確認しましょう。重みを取得できるだけで、全てがオープンソースとは限りません。</p><p><a href="https://opensource.org/ai/open-source-ai-definition" target="_blank" rel="noopener noreferrer">OSIのOpen Source AI定義 ↗</a></p></section>}
 {section.slug==='companions'&&<CharacterBubble speaker="labo" mood="point">DotsやMuseを選ぶ前に「日本で使う条件」を見よう。Duetは日本が対象として案内されていないし、OpenClawは自分で運用する道具。料金だけで同じ条件とは考えないでね。</CharacterBubble>}
 {section.slug==='images'&&<CharacterBubble speaker="himari" mood="curious">画像の見た目だけじゃなく、文字やキャラクターを何回直すかでも選びたいね。</CharacterBubble>}
</AiGuideLayout>
<script>
 const payload=document.querySelector('#ai-comparison-data');
 if(payload){
 const data=JSON.parse(payload.textContent||'{}');
 const form=document.querySelector<HTMLFormElement>('#ai-filters')!;
 const search=document.querySelector<HTMLInputElement>('#ai-search')!;
 const country=document.querySelector<HTMLSelectElement>('#ai-country')!;
 const japan=document.querySelector<HTMLSelectElement>('#ai-japan')!;
 const rows=[...document.querySelectorAll<HTMLTableRowElement>('[data-entry]')];
 const inputs=[...document.querySelectorAll<HTMLInputElement>('[data-select]')];
 const params=new URLSearchParams(location.search);const known=new Set(data.entries.map((e:any)=>e.id));
 const selected=new Set<string>((params.get('compare')||'').split(',').filter(id=>known.has(id)).slice(0,3));
 search.value=params.get('q')||'';country.value=params.get('country')||'';japan.value=params.get('japan')||'';
 const el=(tag:string,text:string)=>{const n=document.createElement(tag);n.textContent=text;return n;};
 function share(){const p=new URLSearchParams();for(const [k,v]of Object.entries({q:search.value.trim(),country:country.value,japan:japan.value,compare:[...selected].join(',')}))if(v)p.set(k,v);history.replaceState(null,'',location.pathname+(p.size?'?'+p:'')+location.hash);}
 function render(){
  const panel=document.querySelector<HTMLElement>('#selected-panel')!,link=document.querySelector<HTMLAnchorElement>('#view-selected')!;panel.hidden=selected.size===0;link.hidden=selected.size===0;link.textContent=`選んだ${selected.size}件を比較する`;
  const list=[...selected].map(id=>data.entries.find((e:any)=>e.id===id));const table=document.querySelector('#selected-table')!;table.replaceChildren();
  const thead=document.createElement('thead'),head=document.createElement('tr');const first=el('th','比較項目');first.setAttribute('scope','col');head.append(first);for(const e of list){const th=el('th',e.name);th.setAttribute('scope','col');if(e.logo){const img=document.createElement('img');img.src=e.logo;img.alt='';img.width=24;img.height=24;img.className='ai-selected-logo';img.dataset.aiLogo=e.id;th.prepend(img,document.createTextNode(' '));}head.append(th);}thead.append(head);table.append(thead);
  const body=document.createElement('tbody');
  const fields=[...data.axes.map((label:string,i:number)=>({label,value:(e:any)=>e.axes[i]})),{label:'料金の入口',value:(e:any)=>e.priceEntrance},{label:'全プラン・費用条件',value:(e:any)=>e.cost},{label:'日本で使う条件',value:(e:any)=>e.availability},{label:'開発国・運用',value:(e:any)=>`${e.country}。${data.places[e.deployment]}`},{label:'注意点',value:(e:any)=>e.caution}];
  for(const field of fields){const tr=document.createElement('tr'),th=el('th',field.label);th.setAttribute('scope','row');tr.append(th);for(const e of list)tr.append(el('td',field.value(e)));body.append(tr);}
  const sourceRow=document.createElement('tr');sourceRow.append(el('th','詳細・一次資料'));for(const e of list){const td=document.createElement('td'),a=el('a',`${e.name}の根拠・確認日`) as HTMLAnchorElement;a.href=`#detail-${e.id}`;td.append(a);sourceRow.append(td);}body.append(sourceRow);table.append(body);
  for(const input of inputs){input.checked=selected.has(input.dataset.select!);input.disabled=selected.size>=3&&!input.checked;}
  document.querySelector('#selection-message')!.textContent=`${selected.size}件を選択中（最大3件）。選んだ順に並べています。`;
 }
 function filter(){let count=0;const q=search.value.trim().toLocaleLowerCase('ja');for(const row of rows){row.hidden=Boolean((q&&!row.dataset.search!.includes(q))||(country.value&&row.dataset.country!==country.value)||(japan.value&&row.dataset.japan!==japan.value));if(!row.hidden)count++;}document.querySelector('#ai-count')!.textContent=`この分類 ${data.entries.length}件中 ${count}件`;document.querySelector<HTMLElement>('#ai-empty')!.hidden=count>0;share();}
 form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('input',filter);form.addEventListener('change',filter);form.addEventListener('reset',e=>{e.preventDefault();search.value='';country.value='';japan.value='';filter();});
 for(const input of inputs)input.addEventListener('change',()=>{const id=input.dataset.select!;if(input.checked&&selected.size<3)selected.add(id);else selected.delete(id);render();share();});
 document.querySelector('#clear-selection')!.addEventListener('click',()=>{selected.clear();render();share();});
 document.querySelector('#copy-compare')!.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(location.href);document.querySelector('#copy-status')!.textContent='コピーしました';}catch{document.querySelector('#copy-status')!.textContent='アドレス欄のURLをコピーしてください';}});
 document.addEventListener('click',e=>{const a=(e.target as Element).closest<HTMLAnchorElement>('a[href^="#detail-"]');if(a){const detail=document.getElementById(a.hash.slice(1));if(detail instanceof HTMLDetailsElement)detail.open=true;}});
 for(const date of document.querySelectorAll<HTMLElement>('[data-confirmed]'))if((Date.now()-Date.parse(date.dataset.confirmed+'T00:00:00+09:00'))/86400000>30)date.append(' · 再確認が必要');
 const initial=document.getElementById(location.hash.slice(1));if(initial instanceof HTMLDetailsElement)initial.open=true;
 render();filter();
 }
</script>
