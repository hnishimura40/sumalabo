---
import "../styles/global.css";
import { siteConfig } from "../config/site";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import DrainageTracking from "../components/DrainageTracking.astro";
import ForceRefresh from "../components/ForceRefresh.astro";
import { BUILD_ID } from "../lib/build-id";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: "website" | "article";
  canonicalPath?: string;
  /** true で robots に noindex を付ける（社内確認ページ用） */
  noindex?: boolean;
  paper?: boolean;
}

const {
  title = siteConfig.siteName,
  description = siteConfig.siteDescription,
  image = "",
  ogType = "website",
  canonicalPath,
  noindex = false,
  paper = false,
} = Astro.props;
const robotsContent = noindex ? "noindex, nofollow" : "max-image-preview:large";
const pageTitle = title === siteConfig.siteName ? title : `${title} | ${siteConfig.siteName}`;
const canonicalPathname = canonicalPath ?? Astro.url.pathname;
const hasSiteUrl = siteConfig.siteUrl.length > 0;
// TODO: 本番公開URL確定後は src/config/site.ts の siteUrl を設定し、canonical/OGP URLを絶対URLで出力する。
const canonicalUrl = hasSiteUrl ? new URL(canonicalPathname, siteConfig.siteUrl).toString() : canonicalPathname;
const selectedImage = image || siteConfig.defaultOgpImage;
const ogImage = selectedImage && hasSiteUrl ? new URL(selectedImage, siteConfig.siteUrl).toString() : selectedImage;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.authorName} />
    <meta name="theme-color" content="#0f1720" />
    <meta name="robots" content={robotsContent} />
    {
      siteConfig.googleSiteVerification && (
        <meta name="google-site-verification" content={siteConfig.googleSiteVerification} />
      )
    }
    <script is:inline>
      // テーマ初期化（ペイント前に実行。localStorage → OS設定の順）
      (function () {
        try {
          var saved = localStorage.getItem("sumalabo-theme");
          var dark = saved ? saved === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (dark) document.documentElement.classList.add("dark");
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      // 見出し用Webフォント(Zen Maru Gothic/Inter)は自ホスト(/fonts/)+load後注入。
      // Google Fonts のクロスオリジン読込は Lighthouse シミュレーションが
      // クリティカル扱いして FCP/LCP を大きく悪化させた（本番実測 92→65-77）。
      // font-display: optional なので初回訪問はシステムフォント表示（シフトなし）、
      // 2回目以降はキャッシュから Zen Maru が即適用される。
      // load後さらに2秒遅らせ、LCP計測ウィンドウ・初回描画と完全に切り離す
      // （optionalのため初回表示には元々使われない。取得はキャッシュ充填目的）
      window.addEventListener("load", function () {
        setTimeout(function () {
          var l = document.createElement("link");
          l.rel = "stylesheet";
          l.href = "/fonts/fonts.css";
          document.head.appendChild(l);
        }, 2000);
      });
    </script>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.siteName} href="/rss.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    {/* このページが焼かれたビルドID。/version.json と比較して新デプロイを検知する */}
    <meta name="sumalabo-build" content={BUILD_ID} />
    <GoogleAnalytics />
    <DrainageTracking />
    <title>{pageTitle}</title>
  </head>
  <body class:list={[{"renewal-paper":paper}]}>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="すまラボ トップへ">
          <span class="brand-mark" aria-hidden="true">
            <img src="/images/brand/sumalab-symbol.svg" alt="" />
          </span>
          <span>
            <strong>すまラボ</strong>
            <small>スマホ・AI・ガジェットをやさしく整理</small>
          </span>
        </a>
        <nav class:list={["site-nav", {"site-nav--scroll": siteConfig.scrollNavigation}]} aria-label="メインナビゲーション">
          <a href="/">ホーム</a>
          <a href="/categories/news/">ニュース</a>
          <a href="/categories/hands-on/">やってみた・検証</a>
          <a href="/articles/">記事一覧</a>
          <a href="/categories/smartphone/">スマホ選び</a>
          <a href="/categories/gadgets/">周辺機器</a>
        </nav>
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="ライト/ダーク切り替え">
          <span class="theme-toggle-icon" aria-hidden="true"></span>
        </button>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <a class="brand" href="/" aria-label="すまラボ トップへ">
            <span class="brand-mark" aria-hidden="true">
              <img src="/images/brand/sumalab-symbol.svg" alt="" />
            </span>
            <span>
              <strong>すまラボ</strong>
              <small>スマホ・AI・ガジェットの整理メディア</small>
            </span>
          </a>
          <p>むずかしい話を、選びやすさと損しにくさにつながる形で整理します。</p>
        </div>
        <nav class="footer-links" aria-label="フッターナビゲーション">
          <a href="/articles/">記事一覧</a>
          <a href="/categories/news/">ニュースをかみくだく</a>
          <a href="/categories/hands-on/">やってみた・検証</a>
          <a href="/categories/smartphone/">スマホの選び方</a>
          <a href="/categories/mobile-plan/">通信費を下げる</a>
          <a href="/categories/gadgets/">周辺機器・ガジェット</a>
          <a href="/characters/">らぼまる・ひまりについて</a>
          <a href="/about/">すまラボについて</a>
          <a href="/ai-policy/">AI利用ポリシー</a>
          <a href="/disclaimer/">免責事項</a>
          <a href="/privacy-policy/">プライバシーポリシー</a>
          <a href="/contact/">お問い合わせ</a>
          <a href="/disclosure/">広告・アフィリエイトについて</a>
        </nav>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        btn.addEventListener("click", function () {
          var dark = document.documentElement.classList.toggle("dark");
          try {
            localStorage.setItem("sumalabo-theme", dark ? "dark" : "light");
          } catch (e) {}
        });
      })();
    </script>
    <ForceRefresh />
  </body>
</html>

<style is:global>
.site-nav.site-nav--scroll{display:flex;flex-wrap:nowrap;overflow-x:auto;min-width:0;max-width:100%;padding-right:36px;mask-image:linear-gradient(to right,#000 88%,transparent);-webkit-mask-image:linear-gradient(to right,#000 88%,transparent);scrollbar-width:thin;overscroll-behavior-inline:contain}.site-nav.site-nav--scroll a{flex:0 0 auto;white-space:nowrap}.header-inner:has(.site-nav--scroll){min-width:0}.header-inner:has(.site-nav--scroll)>*{min-width:0}@media(max-width:720px){.header-inner:has(.site-nav--scroll){grid-template-columns:minmax(0,1fr) auto}.site-nav.site-nav--scroll{width:100%;grid-column:1/-1;order:3}}
</style>

<style is:global>
body.renewal-paper{color-scheme:light;--bg:#fff;--bg-elev:#fff;--bg-sunk:#f4f2ea;--bg-tint:#f4f2ea;--fg:#15171c;--fg-mid:#3a4150;--fg-soft:#5b6472;--fg-faint:#8a919c;--line:#e3e0d6;--line-soft:#e3e0d6;--teal:#1e9c8b;--teal-deep:#146b65;--img-filter:none;--font-heading:"Noto Sans JP",system-ui,sans-serif;background:#fff;color:#15171c}
.renewal-paper .site-header{background:#fff;border-bottom:3px solid #15171c;backdrop-filter:none}.renewal-paper .header-inner{display:grid;grid-template-columns:minmax(0,1fr) auto;max-width:1120px;width:calc(100% - 40px);gap:8px;padding:14px 0}.renewal-paper .brand small{display:none}.renewal-paper .brand strong{font-size:20px;font-weight:900}.renewal-paper .site-nav{grid-row:2;grid-column:1/-1;width:100%;margin:0;max-width:100%}.renewal-paper .site-nav a{color:#15171c;font-weight:700;padding:8px 12px}.renewal-paper .theme-toggle{grid-row:1;grid-column:2}.renewal-paper .site-footer{background:#fff;color:#15171c}.renewal-paper img{filter:none!important}.renewal-paper .theme-toggle-icon{background:#f4c430}
@media(max-width:720px){.renewal-paper .header-inner{width:calc(100% - 32px);padding:12px 0}.renewal-paper .site-nav a{padding:7px 10px;font-size:13px}}
</style>
