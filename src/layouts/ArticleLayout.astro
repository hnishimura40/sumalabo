---
import BaseLayout from "./BaseLayout.astro";
import ArticleNavigation from "../components/ArticleNavigation.astro";
import PreviewApprovalButton from "../components/PreviewApprovalButton.astro";

import { siteConfig } from "../config/site";

type ArticleData = {
  title: string;
  slug: string;
  description: string;
  type: "foundation" | "revenue" | "news";
  category: string;
  thumbnail?: string;
  thumbnailAlt?: string;
  updated: string;
  pubDate?: string;
};

interface Props {
  article: ArticleData;
  previousArticle?: ArticleData;
  nextArticle?: ArticleData;
}

const { article, previousArticle, nextArticle } = Astro.props;

const typeLabels = {
  foundation: "土台記事",
  revenue: "収益記事",
  news: "流入記事",
};

// JSON-LD Article schema（M3 SEO基盤）。datePublished は pubDate、無ければ updated。
const articleUrl = new URL(`/articles/${article.slug}/`, siteConfig.siteUrl).toString();
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.title,
  description: article.description,
  datePublished: article.pubDate || article.updated,
  dateModified: article.updated,
  ...(article.thumbnail
    ? { image: [new URL(article.thumbnail, siteConfig.siteUrl).toString()] }
    : {}),
  author: { "@type": "Organization", name: siteConfig.authorName, url: siteConfig.siteUrl },
  publisher: {
    "@type": "Organization",
    name: siteConfig.siteName,
    url: siteConfig.siteUrl,
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": articleUrl },
  inLanguage: "ja",
};
---

<BaseLayout
  title={article.title}
  description={article.description}
  image={article.thumbnail}
  ogType="article"
  canonicalPath={`/articles/${article.slug}/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <article class={`article-shell article-shell--${article.type}`}>
    <header class="article-header">
      <div class="meta-row">
        <span>{typeLabels[article.type]}</span>
        <span>{article.category}</span>
        <time datetime={article.updated}>更新日: {article.updated}</time>
      </div>
      <h1>{article.title}</h1>
      <p>{article.description}</p>
      {
        article.thumbnail ? (
          <img
            class="article-thumbnail"
            src={article.thumbnail}
            alt={article.thumbnailAlt || ""}
            loading="eager"
          />
        ) : (
          <div class="thumbnail-placeholder" aria-label="サムネイル未設定">
            <span>Thumbnail pending</span>
            <strong>サムネイルはChatGPT側で作成後に設定</strong>
          </div>
        )
      }
    </header>

    <div class="article-content">
      <slot />
    </div>

    <p class="article-ai-note">
      本サイトの記事・図解はAIの支援を受けて制作し、公開前に人間が確認しています。詳しくは<a href="/ai-policy/">本サイトのAI利用について</a>をご覧ください。
    </p>

    <PreviewApprovalButton slug={article.slug} />

    <ArticleNavigation previousArticle={previousArticle} nextArticle={nextArticle} />
  </article>

  <!-- 画像ライトボックス（記事本文のスライド画像のみ対象。JSで動的に配線） -->
  <div class="lightbox" id="article-lightbox" role="dialog" aria-modal="true" aria-label="画像の拡大表示" hidden>
    <button class="lightbox-close" type="button" aria-label="閉じる">✕</button>
    <button class="lightbox-nav lightbox-prev" type="button" aria-label="前のスライド">‹</button>
    <img id="article-lightbox-img" alt="" decoding="async" />
    <button class="lightbox-nav lightbox-next" type="button" aria-label="次のスライド">›</button>
    <div class="lightbox-cap" id="article-lightbox-cap"></div>
    <div class="lightbox-hint">タップでズーム / 背景タップか ✕ で閉じる</div>
  </div>
</BaseLayout>

<script>
  // 画像ライトボックス: 記事本文内のスライド画像(.article-slide-figure img)をタップで拡大。
  // 依存ライブラリなし。オーバーレイはページ内の同じWebP srcを再利用（追加リクエストなし）。
  (() => {
    const lb = document.getElementById("article-lightbox");
    const lbImg = document.getElementById("article-lightbox-img") as HTMLImageElement | null;
    const lbCap = document.getElementById("article-lightbox-cap");
    if (!lb || !lbImg || !lbCap) return;
    const slides = Array.from(
      document.querySelectorAll<HTMLImageElement>(".article-content .article-slide-figure img"),
    );
    if (slides.length === 0) return;

    const closeBtn = lb.querySelector<HTMLButtonElement>(".lightbox-close");
    const prevBtn = lb.querySelector<HTMLButtonElement>(".lightbox-prev");
    const nextBtn = lb.querySelector<HTMLButtonElement>(".lightbox-next");
    let cur = 0;
    let lastFocus: HTMLElement | null = null;

    const captionFor = (img: HTMLImageElement) => {
      const fig = img.closest("figure");
      const cap = fig ? fig.querySelector("figcaption") : null;
      return (cap && cap.textContent) || img.alt || "";
    };

    const show = (i: number) => {
      cur = (i + slides.length) % slides.length;
      const img = slides[cur];
      lbImg.src = img.currentSrc || img.src;
      lbImg.alt = img.alt || "";
      lbImg.classList.remove("zoomed");
      lbCap.textContent = captionFor(img);
      const solo = slides.length < 2;
      if (prevBtn) prevBtn.hidden = solo;
      if (nextBtn) nextBtn.hidden = solo;
    };

    const open = (i: number) => {
      lastFocus = document.activeElement as HTMLElement | null;
      show(i);
      lb.hidden = false;
      lb.classList.add("open");
      document.body.style.overflow = "hidden";
      closeBtn && closeBtn.focus();
    };

    const close = () => {
      lb.classList.remove("open");
      lb.hidden = true;
      document.body.style.overflow = "";
      lastFocus && lastFocus.focus();
    };

    slides.forEach((img, i) => {
      img.classList.add("lightbox-target");
      img.setAttribute("role", "button");
      img.setAttribute("tabindex", "0");
      img.addEventListener("click", () => open(i));
      img.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          open(i);
        }
      });
    });

    lb.addEventListener("click", (e) => {
      if (e.target === lb) close();
    });
    closeBtn && closeBtn.addEventListener("click", close);
    prevBtn && prevBtn.addEventListener("click", () => show(cur - 1));
    nextBtn && nextBtn.addEventListener("click", () => show(cur + 1));
    lbImg.addEventListener("click", () => lbImg.classList.toggle("zoomed"));

    document.addEventListener("keydown", (e) => {
      if (lb.hidden) return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowLeft") show(cur - 1);
      if (e.key === "ArrowRight") show(cur + 1);
    });

    // スワイプで前後移動
    let touchX: number | null = null;
    lb.addEventListener(
      "touchstart",
      (e) => {
        touchX = e.touches[0].clientX;
      },
      { passive: true },
    );
    lb.addEventListener(
      "touchend",
      (e) => {
        if (touchX === null) return;
        const dx = e.changedTouches[0].clientX - touchX;
        if (Math.abs(dx) > 60) show(dx < 0 ? cur + 1 : cur - 1);
        touchX = null;
      },
      { passive: true },
    );
  })();
</script>

<style>
  .article-header {
    margin-bottom: 30px;
    padding: clamp(22px, 5vw, 36px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, var(--teal-tint), transparent 58%),
      var(--bg-elev);
    box-shadow: var(--shadow-sm);
  }

  .article-shell--revenue {
    width: min(960px, calc(100% - 32px));
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
    color: var(--fg-soft);
    font-size: 12px;
  }

  .meta-row span,
  .meta-row time {
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-elev) 78%, var(--teal-tint));
    padding: 4px 10px;
    color: var(--fg-mid);
    font-weight: 700;
    line-height: 1.35;
  }

  .meta-row time {
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  h1 {
    margin: 0;
    color: var(--fg);
    font-size: clamp(30px, 6vw, 48px);
    line-height: 1.22;
    letter-spacing: 0;
  }

  .article-header p {
    max-width: 720px;
    margin: 18px 0 0;
    color: var(--fg-soft);
    font-size: 17px;
    line-height: 1.85;
  }

  .article-thumbnail,
  .thumbnail-placeholder {
    width: 100%;
    margin-top: 26px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    object-fit: cover;
    box-shadow: var(--shadow-md);
  }

  .thumbnail-placeholder {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 6px;
    background:
      linear-gradient(135deg, var(--bg-tint), var(--bg-sunk)),
      var(--bg-tint);
    color: var(--fg-soft);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .thumbnail-placeholder::before {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line-soft) 1px, transparent 1px),
      linear-gradient(90deg, var(--line-soft) 1px, transparent 1px);
    background-size: 32px 32px;
    content: "";
    opacity: 0.65;
  }

  .thumbnail-placeholder > * {
    position: relative;
  }

  .thumbnail-placeholder span {
    color: var(--teal);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .thumbnail-placeholder strong {
    font-size: 15px;
  }

  .article-content {
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(24px, 5vw, 46px);
    box-shadow: var(--shadow-md);
    color: var(--fg);
    font-size: 17px;
    line-height: 1.9;
  }

  .article-content :global(h2) {
    margin: 62px 0 22px;
    padding-top: 16px;
    border-top: 1px solid var(--line-soft);
    color: var(--fg);
    font-size: clamp(22px, 4vw, 30px);
    line-height: 1.35;
    letter-spacing: 0;
  }

  .article-content :global(.scan-heading) {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .article-content :global(.scan-heading span) {
    flex: 0 0 auto;
    border: 1px solid color-mix(in srgb, var(--teal) 42%, var(--line));
    border-radius: 999px;
    background: var(--teal-tint);
    padding: 4px 10px;
    color: var(--teal-deep);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.2;
  }

  .article-content :global(h2:first-child) {
    margin-top: 0;
  }

  .article-content :global(p) {
    margin: 0 0 18px;
  }

  .article-shell--revenue .article-content :global(p),
  .article-shell--revenue .article-content :global(ul),
  .article-shell--revenue .article-content :global(ol) {
    max-width: 800px;
  }

  .article-content :global(h3) {
    margin: 0 0 10px;
    color: var(--fg);
    font-size: 18px;
    line-height: 1.45;
    letter-spacing: 0;
  }

  .article-content :global(strong) {
    color: var(--fg);
    font-weight: 800;
  }

  .article-content :global(a) {
    color: var(--teal-deep);
    font-weight: 700;
  }

  .article-content :global(ul) {
    margin: 0 0 20px;
    padding-left: 1.4em;
  }

  .article-content :global(ol) {
    margin: 0 0 20px;
    padding-left: 1.45em;
  }

  .article-content :global(li + li) {
    margin-top: 8px;
  }

  /* =========================================================================
   * Table defaults — PC では横スクロールなしを原則とし、セル内文章は折り返す。
   * 横スクロールが本当に必要な大型表だけ .is-scrollable で opt-in する。
   * revenue 系は元の block + scroll 挙動を別途維持。
   * ========================================================================= */
  .article-content :global(table) {
    display: table;
    width: 100%;
    max-width: 100%;
    margin: 28px 0 32px;
    border-collapse: collapse;
    table-layout: auto;
    white-space: normal;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
    box-shadow: var(--shadow-sm);
  }

  .article-shell--revenue .article-content :global(table) {
    display: block;
    overflow-x: auto;
    white-space: normal;
  }

  .article-content :global(th),
  .article-content :global(td) {
    border: 1px solid var(--line);
    padding: 14px 16px;
    text-align: left;
    vertical-align: top;
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  /* opt-in: .is-scrollable を付けた表だけ PC でも横スクロール許可。
   * 6 列以上の詳細比較表 / 数値・スペック密度が高い表 / 折り返すと著しく
   * 読みにくくなる表のみで使うこと。 */
  .article-content :global(.is-scrollable) {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
  }

  .article-content :global(.is-scrollable > table),
  .article-content :global(.is-scrollable table) {
    display: block;
    width: max-content;
    max-width: none;
    white-space: nowrap;
  }

  .article-shell--revenue .article-content :global(th),
  .article-shell--revenue .article-content :global(td) {
    min-width: 132px;
    padding: 15px 17px;
    line-height: 1.65;
  }

  .article-shell--revenue .article-content :global(th:first-child),
  .article-shell--revenue .article-content :global(td:first-child) {
    min-width: 92px;
  }

  .article-shell--revenue .article-content :global(th:nth-child(2)),
  .article-shell--revenue .article-content :global(td:nth-child(2)) {
    min-width: 190px;
  }

  .article-content :global(th) {
    background: color-mix(in srgb, var(--teal-tint) 82%, var(--bg-elev));
    color: var(--teal-deep);
    font-weight: 800;
  }

  .article-content :global(td) {
    background: color-mix(in srgb, var(--bg-elev) 92%, var(--bg-tint));
    color: var(--fg-mid);
  }

  .article-content :global(.summary-box),
  .article-content :global(.quick-pick-box),
  .article-content :global(.check-box) {
    margin: 28px 0 32px;
    padding: 20px;
    border: 1px solid var(--line);
    border-left: 5px solid var(--teal);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, var(--teal-tint), transparent 70%),
      var(--bg-elev);
    box-shadow: var(--shadow-sm);
  }

  .article-content :global(.quick-pick-box) {
    border-left-color: var(--mint);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--teal-tint) 72%, var(--bg-elev)), transparent 74%),
      var(--bg-elev);
  }

  .article-content :global(.quick-pick-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-content :global(.quick-pick-box .quick-pick-grid) {
    padding-left: 0;
  }

  .article-content :global(.quick-pick-grid li) {
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--bg-elev) 86%, var(--teal-tint));
    padding: 12px 14px;
    color: var(--fg-mid);
    font-size: 15px;
    line-height: 1.55;
  }

  .article-content :global(.quick-pick-grid strong) {
    display: block;
    margin-bottom: 2px;
  }

  .article-content :global(.check-box) {
    border-color: color-mix(in srgb, var(--amber) 36%, var(--line));
    border-left-color: var(--amber);
    background:
      linear-gradient(135deg, var(--amber-tint), transparent 70%),
      var(--bg-elev);
  }

  .article-content :global(.check-box .box-label) {
    color: color-mix(in srgb, var(--amber) 70%, var(--fg));
  }

  .article-content :global(.box-label) {
    margin: 0 0 10px;
    color: var(--teal-deep);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: 0.06em;
  }

  .article-content :global(.summary-box ul),
  .article-content :global(.quick-pick-box ul),
  .article-content :global(.check-box ul) {
    margin: 0;
    padding-left: 1.25em;
  }

  .article-content :global(.point-grid) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin: 26px 0 30px;
  }

  .article-content :global(.point-grid section) {
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
    box-shadow: var(--shadow-sm);
  }

  .article-content :global(.point-grid p) {
    margin-bottom: 0;
    color: var(--fg-soft);
    font-size: 15px;
  }

  .article-content :global(.decision-guide-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin: 34px 0 38px;
  }

  .article-content :global(.decision-guide-panel) {
    padding: 20px;
    border: 1px solid color-mix(in srgb, var(--teal) 18%, var(--line));
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--teal-tint) 52%, transparent), transparent 72%),
      color-mix(in srgb, var(--bg-elev) 96%, var(--bg-tint));
    box-shadow: var(--shadow-sm);
  }

  .article-content :global(.decision-guide-panel h2),
  .article-content :global(.decision-guide-panel h3) {
    margin: 8px 0 10px;
    padding-top: 0;
    border-top: 0;
    font-size: clamp(20px, 3vw, 24px);
  }

  .article-content :global(.decision-guide-panel p) {
    margin-bottom: 14px;
    color: var(--fg-soft);
    font-size: 15px;
    line-height: 1.75;
  }

  .article-content :global(.guide-chip) {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    border: 1px solid color-mix(in srgb, var(--teal) 32%, var(--line));
    border-radius: 999px;
    background: color-mix(in srgb, var(--teal-tint) 72%, var(--bg-elev));
    padding: 4px 9px;
    color: var(--teal-deep);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.35;
  }

  .article-content :global(.decision-list) {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-content :global(.decision-list li) {
    display: grid;
    gap: 3px;
    border-top: 1px solid var(--line-soft);
    padding-top: 10px;
    color: var(--fg-soft);
    font-size: 14px;
    line-height: 1.6;
  }

  .article-content :global(.decision-list strong) {
    color: var(--fg);
    font-size: 14px;
  }

  .article-content :global(.product-card-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: 28px 0 34px;
  }

  .article-shell--revenue .article-content :global(.product-card-grid) {
    gap: 18px;
  }

  .article-shell--revenue .article-content :global(.summary-box),
  .article-shell--revenue .article-content :global(.quick-pick-box),
  .article-shell--revenue .article-content :global(.check-box),
  .article-shell--revenue .article-content :global(.article-cta) {
    max-width: none;
  }

  .article-content :global(.product-card) {
    display: grid;
    gap: 14px;
    padding: 18px;
    border: 1px solid color-mix(in srgb, var(--teal) 18%, var(--line));
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--teal-tint) 44%, transparent), transparent 62%),
      var(--bg-elev);
    box-shadow: var(--shadow-sm);
  }

  .article-content :global(.product-card h3) {
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
  }

  .article-content :global(.product-rank) {
    width: fit-content;
    margin: 0;
    border: 1px solid color-mix(in srgb, var(--teal) 32%, var(--line));
    border-radius: 999px;
    background: color-mix(in srgb, var(--teal-tint) 72%, var(--bg-elev));
    padding: 4px 9px;
    color: var(--teal-deep);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.35;
  }

  .article-content :global(.product-card dl) {
    display: grid;
    gap: 10px;
    margin: 0;
  }

  .article-content :global(.product-card dl div) {
    display: grid;
    gap: 3px;
    border-top: 1px solid var(--line-soft);
    padding-top: 10px;
  }

  .article-content :global(.product-card dt) {
    color: var(--fg);
    font-size: 13px;
    font-weight: 800;
  }

  .article-content :global(.product-card dd) {
    margin: 0;
    color: var(--fg-soft);
    font-size: 14px;
    line-height: 1.65;
  }

  .article-content :global(.buy-link-box) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    border-top: 1px solid var(--line-soft);
    padding-top: 12px;
  }

  .article-content :global(.buy-link-box span),
  .article-content :global(.buy-link-box a) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    border: 1px dashed color-mix(in srgb, var(--teal) 42%, var(--line));
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-elev) 86%, var(--teal-tint));
    padding: 7px 12px;
    color: var(--teal-deep);
    font-size: 13px;
    font-weight: 800;
    line-height: 1.35;
    text-decoration: none;
  }

  .article-content :global(.check-list) {
    padding-left: 0;
    list-style: none;
  }

  .article-content :global(.check-list li) {
    position: relative;
    padding-left: 30px;
  }

  .article-content :global(.check-list li::before) {
    position: absolute;
    top: 0.35em;
    left: 0;
    display: inline-grid;
    place-items: center;
    width: 17px;
    height: 17px;
    border: 2px solid var(--teal-deep);
    border-radius: var(--radius-xs);
    background: var(--bg-elev);
    content: "";
  }

  .article-content :global(.article-cta) {
    display: grid;
    gap: 12px;
    margin: 34px 0 38px;
    padding: 20px;
    border: 1px solid color-mix(in srgb, var(--teal) 32%, var(--line));
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, var(--teal-tint), transparent 64%),
      color-mix(in srgb, var(--bg-elev) 94%, var(--bg-tint));
    box-shadow: var(--shadow-sm);
  }

  .article-content :global(.article-cta p) {
    margin: 0;
    color: var(--fg-soft);
    font-size: 15px;
  }

  .article-content :global(.article-cta a) {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 8px;
    border: 1px solid color-mix(in srgb, var(--teal) 42%, var(--line));
    border-radius: 999px;
    background: var(--teal);
    padding: 9px 14px;
    color: white;
    font-size: 14px;
    font-weight: 800;
    line-height: 1.35;
    text-decoration: none;
  }

  .article-content :global(.article-cta a::after) {
    content: "→";
  }

  @media (max-width: 720px) {
    .article-header {
      padding: 20px;
    }

    .article-content :global(.point-grid) {
      grid-template-columns: 1fr;
    }

    .article-content :global(.product-card-grid) {
      grid-template-columns: 1fr;
    }

    .article-content :global(.decision-guide-grid) {
      grid-template-columns: 1fr;
    }

    .article-content {
      padding: 22px 18px;
      font-size: 16.5px;
      line-height: 1.9;
    }

    .article-content :global(h2) {
      margin-top: 50px;
    }

    .article-content :global(.scan-heading) {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .article-content :global(.quick-pick-grid) {
      grid-template-columns: 1fr;
    }

    .article-content :global(table) {
      font-size: 14px;
    }

    .article-shell--revenue {
      width: min(100% - 24px, 1200px);
    }

    /* mobile: revenue の table は元の挙動（scroll + 折り返し）。news 系は
     * デフォルトで折り返し継続（.is-scrollable opt-in のみ scroll 許可）。 */
    .article-shell--revenue .article-content :global(table) {
      display: block;
      overflow-x: auto;
      white-space: normal;
    }
  }

  /* =========================================================================
   * Visual-first article components (Apple AIペンダント 用に拡張)
   *
   * PC では本文幅より広いキャンバスを使って判断ブロックを大きく見せ、
   * スマホでは 1 列カードに自動で崩す。
   * 通常本文 (p / ul / ol) は読みやすい行長 760px に抑える。
   * ========================================================================= */

  /* news 記事の shell を拡張: 通常 852px → wide 1080px */
  .article-shell--news {
    width: min(1080px, calc(100% - 32px));
  }

  /* news 記事の本文段落・リストは 940px (1 行 50〜55 文字) を上限に。
   * 旧設定の 760px だと画像 (shell 全幅 ~988px) との右端の差が大きく、
   * 「画像だけ広く本文だけ細い」印象になっていたため広げた。 */
  .article-shell--news .article-content :global(p),
  .article-shell--news .article-content :global(ul),
  .article-shell--news .article-content :global(ol) {
    max-width: 940px;
    margin-left: 0;
    margin-right: 0;
  }

  /* lead / 先に結論の一行サマリ用。本文 940px より少しだけタイト、
   * かつフォントサイズを上げて視線を止める。 */
  .article-content :global(.lead) {
    margin: 0 0 16px;
    max-width: 940px;
    color: var(--fg);
    font-size: 19px;
    font-weight: 700;
    line-height: 1.75;
  }

  .article-shell--news .article-content :global(.lead) {
    max-width: 940px;
  }

  @media (max-width: 720px) {
    .article-content :global(.lead) {
      font-size: 17px;
    }
  }

  /* wide block 系 (visual-dashboard / pros-cons / verdict / flow / wide-comparison / checkpoint /
   * article-wide-block / table-card / decision-guide-* / summary-box / info-box / check-box) は
   * 行長制約から外し、shell 全幅を使う */
  .article-shell--news .article-content :global(.article-wide-block),
  .article-shell--news .article-content :global(.article-slide-figure),
  .article-shell--news .article-content :global(.article-slide-section),
  .article-shell--news .article-content :global(.slide-reading-note),
  .article-shell--news .article-content :global(.slide-transcript),
  .article-shell--news .article-content :global(.visual-dashboard),
  .article-shell--news .article-content :global(.pros-cons-grid),
  .article-shell--news .article-content :global(.wide-comparison),
  .article-shell--news .article-content :global(.verdict-cards),
  .article-shell--news .article-content :global(.visual-flow),
  .article-shell--news .article-content :global(.checkpoint-list),
  .article-shell--news .article-content :global(.table-card),
  .article-shell--news .article-content :global(.decision-guide-grid),
  .article-shell--news .article-content :global(.decision-guide-panel),
  .article-shell--news .article-content :global(.summary-box),
  .article-shell--news .article-content :global(.info-box),
  .article-shell--news .article-content :global(.check-box),
  .article-shell--news .article-content :global(table) {
    max-width: none;
    width: 100%;
  }

  /* --- visual-dashboard: 冒頭の4セル メトリクス --- */
  .article-content :global(.visual-dashboard) {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin: 28px 0 36px;
  }

  .article-content :global(.visual-dashboard .metric) {
    padding: 18px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
    box-shadow: var(--shadow-sm);
  }

  .article-content :global(.visual-dashboard .metric--high) {
    border-left: 4px solid var(--teal);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--teal-tint) 60%, transparent), transparent 70%),
      var(--bg-elev);
  }

  .article-content :global(.visual-dashboard .metric--mid) {
    border-left: 4px solid var(--amber);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--amber-tint) 60%, transparent), transparent 70%),
      var(--bg-elev);
  }

  .article-content :global(.visual-dashboard .metric--low) {
    border-left: 4px solid color-mix(in srgb, var(--fg-soft) 40%, var(--line));
  }

  .article-content :global(.visual-dashboard .metric--warn) {
    border-left: 4px solid #d97706;
    background:
      linear-gradient(135deg, color-mix(in srgb, #d97706 8%, var(--bg-elev)), transparent 70%),
      var(--bg-elev);
  }

  .article-content :global(.visual-dashboard .metric-label) {
    display: block;
    margin: 0 0 6px;
    color: var(--teal-deep);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .article-content :global(.visual-dashboard .metric--warn .metric-label) {
    color: #b45309;
  }

  .article-content :global(.visual-dashboard .metric-value) {
    display: block;
    margin: 0 0 6px;
    color: var(--fg);
    font-size: 20px;
    font-weight: 900;
    line-height: 1.2;
  }

  .article-content :global(.visual-dashboard .metric-note) {
    display: block;
    color: var(--fg-soft);
    font-size: 12px;
    line-height: 1.55;
  }

  /* --- pros-cons-grid: 便利 / 気になる 左右カード --- */
  .article-content :global(.pros-cons-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin: 28px 0 34px;
  }

  .article-content :global(.pros-cons-grid .pros),
  .article-content :global(.pros-cons-grid .cons) {
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
    box-shadow: var(--shadow-sm);
  }

  .article-content :global(.pros-cons-grid .pros) {
    border-left: 5px solid var(--teal);
    background:
      linear-gradient(135deg, var(--teal-tint), transparent 70%),
      var(--bg-elev);
  }

  .article-content :global(.pros-cons-grid .cons) {
    border-left: 5px solid #d97706;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--amber-tint) 80%, var(--bg-elev)), transparent 70%),
      var(--bg-elev);
  }

  .article-content :global(.pros-cons-grid h4) {
    margin: 0 0 12px;
    color: var(--fg);
    font-size: 17px;
    font-weight: 800;
    line-height: 1.4;
  }

  .article-content :global(.pros-cons-grid .pros h4) {
    color: var(--teal-deep);
  }

  .article-content :global(.pros-cons-grid .cons h4) {
    color: #b45309;
  }

  .article-content :global(.pros-cons-grid ul) {
    margin: 0;
    padding-left: 1.2em;
    max-width: none;
  }

  .article-content :global(.pros-cons-grid li) {
    font-size: 15px;
    line-height: 1.65;
  }

  /* --- visual-flow: 3-step 横方向 (PC) / 縦方向 (mobile) --- */
  .article-content :global(.visual-flow) {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: stretch;
    gap: 0;
    margin: 28px 0 34px;
  }

  .article-content :global(.visual-flow .flow-step) {
    padding: 20px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
    box-shadow: var(--shadow-sm);
    text-align: center;
  }

  .article-content :global(.visual-flow .flow-step--input) { border-top: 4px solid var(--teal); }
  .article-content :global(.visual-flow .flow-step--relay) { border-top: 4px solid var(--amber); }
  .article-content :global(.visual-flow .flow-step--brain) { border-top: 4px solid #7c3aed; }

  .article-content :global(.visual-flow .flow-arrow) {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 10px;
    color: var(--teal);
    font-size: 24px;
    font-weight: 900;
  }

  .article-content :global(.visual-flow .flow-label) {
    display: block;
    margin: 0 0 6px;
    color: var(--teal-deep);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .article-content :global(.visual-flow .flow-title) {
    display: block;
    margin: 0 0 8px;
    color: var(--fg);
    font-size: 17px;
    font-weight: 800;
    line-height: 1.35;
  }

  .article-content :global(.visual-flow .flow-text) {
    display: block;
    color: var(--fg-soft);
    font-size: 13px;
    line-height: 1.6;
  }

  /* --- verdict-cards: 噂 vs 確定 2-col --- */
  .article-content :global(.verdict-cards) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: 28px 0 34px;
  }

  .article-content :global(.verdict-cards .verdict) {
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
    box-shadow: var(--shadow-sm);
  }

  .article-content :global(.verdict-cards .verdict--rumor) {
    border-left: 5px solid #6b7280;
    background:
      linear-gradient(135deg, color-mix(in srgb, #6b7280 10%, var(--bg-elev)), transparent 70%),
      var(--bg-elev);
  }

  .article-content :global(.verdict-cards .verdict--confirmed) {
    border-left: 5px solid var(--teal);
    background:
      linear-gradient(135deg, var(--teal-tint), transparent 70%),
      var(--bg-elev);
  }

  .article-content :global(.verdict-cards .verdict-label) {
    display: block;
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .article-content :global(.verdict-cards .verdict--rumor .verdict-label) {
    color: #4b5563;
  }

  .article-content :global(.verdict-cards .verdict--confirmed .verdict-label) {
    color: var(--teal-deep);
  }

  .article-content :global(.verdict-cards ul) {
    margin: 0;
    padding-left: 1.2em;
    max-width: none;
  }

  .article-content :global(.verdict-cards li) {
    font-size: 14px;
    line-height: 1.6;
  }

  .article-content :global(.verdict-cards li + li) {
    margin-top: 6px;
  }

  /* --- wide-comparison: 比較表用ラッパー
   * PC は折り返して shell 全幅に収める（横スクロールなし）。
   * モバイルでは画面幅が足りない場合のみ overflow-x: auto を許可。
   * .is-scrollable を併用すると PC でも横スクロール可能。 */
  .article-content :global(.wide-comparison) {
    margin: 28px 0 34px;
    width: 100%;
  }

  .article-content :global(.wide-comparison table) {
    margin: 0;
    display: table;
    width: 100%;
    table-layout: fixed;
    white-space: normal;
  }

  .article-content :global(.wide-comparison th),
  .article-content :global(.wide-comparison td) {
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  /* --- article-slide-section: 図解スライドの導入文・画像・読み取りポイントを
   * 同じ幅に揃える wide-block ラッパー --- */
  .article-content :global(.article-slide-section) {
    margin: 36px 0 38px;
  }

  .article-content :global(.article-slide-section .slide-intro) {
    margin: 0 0 14px;
    max-width: none;
    color: var(--fg-mid);
    font-size: 15.5px;
    line-height: 1.8;
  }

  /* article-slide-section 内では figure と reading-note を視覚的につなぐ
   * (上は角丸、下は角丸を切って下のカードに繋ぐ) */
  .article-content :global(.article-slide-section .article-slide-figure) {
    margin: 0;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }

  .article-content :global(.article-slide-section .article-slide-figure img) {
    border-bottom: 1px solid var(--line-soft);
  }

  .article-content :global(.article-slide-section .article-slide-figure figcaption) {
    border-bottom: 1px solid var(--line);
  }

  .article-content :global(.article-slide-section .slide-reading-note) {
    margin: 0;
    border-top: 0;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }

  /* --- slide-reading-note: 読み取りポイント (wide block / カード型) --- */
  .article-content :global(.slide-reading-note) {
    margin: 14px 0 36px;
    padding: 18px 22px 20px;
    border: 1px solid var(--line);
    border-top: 4px solid var(--teal);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--teal-tint) 32%, transparent), transparent 75%),
      var(--bg-elev);
    box-shadow: var(--shadow-sm);
  }

  .article-content :global(.slide-reading-note p:first-child) {
    margin: 0 0 10px;
    color: var(--teal-deep);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.06em;
    max-width: none;
  }

  .article-content :global(.slide-reading-note p:first-child strong) {
    color: var(--teal-deep);
    font-weight: 800;
  }

  .article-content :global(.slide-reading-note ul) {
    margin: 0;
    padding-left: 1.2em;
    max-width: none;
  }

  .article-content :global(.slide-reading-note li) {
    color: var(--fg-mid);
    font-size: 15px;
    line-height: 1.75;
  }

  .article-content :global(.slide-reading-note li + li) {
    margin-top: 8px;
  }

  .article-content :global(.slide-reading-note strong) {
    color: var(--fg);
    font-weight: 800;
  }

  /* --- slide-transcript: 図解スライドの完全テキスト (折りたたみ optional) --- */
  .article-content :global(.slide-transcript) {
    margin: 12px 0 36px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
    box-shadow: var(--shadow-sm);
  }

  .article-content :global(.slide-transcript summary) {
    margin: 0;
    padding: 14px 18px;
    color: var(--teal-deep);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: 0.04em;
    list-style: none;
  }

  .article-content :global(.slide-transcript summary::-webkit-details-marker) {
    display: none;
  }

  .article-content :global(.slide-transcript summary::before) {
    content: "▶";
    display: inline-block;
    margin-right: 8px;
    color: var(--teal);
    font-size: 11px;
    transition: transform 0.15s;
  }

  .article-content :global(.slide-transcript[open] summary::before) {
    transform: rotate(90deg);
  }

  .article-content :global(.slide-transcript > div),
  .article-content :global(.slide-transcript > ul) {
    padding: 0 22px 18px;
    margin: 0;
    color: var(--fg-mid);
    font-size: 14.5px;
    line-height: 1.75;
    max-width: none;
  }

  .article-content :global(.slide-transcript ul) {
    padding-left: 1.3em;
  }

  @media (max-width: 720px) {
    .article-content :global(.slide-reading-note) {
      padding: 16px 16px 18px;
    }
    .article-content :global(.article-slide-section .slide-intro) {
      font-size: 15px;
    }
  }

  /* --- article-slide-figure: 図解スライド画像用 (wide block) --- */
  .article-content :global(.article-slide-figure) {
    margin: 32px 0 36px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--teal-tint) 28%, transparent), transparent 70%),
      var(--bg-elev);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .article-content :global(.article-slide-figure img) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .article-content :global(.article-slide-figure figcaption) {
    margin: 0;
    padding: 12px 18px;
    color: var(--fg-soft);
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.55;
    background: var(--bg-elev);
  }

  /* --- checkpoint-list: チェック項目を3列カード化 --- */
  .article-content :global(.checkpoint-list) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin: 28px 0 34px;
    padding: 0;
    list-style: none;
    max-width: none;
  }

  .article-content :global(.checkpoint-list li) {
    position: relative;
    padding: 16px 16px 16px 46px;
    border: 1px solid var(--line);
    border-left: 4px solid var(--teal);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
    box-shadow: var(--shadow-sm);
    font-size: 14px;
    line-height: 1.65;
    margin-top: 0;
  }

  .article-content :global(.checkpoint-list li::before) {
    position: absolute;
    left: 12px;
    top: 14px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--teal-tint);
    color: var(--teal-deep);
    content: "✓";
    font-weight: 900;
    text-align: center;
    line-height: 24px;
    font-size: 13px;
  }

  .article-content :global(.checkpoint-list strong) {
    display: block;
    margin-bottom: 4px;
    color: var(--fg);
    font-weight: 800;
  }

  /* mobile: 全 wide-block を 1 列に縦積み */
  @media (max-width: 720px) {
    .article-content :global(.visual-dashboard) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .article-content :global(.pros-cons-grid) {
      grid-template-columns: 1fr;
    }

    .article-content :global(.visual-flow) {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .article-content :global(.visual-flow .flow-arrow) {
      transform: rotate(90deg);
      padding: 4px 0;
      font-size: 20px;
    }

    .article-content :global(.verdict-cards) {
      grid-template-columns: 1fr;
    }

    .article-content :global(.checkpoint-list) {
      grid-template-columns: 1fr;
    }

    /* mobile: wide-comparison は折り返しを基本にしつつ、列数が多くて
     * どうしても収まらないときは ラッパーに overflow-x: auto を許可。
     * 通常の wide-comparison（4 列まで）は折り返しで OK。 */
    .article-content :global(.wide-comparison) {
      overflow-x: auto;
    }

    .article-content :global(.wide-comparison table) {
      table-layout: auto;
      min-width: 0;
    }

    .article-shell--news {
      width: min(1080px, calc(100% - 24px));
    }

    .article-shell--news .article-content :global(p),
    .article-shell--news .article-content :global(ul),
    .article-shell--news .article-content :global(ol) {
      max-width: 100%;
    }
  }

  .article-ai-note {
    margin: 28px 0 0;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg-elev);
    color: var(--fg-soft);
    font-size: 13px;
    line-height: 1.6;
  }

  .article-ai-note a {
    color: var(--teal-deep);
  }

